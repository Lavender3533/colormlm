#version 450

// Token embedding lookup: y[i] = table[token_id * hidden + i]
// Trivial copy, but used to convert token_id → hidden state at prefill input.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly  buffer TABLE { float table[]; };
layout(set = 0, binding = 1) writeonly buffer Y     { float y[]; };

layout(push_constant) uniform Push {
    uint token_id;
    uint hidden;
} push;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.hidden) return;
    y[i] = table[push.token_id * push.hidden + i];
}
