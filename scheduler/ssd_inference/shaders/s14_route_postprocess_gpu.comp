#version 450

// 单 token、256 experts 的确定性原生 route 后处理。单 invocation 是刻意选择：
// 该阶段只有 256 个标量，顺序扫描可避免并行 top-k 的 tie/归约漂移。
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer LogitsBuffer {
    float logits[];
};

// mode=0: F32 bias[256] 的位模式；mode=1: U32 physical expert_ids[6]。
layout(set = 0, binding = 1, std430) readonly buffer AuxBuffer {
    uint aux[];
};

layout(set = 0, binding = 2, std430) writeonly buffer ExpertIdBuffer {
    uint expert_ids[];
};

layout(set = 0, binding = 3, std430) writeonly buffer WeightBuffer {
    float weights[];
};

layout(set = 0, binding = 4, std430) writeonly buffer SelectedScoreBuffer {
    float selected_scores[];
};

layout(set = 0, binding = 5, std430) writeonly buffer RankingScoreBuffer {
    float ranking_scores[];
};

layout(set = 0, binding = 6, std430) buffer StatusBuffer {
    uint status_code;
};

layout(push_constant) uniform Push {
    uint mode;
} pc;

const uint EXPERTS = 256u;
const uint TOP_K = 6u;
const float ROUTE_SCALE = 1.5;
const float SOFTPLUS_THRESHOLD = 20.0;

const uint STATUS_NON_FINITE_LOGIT_OR_SCORE = 1u;
const uint STATUS_NON_FINITE_BIAS = 2u;
const uint STATUS_INVALID_PHYSICAL_ID = 4u;
const uint STATUS_INVALID_NORMALIZATION = 8u;
const uint STATUS_INVALID_MODE = 16u;

bool finite_f32(float value) {
    return !isnan(value) && !isinf(value);
}

void zero_outputs() {
    for (uint slot = 0u; slot < TOP_K; ++slot) {
        expert_ids[slot] = 0u;
        weights[slot] = 0.0;
        selected_scores[slot] = 0.0;
        ranking_scores[slot] = 0.0;
    }
}

void fail_closed(uint bit) {
    atomicOr(status_code, bit);
    zero_outputs();
}

void main() {
    zero_outputs();
    if (status_code != 0u) {
        return;
    }
    if (pc.mode > 1u) {
        fail_closed(STATUS_INVALID_MODE);
        return;
    }

    float scores[256];
    bool used[256];
    for (uint expert = 0u; expert < EXPERTS; ++expert) {
        float logit = logits[expert];
        if (!finite_f32(logit)) {
            fail_closed(STATUS_NON_FINITE_LOGIT_OR_SCORE);
            return;
        }
        float softplus = logit > SOFTPLUS_THRESHOLD ? logit : log(1.0 + exp(logit));
        float score = sqrt(softplus);
        if (!finite_f32(score)) {
            fail_closed(STATUS_NON_FINITE_LOGIT_OR_SCORE);
            return;
        }
        scores[expert] = score;
        used[expert] = false;
    }

    uint ids[6];
    float selected[6];
    float ranking[6];
    if (pc.mode == 0u) {
        for (uint slot = 0u; slot < TOP_K; ++slot) {
            uint best_id = 0u;
            float best = -3.402823466e+38;
            bool found = false;
            for (uint expert = 0u; expert < EXPERTS; ++expert) {
                float bias = uintBitsToFloat(aux[expert]);
                if (!finite_f32(bias)) {
                    fail_closed(STATUS_NON_FINITE_BIAS);
                    return;
                }
                float candidate = scores[expert] + bias;
                if (!finite_f32(candidate)) {
                    fail_closed(STATUS_NON_FINITE_BIAS);
                    return;
                }
                if (!used[expert]
                    && (!found || candidate > best || (candidate == best && expert < best_id))) {
                    found = true;
                    best = candidate;
                    best_id = expert;
                }
            }
            if (!found) {
                fail_closed(STATUS_INVALID_NORMALIZATION);
                return;
            }
            used[best_id] = true;
            ids[slot] = best_id;
            selected[slot] = scores[best_id];
            ranking[slot] = best;
        }
    } else {
        for (uint slot = 0u; slot < TOP_K; ++slot) {
            uint id = aux[slot];
            if (id >= EXPERTS || used[id]) {
                fail_closed(STATUS_INVALID_PHYSICAL_ID);
                return;
            }
            used[id] = true;
            ids[slot] = id;
            selected[slot] = scores[id];
            ranking[slot] = scores[id];
        }
    }

    float sum = 0.0;
    for (uint slot = 0u; slot < TOP_K; ++slot) {
        sum += selected[slot];
    }
    if (!finite_f32(sum) || sum <= 0.0) {
        fail_closed(STATUS_INVALID_NORMALIZATION);
        return;
    }
    for (uint slot = 0u; slot < TOP_K; ++slot) {
        float weight = selected[slot] / sum * ROUTE_SCALE;
        if (!finite_f32(weight)) {
            fail_closed(STATUS_INVALID_NORMALIZATION);
            return;
        }
        expert_ids[slot] = ids[slot];
        weights[slot] = weight;
        selected_scores[slot] = selected[slot];
        ranking_scores[slot] = ranking[slot];
    }
}
