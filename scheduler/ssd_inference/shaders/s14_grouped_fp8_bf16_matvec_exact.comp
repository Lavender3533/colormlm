#version 450

// Audit-only grouped wo_a projection. Eight active lanes reproduce the
// frozen OpenBLAS 0.3.30 Haswell K=4096 reduction at the final BF16 boundary.

layout(local_size_x = 128) in;

layout(set = 0, binding = 0) readonly buffer X { float x[]; };
layout(set = 0, binding = 1) readonly buffer Weight { uint weight_words[]; };
layout(set = 0, binding = 2) readonly buffer WeightScale { uint scale_words[]; };
layout(set = 0, binding = 3) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint groups;
    uint n_per_group;
    uint K;
} push;

shared float partial[128];

uint weight_byte(uint byte_index) {
    uint word = weight_words[byte_index >> 2u];
    return (word >> ((byte_index & 3u) * 8u)) & 0xffu;
}

uint scale_byte(uint byte_index) {
    uint word = scale_words[byte_index >> 2u];
    return (word >> ((byte_index & 3u) * 8u)) & 0xffu;
}

float e4m3fn(uint code) {
    uint exponent = (code >> 3u) & 0x0fu;
    uint mantissa = code & 7u;
    float magnitude;
    if (exponent == 0u) {
        magnitude = float(mantissa) * 0.001953125;
    } else if (exponent == 15u && mantissa == 7u) {
        return uintBitsToFloat(0x7fc00000u);
    } else {
        magnitude = ldexp(1.0 + float(mantissa) * 0.125, int(exponent) - 7);
    }
    return (code & 0x80u) == 0u ? magnitude : -magnitude;
}

float ue8m0(uint code) {
    return ldexp(1.0, int(code) - 127);
}

float bf16_rne(float value) {
    uint bits = floatBitsToUint(value);
    uint rounded = bits + 0x7fffu + ((bits >> 16u) & 1u);
    return uintBitsToFloat(rounded & 0xffff0000u);
}

void main() {
    uint output_row = gl_WorkGroupID.x;
    uint flat_n = push.groups * push.n_per_group;
    uint tid = gl_LocalInvocationID.x;
    if (output_row >= flat_n) return;

    uint group = output_row / push.n_per_group;
    uint input_base = group * push.K;
    uint weight_base = output_row * push.K;
    uint k_tiles = (push.K + 127u) >> 7u;
    uint scale_base = (output_row >> 7u) * k_tiles;
    const uint active_lanes = 8u;
    float acc = 0.0;
    if (tid < active_lanes) {
        for (uint k = tid; k < push.K; k += active_lanes) {
            uint weight_code = weight_byte(weight_base + k);
            uint scale_code = scale_byte(scale_base + (k >> 7u));
            float weight_value = bf16_rne(e4m3fn(weight_code) * ue8m0(scale_code));
            acc = fma(weight_value, x[input_base + k], acc);
        }
        partial[tid] = acc;
    }
    barrier();
    if (tid == 0u) {
        const uint lane_order[8] = uint[8](0u, 1u, 3u, 4u, 6u, 2u, 5u, 7u);
        precise float total = partial[lane_order[0]];
        for (uint index = 1u; index < active_lanes; ++index) {
            total += partial[lane_order[index]];
        }
        y[output_row] = total;
    }
}
