#version 450

// One real routed expert contribution. A multi-expert graph may accumulate
// these contributions into its MoE buffer after each expert completes.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Expert { float expert[]; };
layout(set = 0, binding = 1) writeonly buffer Routed { float routed[]; };

layout(push_constant) uniform Push {
    uint n;
    float route_weight;
} push;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.n) return;
    routed[i] = push.route_weight * expert[i];
}
