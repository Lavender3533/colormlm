#version 450

// Sequential top-k/shared MoE accumulation. Dispatches targeting the same
// accumulator are serialized by explicit compute barriers on the host, so an
// atomic float extension is neither required nor enabled on Navi 10.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Expert { float expert[]; };
layout(set = 0, binding = 1) buffer Accumulator { float accumulator[]; };

layout(push_constant) uniform Push {
    uint n;
    float weight;
} push;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.n) return;
    accumulator[i] += push.weight * expert[i];
}
