#version 450

// Weighted accumulate: y[i] += w * b[i]
// Used to combine MoE expert outputs:  h += weight_e * expert_out_e

layout(local_size_x = 256) in;

layout(set = 0, binding = 0)           buffer Y { float y[]; };
layout(set = 0, binding = 1) readonly  buffer B { float b[]; };

layout(push_constant) uniform Push {
    uint  n;
    float w;
} push;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.n) return;
    y[i] += push.w * b[i];
}
