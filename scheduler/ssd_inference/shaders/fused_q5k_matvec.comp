#version 450

// Fused Q5K matvec: y[n] = dot(dequant(row_n), x)
// Q5K: 176 bytes/block = 44 u32. Same as Q4K but with extra high bit per weight.
// Layout: d(fp16) dmin(fp16) scales[12] qh[32] qs[128]

layout(local_size_x = 128) in;

layout(set = 0, binding = 0) readonly buffer Q { uint q_words[]; };
layout(set = 0, binding = 1) readonly buffer X { float x[]; };
layout(set = 0, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint N;
    uint K;
    uint q_offset;
} push;

shared float partial[128];

uint scale_byte(uint scales_u32[3], uint idx) {
    return (scales_u32[idx / 4u] >> ((idx % 4u) * 8u)) & 0xFFu;
}

void get_scale_min_k4(uint j, uint scales_u32[3], out uint d_out, out uint m_out) {
    if (j < 4u) {
        d_out = scale_byte(scales_u32, j) & 63u;
        m_out = scale_byte(scales_u32, j + 4u) & 63u;
    } else {
        uint sj4 = scale_byte(scales_u32, j + 4u);
        uint sjm4 = scale_byte(scales_u32, j - 4u);
        uint sj = scale_byte(scales_u32, j);
        d_out = (sj4 & 0xFu) | ((sjm4 >> 6u) << 4u);
        m_out = (sj4 >> 4u)  | ((sj    >> 6u) << 4u);
    }
}

void main() {
    uint n = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (n >= push.N) return;

    uint bpr = push.K / 256u;
    uint row_word_base = (push.q_offset + n * bpr * 176u) / 4u; // 176 bytes per block

    float acc = 0.0;

    for (uint k = tid; k < push.K; k += 128u) {
        uint blk = k / 256u;
        uint w_idx = k % 256u;
        uint blk_word = row_word_base + blk * 44u; // 176/4 = 44 u32

        // Header: d, dmin
        vec2 dm = unpackHalf2x16(q_words[blk_word]);
        float d = dm.x;
        float dmin = dm.y;

        // Scales (bytes 4..15 = words 1..3)
        uint scales_u32[3];
        scales_u32[0] = q_words[blk_word + 1u];
        scales_u32[1] = q_words[blk_word + 2u];
        scales_u32[2] = q_words[blk_word + 3u];

        uint pair = w_idx / 64u;
        uint within = w_idx % 64u;
        uint is_high = within / 32u;
        uint l = within % 32u;
        uint sub_idx = 2u * pair + is_high;

        uint sc, m;
        get_scale_min_k4(sub_idx, scales_u32, sc, m);
        float d_sub = d * float(sc);
        float m_sub = dmin * float(m);

        // Read low 4 bits from qs (bytes 48..175 = words 12..43)
        uint qs_byte_pos = 32u * pair + l;
        uint qs_word = blk_word + 12u + qs_byte_pos / 4u;
        uint qs_byte = (q_words[qs_word] >> ((qs_byte_pos % 4u) * 8u)) & 0xFFu;
        uint q4 = (is_high == 0u) ? (qs_byte & 0xFu) : (qs_byte >> 4u);

        // Read high bit from qh (bytes 16..47 = words 4..11)
        uint qh_byte_idx = w_idx / 8u;
        uint qh_bit = w_idx % 8u;
        uint qh_word = blk_word + 4u + qh_byte_idx / 4u;
        uint qh_byte = (q_words[qh_word] >> ((qh_byte_idx % 4u) * 8u)) & 0xFFu;
        uint hbit = (qh_byte >> qh_bit) & 1u;

        uint q5 = q4 | (hbit << 4u);
        float w = d_sub * float(q5) - m_sub;
        acc += w * x[k];
    }

    partial[tid] = acc;
    barrier();
    for (uint stride = 64u; stride > 0u; stride >>= 1u) {
        if (tid < stride) partial[tid] += partial[tid + stride];
        barrier();
    }
    if (tid == 0u) y[n] = partial[0];
}
