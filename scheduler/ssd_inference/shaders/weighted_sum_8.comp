#version 450

// Weighted sum of K expert outputs into hidden state:
//   h[i] += sum(weights[e] * d[e * D + i]) for e = 0..n_experts-1
//
// Dispatch: ((D + 255) / 256, 1, 1)

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer H       { float h[]; };
layout(set = 0, binding = 1) readonly buffer D_ALL { float d_all[]; };

layout(push_constant) uniform Push {
    uint D;
    uint n_experts;
    float weights[8];
} push;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.D) return;

    float acc = 0.0;
    for (uint e = 0u; e < push.n_experts; e++) {
        acc += push.weights[e] * d_all[e * push.D + i];
    }
    h[i] += acc;
}
