#version 450

// Official Expert.forward emits BF16 after w2, then the model accumulates the
// six routed experts and one shared expert in FP32.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Expert { float expert[]; };
layout(set = 0, binding = 1) buffer Accumulator { float accumulator[]; };

layout(push_constant) uniform Push { uint n; } push;

float round_bf16(float value) {
    uint bits = floatBitsToUint(value);
    uint exponent = bits & 0x7f800000u;
    if (exponent == 0x7f800000u) {
        return value;
    }
    uint rounded = bits + 0x00007fffu + ((bits >> 16u) & 1u);
    return uintBitsToFloat(rounded & 0xffff0000u);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.n) return;
    accumulator[i] += round_bf16(expert[i]);
}
