#version 450

// SwiGLU activation used in MoE FFN: y[i] = silu(gate[i]) * up[i]
// where silu(x) = x / (1 + exp(-x)) = x * sigmoid(x)
//
// Element-wise. One thread per output element.

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly  buffer GATE { float gate[]; };
layout(set = 0, binding = 1) readonly  buffer UP   { float up[]; };
layout(set = 0, binding = 2) writeonly buffer Y    { float y[]; };

layout(push_constant) uniform Push { uint n; } push;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= push.n) return;
    float g = gate[i];
    float silu = g / (1.0 + exp(-g));
    y[i] = silu * up[i];
}
