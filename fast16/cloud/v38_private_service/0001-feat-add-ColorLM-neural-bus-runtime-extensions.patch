+    if (g_q35_neural_block_model != &model) {
+        g_q35_neural_block.reset();
+        g_q35_neural_block_model = &model;
+    }
+    if (!g_q35_neural_block) {
+        ggml_backend_buffer_type_t buft = q35_pick_gpu_buft(model);
