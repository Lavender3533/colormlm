+static void q35_hidden_dump_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data) {
+        return;
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+    if (src->type != GGML_TYPE_F32) {
+        return;
+    }
+
+    const char * raw_path = std::getenv("COLORLM_HIDDEN_DUMP");
+    if (!raw_path || raw_path[0] == '\0') {
+        return;
+    }
+    const char * raw_limit = std::getenv("COLORLM_HIDDEN_DUMP_MAX_RECORDS");
+    const uint32_t limit = raw_limit ? (uint32_t) std::max(0, std::atoi(raw_limit)) : 96u;
+    std::lock_guard<std::mutex> lock(g_q35_hidden_dump_mutex);
+    const bool reset = g_q35_hidden_dump_path != raw_path;
+    if (reset) {
+        g_q35_hidden_dump_path = raw_path;
+        g_q35_hidden_dump_count.store(0);
+    }
+    const uint32_t record = g_q35_hidden_dump_count.fetch_add(1);
+    if (record >= limit) {
+        return;
+    }
+
+    struct dump_header {
+        uint32_t magic;
+        uint32_t version;
+        int32_t layer;
+        uint32_t type;
+        int64_t ne[4];
+        uint64_t payload_bytes;
+    };
+    const dump_header header = {
+        0x394d4c43u, // "CLM9" in little endian
+        1u,
+        (int32_t) (uintptr_t) userdata,
+        (uint32_t) src->type,
+        {src->ne[0], src->ne[1], src->ne[2], src->ne[3]},
+        (uint64_t) ggml_nbytes(src),
+    };
+
+    std::ofstream output(
+        raw_path,
+        std::ios::binary | std::ios::out | (reset ? std::ios::trunc : std::ios::app));
+    if (!output) {
+        LLAMA_LOG_ERROR("ColorLM hidden dump cannot open: %s\n", raw_path);
+        return;
+    }
+    output.write((const char *) &header, sizeof(header));
+    output.write((const char *) src->data, (std::streamsize) ggml_nbytes(src));
+}
+
+static bool q35_k3_feature_dump_enabled_at(int il) {
+    const char * raw_path = std::getenv("COLORLM_K3_FEATURE_DUMP");
+    if (!raw_path || raw_path[0] == '\0') {
+        return false;
+    }
+
+    const char * raw_sites = std::getenv("COLORLM_K3_FEATURE_DUMP_SITES");
+    std::stringstream stream(raw_sites ? raw_sites : "28");
+    std::string item;
+    while (std::getline(stream, item, ',')) {
+        if (!item.empty() && std::stoi(item) == il) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void q35_k3_feature_dump_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data) {
+        return;
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+    if (src->type != GGML_TYPE_F32 || src->ne[0] != 6) {
+        return;
+    }
+
+    const char * raw_path = std::getenv("COLORLM_K3_FEATURE_DUMP");
+    if (!raw_path || raw_path[0] == '\0') {
+        return;
+    }
+    const char * raw_limit = std::getenv("COLORLM_K3_FEATURE_DUMP_MAX_RECORDS");
+    const uint32_t limit = raw_limit ? (uint32_t) std::max(0, std::atoi(raw_limit)) : 96u;
+    std::lock_guard<std::mutex> lock(g_q35_k3_feature_dump_mutex);
+    const bool reset = g_q35_k3_feature_dump_path != raw_path;
+    if (reset) {
+        g_q35_k3_feature_dump_path = raw_path;
+        g_q35_k3_feature_dump_count.store(0);
+    }
+    const uint32_t record = g_q35_k3_feature_dump_count.fetch_add(1);
+    if (record >= limit) {
+        return;
+    }
+
+    struct dump_header {
+        uint32_t magic;
+        uint32_t version;
+        int32_t layer;
+        uint32_t type;
+        int64_t ne[4];
+        uint64_t payload_bytes;
+    };
+    const dump_header header = {
+        0x46334c43u, // "CL3F" in little endian
+        1u,
+        (int32_t) (uintptr_t) userdata,
+        (uint32_t) src->type,
+        {src->ne[0], src->ne[1], src->ne[2], src->ne[3]},
+        (uint64_t) ggml_nbytes(src),
+    };
+
+    std::ofstream output(
+        raw_path,
+        std::ios::binary | std::ios::out | (reset ? std::ios::trunc : std::ios::app));
+    if (!output) {
+        LLAMA_LOG_ERROR("ColorLM K3 feature dump cannot open: %s\n", raw_path);
+        return;
+    }
+    output.write((const char *) &header, sizeof(header));
+    output.write((const char *) src->data, (std::streamsize) ggml_nbytes(src));
+}
+
+static bool q35_output_capture_enabled() {
+    const char * raw_path = std::getenv("COLORLM_NEURAL_OUTPUT_CAPTURE");
+    return raw_path && raw_path[0] != '\0';
+}
+
+static void q35_output_capture_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data) {
+        return;
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+
+    const char * raw_path = std::getenv("COLORLM_NEURAL_OUTPUT_CAPTURE");
+    if (!raw_path || raw_path[0] == '\0') {
+        return;
+    }
+    const char * raw_arm = std::getenv("COLORLM_NEURAL_OUTPUT_CAPTURE_ARM");
+    if (raw_arm && raw_arm[0] != '\0' && !std::filesystem::exists(raw_arm)) {
+        return;
+    }
+    const uint32_t kind = (uint32_t) (uintptr_t) userdata;
+    if (kind < Q35_CAPTURE_BASE_LOGITS || kind > Q35_CAPTURE_BASE_HIDDEN) {
+        return;
+    }
+    const char * raw_limit = std::getenv("COLORLM_NEURAL_OUTPUT_CAPTURE_MAX_RECORDS");
+    const uint32_t limit = raw_limit ? (uint32_t) std::max(0, std::atoi(raw_limit)) : 256u;
+
+    std::lock_guard<std::mutex> lock(g_q35_output_capture_mutex);
+    const bool reset = g_q35_output_capture_path != raw_path;
+    if (reset) {
+        g_q35_output_capture_path = raw_path;
+        std::fill(std::begin(g_q35_output_capture_counts),
+                  std::end(g_q35_output_capture_counts), 0u);
+    }
+    const uint32_t record = g_q35_output_capture_counts[kind]++;
+    if (record >= limit) {
+        return;
+    }
+
+    struct capture_header {
+        uint32_t magic;
+        uint32_t version;
+        uint32_t kind;
+        uint32_t record;
+        uint32_t type;
+        uint32_t reserved;
+        int64_t ne[4];
+        uint64_t payload_bytes;
+    };
+    static_assert(sizeof(capture_header) == 64, "unexpected output capture header layout");
+    const capture_header header = {
+        0x424f4e43u, // "CNOB" in little endian
+        1u,
+        kind,
+        record,
+        (uint32_t) src->type,
+        0u,
+        {src->ne[0], src->ne[1], src->ne[2], src->ne[3]},
+        (uint64_t) ggml_nbytes(src),
+    };
+
+    std::ofstream output(
+        raw_path,
+        std::ios::binary | std::ios::out | (reset ? std::ios::trunc : std::ios::app));
+    if (!output) {
+        LLAMA_LOG_ERROR("ColorLM output capture cannot open: %s\n", raw_path);
+        return;
+    }
+    output.write((const char *) &header, sizeof(header));
+    output.write((const char *) src->data, (std::streamsize) ggml_nbytes(src));
+}
+
+static bool q35_slot_pool_requested() {
+    const char * value = std::getenv("COLORLM_MOE_SLOT_POOL");
+    return value != nullptr && value[0] != '0';
+}
+
+static void q35_try_init_slot_pool(const llama_model & model) {
+    if (!q35_slot_pool_requested() || g_q35_slot_pool || g_q35_slot_init_failed) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(g_q35_slot_mutex);
+    if (g_q35_slot_pool || g_q35_slot_init_failed) {
+        return;
+    }
+
+    const auto & h = model.hparams;
+    const uint32_t n_expert = h.n_expert;
+    const uint32_t n_layer = h.n_layer;
+    const uint32_t n_used = h.n_expert_used;
+    const int64_t n_ff_exp = h.n_ff_exp;
+    if (n_expert == 0 || n_layer == 0 || n_used == 0 || n_ff_exp <= 0) {
+        g_q35_slot_init_failed = true;
+        return;
+    }
+
+    const char * layers_env = std::getenv("COLORLM_MOE_SLOT_LAYERS");
+    const char * slots_env = std::getenv("COLORLM_MOE_SLOT_K");
+    uint32_t pool_layers = layers_env ? (uint32_t) std::atoi(layers_env) : 29;
+    uint32_t k_prime = slots_env ? (uint32_t) std::atoi(slots_env) : n_used;
+    pool_layers = std::clamp<uint32_t>(pool_layers, 1, n_layer);
+    k_prime = std::clamp<uint32_t>(k_prime, n_used, n_expert);
+
+    const auto & layer0 = model.layers[0];
+    if (!layer0.ffn_gate_exps || !layer0.ffn_up_exps || !layer0.ffn_down_exps) {
+        LLAMA_LOG_ERROR("ColorLM slot pool: separate gate/up/down expert tensors are required\n");
+        g_q35_slot_init_failed = true;
+        return;
+    }
+    if (!ggml_get_data(layer0.ffn_gate_exps) ||
+        !ggml_get_data(layer0.ffn_up_exps) ||
+        !ggml_get_data(layer0.ffn_down_exps)) {
+        // Model buffers are not host-visible yet. A later graph build can retry.
+        return;
+    }
+
+    ggml_backend_buffer_type_t buft = q35_pick_gpu_buft(model);
+    if (!buft) {
+        LLAMA_LOG_ERROR("ColorLM slot pool: no GPU buffer type found\n");
+        g_q35_slot_init_failed = true;
+        return;
+    }
+
+    slot_pool::config config{};
+    config.n_layers = pool_layers;
+    config.k_prime = k_prime;
+    config.n_embd = h.n_embd;
+    config.n_ff_exp = n_ff_exp;
+    config.gate_type = layer0.ffn_gate_exps->type;
+    config.up_type = layer0.ffn_up_exps->type;
+    config.down_type = layer0.ffn_down_exps->type;
+    config.buft = buft;
+
+    std::unique_ptr<slot_pool> pool = slot_pool::create(config);
+    if (!pool) {
+        LLAMA_LOG_ERROR("ColorLM slot pool: allocation failed\n");
+        g_q35_slot_init_failed = true;
+        return;
+    }
+    pool->set_n_logical_experts(n_expert);
+
+    const size_t gate_bytes = pool->gate_bytes_per_expert();
+    const size_t up_bytes = pool->up_bytes_per_expert();
+    const size_t down_bytes = pool->down_bytes_per_expert();
+    g_q35_slot_layers.assign(pool_layers, {});
+    g_q35_slot_to_expert.assign((size_t) pool_layers * k_prime, -1);
+    g_q35_slot_last_use.assign((size_t) pool_layers * k_prime, 0);
+
+    for (uint32_t il = 0; il < pool_layers; ++il) {
+        const auto & layer = model.layers[il];
+        if (!layer.ffn_gate_exps || !layer.ffn_up_exps || !layer.ffn_down_exps ||
+            layer.ffn_gate_exps_s || layer.ffn_up_exps_s || layer.ffn_down_exps_s) {
+            LLAMA_LOG_ERROR("ColorLM slot pool: unsupported expert layout at layer %u\n", il);
+            g_q35_slot_init_failed = true;
+            return;
+        }
+        if (!layer.ffn_gate_exps->buffer || !layer.ffn_up_exps->buffer || !layer.ffn_down_exps->buffer ||
+            !ggml_backend_buffer_is_host(layer.ffn_gate_exps->buffer) ||
+            !ggml_backend_buffer_is_host(layer.ffn_up_exps->buffer) ||
+            !ggml_backend_buffer_is_host(layer.ffn_down_exps->buffer)) {
+            LLAMA_LOG_ERROR("ColorLM slot pool: layer %u expert weights are not host-visible\n", il);
+            g_q35_slot_init_failed = true;
+            return;
+        }
+        const uint8_t * gate = (const uint8_t *) ggml_get_data(layer.ffn_gate_exps);
+        const uint8_t * up = (const uint8_t *) ggml_get_data(layer.ffn_up_exps);
+        const uint8_t * down = (const uint8_t *) ggml_get_data(layer.ffn_down_exps);
+        if (!gate || !up || !down ||
+            layer.ffn_gate_exps->nb[2] != gate_bytes ||
+            layer.ffn_up_exps->nb[2] != up_bytes ||
+            layer.ffn_down_exps->nb[2] != down_bytes) {
+            LLAMA_LOG_ERROR("ColorLM slot pool: expert stride mismatch at layer %u\n", il);
+            g_q35_slot_init_failed = true;
+            return;
+        }
+        g_q35_slot_layers[il] = { gate, up, down };
+        int32_t * lut = pool->lut_host(il);
+        std::fill(lut, lut + n_expert, slot_pool::SENTINEL_SLOT);
+        for (uint32_t slot = 0; slot < k_prime; ++slot) {
+            const uint32_t expert = slot;
+            pool->stage(il, slot,
+                gate + (size_t) expert * gate_bytes, gate_bytes,
+                up + (size_t) expert * up_bytes, up_bytes,
+                down + (size_t) expert * down_bytes, down_bytes);
+            lut[expert] = (int32_t) slot;
+            g_q35_slot_to_expert[(size_t) il * k_prime + slot] = (int32_t) expert;
+            g_q35_slot_last_use[(size_t) il * k_prime + slot] = ++g_q35_slot_tick;
+        }
+    }
+    pool->lut_upload_all();
+    slot_pool::set_active(pool.get());
+    LLAMA_LOG_INFO(
+        "ColorLM exact slot pool: %u layers x %u slots, %.2f MiB VRAM\n",
+        pool_layers, k_prime, pool->total_vram_bytes() / (1024.0 * 1024.0));
+    g_q35_slot_model = &model;
+    g_q35_slot_pool = std::move(pool);
+}
+
+static void q35_stage_selected_experts_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data || !g_q35_slot_pool) {
+        return;
+    }
+
+    const uint32_t layer = (uint32_t) (uintptr_t) userdata;
+    const auto & config = g_q35_slot_pool->get_config();
+    if (layer >= config.n_layers) {
+        std::memcpy(dst->data, src->data, ggml_nbytes(src));
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(g_q35_slot_mutex);
+    const int32_t * selected = (const int32_t *) src->data;
+    const size_t selected_count = ggml_nelements(src);
+    int32_t * lut = g_q35_slot_pool->lut_host(layer);
+    const size_t gate_bytes = g_q35_slot_pool->gate_bytes_per_expert();
+    const size_t up_bytes = g_q35_slot_pool->up_bytes_per_expert();
+    const size_t down_bytes = g_q35_slot_pool->down_bytes_per_expert();
+    const auto & source = g_q35_slot_layers[layer];
+    bool lut_dirty = false;
+
+    for (size_t i = 0; i < selected_count; ++i) {
+        const int32_t expert = selected[i];
+        if (expert < 0 || (uint32_t) expert >= g_q35_slot_pool->n_logical_experts()) {
+            GGML_ABORT("ColorLM slot pool received an invalid expert id");
+        }
+        int32_t slot = lut[expert];
+        if (slot >= 0 && (uint32_t) slot < config.k_prime) {
+            ++g_q35_slot_hits;
+            g_q35_slot_last_use[(size_t) layer * config.k_prime + (uint32_t) slot] = ++g_q35_slot_tick;
+            continue;
+        }
+
+        ++g_q35_slot_misses;
+        uint32_t victim = 0;
+        uint64_t oldest = UINT64_MAX;
+        for (uint32_t candidate = 0; candidate < config.k_prime; ++candidate) {
+            const size_t offset = (size_t) layer * config.k_prime + candidate;
+            if (g_q35_slot_last_use[offset] < oldest) {
+                oldest = g_q35_slot_last_use[offset];
+                victim = candidate;
+            }
+        }
+        const size_t victim_offset = (size_t) layer * config.k_prime + victim;
+        const int32_t evicted = g_q35_slot_to_expert[victim_offset];
+        if (evicted >= 0) {
+            lut[evicted] = slot_pool::SENTINEL_SLOT;
+        }
+        g_q35_slot_pool->stage(layer, victim,
+            source.gate + (size_t) expert * gate_bytes, gate_bytes,
+            source.up + (size_t) expert * up_bytes, up_bytes,
+            source.down + (size_t) expert * down_bytes, down_bytes);
+        lut[expert] = (int32_t) victim;
+        g_q35_slot_to_expert[victim_offset] = expert;
+        g_q35_slot_last_use[victim_offset] = ++g_q35_slot_tick;
+        lut_dirty = true;
+    }
+    if (lut_dirty) {
+        g_q35_slot_pool->lut_upload(layer);
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+
+    const uint64_t observations = g_q35_slot_hits + g_q35_slot_misses;
+    if (observations != 0 && observations % 1024 < selected_count) {
+        LLAMA_LOG_INFO("ColorLM slot pool hit rate: %.1f%% (%llu/%llu)\n",
+            100.0 * (double) g_q35_slot_hits / (double) observations,
+            (unsigned long long) g_q35_slot_hits,
+            (unsigned long long) observations);
+    }
+}
+
+static void q35_stage_neural_island_experts_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data || !userdata) {
+        return;
+    }
+    auto * cache = static_cast<llama_neural_expert_cache *>(userdata);
+    const auto * selected = static_cast<const int32_t *>(src->data);
+    llama_neural_expert_cache::stats snapshot{};
+    if (!cache->ensure_resident(selected, ggml_nelements(src), &snapshot)) {
+        GGML_ABORT("ColorLM Neural Island could not satisfy an exact expert-cache miss");
+    }
+    const char * route_dump_path =
+        std::getenv("COLORLM_NEURAL_ISLAND_ROUTE_DUMP");
+    if (route_dump_path && route_dump_path[0] != '\0') {
+        const char * raw_limit =
+            std::getenv("COLORLM_NEURAL_ISLAND_ROUTE_DUMP_MAX_RECORDS");
+        const uint32_t limit = raw_limit
+            ? (uint32_t) std::max(0, std::atoi(raw_limit))
+            : 2048u;
+        std::lock_guard<std::mutex> lock(
+            g_q35_neural_island_route_dump_mutex);
+        const bool reset =
+            g_q35_neural_island_route_dump_path != route_dump_path;
+        if (reset) {
+            g_q35_neural_island_route_dump_path = route_dump_path;
+            g_q35_neural_island_route_dump_count = 0;
+        }
+        if (g_q35_neural_island_route_dump_count < limit) {
+            struct route_dump_header {
+                uint32_t magic;
+                uint32_t version;
+                int32_t source_layer;
+                uint32_t selected_count;
+                uint64_t step;
+            };
+            const route_dump_header header = {
+                0x52454c43u, // "CLER" in little endian
+                1u,
+                snapshot.source_layer,
+                (uint32_t) ggml_nelements(src),
+                snapshot.steps,
+            };
+            std::ofstream output(
+                route_dump_path,
+                std::ios::binary | std::ios::out |
+                    (reset ? std::ios::trunc : std::ios::app));
+            if (!output) {
+                LLAMA_LOG_ERROR(
+                    "ColorLM Neural Island route dump cannot open: %s\n",
+                    route_dump_path);
+            } else {
+                output.write((const char *) &header, sizeof(header));
+                output.write(
+                    (const char *) selected,
+                    (std::streamsize) ggml_nbytes(src));
+                ++g_q35_neural_island_route_dump_count;
+            }
+        }
+    }
+    if (snapshot.steps == 1 || snapshot.steps % 32 == 0) {
+        const uint64_t observations = snapshot.hits + snapshot.misses;
+        const double hit_rate = observations == 0
+            ? 0.0
+            : 100.0 * (double) snapshot.hits / (double) observations;
+        LLAMA_LOG_INFO(
+            "ColorLM Neural Island cache: source_layer=%d steps=%llu hits=%llu misses=%llu hit_rate=%.1f%% upload_bytes=%llu upload_batches=%llu weight_upload_calls=%llu resident=%u capacity=%u\n",
+            snapshot.source_layer,
+            (unsigned long long) snapshot.steps,
+            (unsigned long long) snapshot.hits,
+            (unsigned long long) snapshot.misses,
+            hit_rate,
+            (unsigned long long) snapshot.upload_bytes,
+            (unsigned long long) snapshot.upload_batches,
+            (unsigned long long) snapshot.weight_upload_calls,
+            snapshot.resident,
+            snapshot.capacity);
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+}
+
+static ggml_tensor * q35_build_neural_island_exact_moe(
+        ggml_context * ctx0,
+        ggml_cgraph * gf,
+        llama_neural_expert_cache * cache,
+        int64_t n_expert,
+        int64_t n_expert_used,
+        ggml_tensor * cur,
+        ggml_tensor * router_logits,
+        ggml_tensor * source_up,
+        ggml_tensor * source_gate,
+        ggml_tensor * source_down) {
+    const int64_t n_embd = cur->ne[0];
+    const int64_t n_tokens = cur->ne[1];
+    GGML_ASSERT(n_expert > 0 && n_expert_used > 0 &&
+        n_expert_used <= LLAMA_MAX_EXPERTS);
+
+    ggml_tensor * probs = ggml_soft_max(ctx0, router_logits);
+    ggml_tensor * selected = ggml_argsort_top_k(ctx0, probs, n_expert_used);
+    if (cache) {
+        // Keep the callback on the consumed ID path. This gives the scheduler
+        // an explicit cross-backend dependency from expert uploads to remap.
+        selected = ggml_cont(ctx0, selected);
+        selected = ggml_map_custom1(
+            ctx0, selected, q35_stage_neural_island_experts_cb, 1, cache);
+        ggml_build_forward_expand(gf, selected);
+    }
+
+    probs = ggml_reshape_3d(ctx0, probs, 1, n_expert, n_tokens);
+    ggml_tensor * weights = ggml_get_rows(ctx0, probs, selected);
+    weights = ggml_reshape_2d(ctx0, weights, n_expert_used, n_tokens);
+    ggml_tensor * weights_sum = ggml_sum_rows(ctx0, weights);
+    weights_sum = ggml_clamp(ctx0, weights_sum, 6.103515625e-5f, INFINITY);
+    weights = ggml_div(ctx0, weights, weights_sum);
+    weights = ggml_reshape_3d(ctx0, weights, 1, n_expert_used, n_tokens);
+    ggml_build_forward_expand(gf, weights);
+
+    ggml_tensor * expert_ids = selected;
+    ggml_tensor * up_weights = source_up;
+    ggml_tensor * gate_weights = source_gate;
+    ggml_tensor * down_weights = source_down;
+    if (cache) {
+        slot_pool * pool = cache->pool();
+        GGML_ASSERT(pool != nullptr && pool->lut_gpu(0) != nullptr);
+        ggml_tensor * selected_flat = ggml_view_1d(
+            ctx0, selected, n_expert_used * n_tokens, 0);
+        ggml_tensor * remapped_flat = ggml_get_rows(
+            ctx0, pool->lut_gpu(0), selected_flat);
+        expert_ids = ggml_reshape_2d(
+            ctx0, remapped_flat, n_expert_used, n_tokens);
+        up_weights = pool->up(0);
+        gate_weights = pool->gate(0);
+        down_weights = pool->down(0);
+    }
+
+    cur = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+    ggml_tensor * up = ggml_mul_mat_id(ctx0, up_weights, cur, expert_ids);
