diff --git a/tools/transfer-bench/transfer_bench.cpp b/tools/transfer-bench/transfer_bench.cpp
new file mode 100644
index 0000000..ec86c6c
--- /dev/null
+++ b/tools/transfer-bench/transfer_bench.cpp
@@ -0,0 +1,222 @@
+// CPU → GPU transfer benchmark.
+//
+// Measures the floor for our B1 path: how fast can we ggml_backend_tensor_set
+// expert-sized chunks (1-64 MB) from host into Vulkan device memory on the
+// active GPU. Sync and async paths.
+//
+// What we want to learn:
+//   - Single transfer bandwidth at various sizes (find the sweet spot)
+//   - Whether async overlaps anything useful (no compute here, just transfer)
+//   - Per-call overhead vs payload (drives K' choice in slot pool)
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <string>
+
+static double now_ms() {
+    using clock = std::chrono::steady_clock;
+    static const auto t0 = clock::now();
+    return std::chrono::duration<double, std::milli>(clock::now() - t0).count();
+}
+
+static void bench_one(ggml_backend_t backend, ggml_backend_buffer_type_t buft,
+                      size_t bytes, int n_iters, bool async_call,
+                      const char * label) {
+    // create a 1D F32 tensor of the requested size
+    const size_t n_elem = bytes / sizeof(float);
+    const size_t actual_bytes = n_elem * sizeof(float);
+
+    ggml_init_params ip = { /*.mem_size=*/ ggml_tensor_overhead(),
+                            /*.mem_buffer=*/ NULL,
+                            /*.no_alloc=*/ true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * t = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_elem);
+
+    ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(buft, actual_bytes);
+    if (!buf) {
+        printf("  [%-20s] alloc %zu MB FAILED\n", label, bytes / (1024 * 1024));
+        ggml_free(ctx);
+        return;
+    }
+    ggml_tallocr alloc = ggml_tallocr_new(buf);
+    ggml_tallocr_alloc(&alloc, t);
+
+    // CPU staging buffer (page-aligned via std::vector with reserve+resize)
+    std::vector<uint8_t> staging(actual_bytes);
+    for (size_t i = 0; i < actual_bytes; ++i) staging[i] = (uint8_t)(i & 0xff);
+
+    // warmup
+    ggml_backend_tensor_set(t, staging.data(), 0, actual_bytes);
+    ggml_backend_synchronize(backend);
+
+    double t0 = now_ms();
+    if (async_call) {
+        for (int i = 0; i < n_iters; ++i) {
+            ggml_backend_tensor_set_async(backend, t, staging.data(), 0, actual_bytes);
+        }
+        ggml_backend_synchronize(backend);
+    } else {
+        for (int i = 0; i < n_iters; ++i) {
+            ggml_backend_tensor_set(t, staging.data(), 0, actual_bytes);
+        }
+    }
+    double t1 = now_ms();
+
+    double total_ms = t1 - t0;
+    double per_ms = total_ms / n_iters;
+    double total_bytes = (double)actual_bytes * n_iters;
+    double gbps = (total_bytes / (total_ms / 1000.0)) / (1024.0 * 1024.0 * 1024.0);
+
+    printf("  [%-20s] size=%6zu KB  iters=%4d  total=%8.2f ms  per=%7.3f ms  bw=%6.2f GB/s\n",
+           label, bytes / 1024, n_iters, total_ms, per_ms, gbps);
+
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+}
+
+int main(int argc, char ** argv) {
+    (void)argc; (void)argv;
+
+    // Load all backends so Vulkan registers itself.
+    ggml_backend_load_all();
+
+    // Print all devices.
+    printf("Devices visible to ggml:\n");
+    int n_dev = (int)ggml_backend_dev_count();
+    for (int i = 0; i < n_dev; ++i) {
+        ggml_backend_dev_t d = ggml_backend_dev_get(i);
+        printf("  %d: %s (%s) type=%d\n", i,
+               ggml_backend_dev_name(d), ggml_backend_dev_description(d),
+               (int)ggml_backend_dev_type(d));
+    }
+    printf("\n");
+
+    // Pick the first non-CPU device (should be Vulkan on the user's system).
+    ggml_backend_dev_t dev = nullptr;
+    for (int i = 0; i < n_dev; ++i) {
+        ggml_backend_dev_t d = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(d) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            dev = d;
+            break;
+        }
+    }
+    if (!dev) {
+        printf("No GPU device found.\n");
+        return 1;
+    }
+
+    ggml_backend_t backend = ggml_backend_dev_init(dev, nullptr);
+    if (!backend) {
+        printf("Failed to init backend.\n");
+        return 1;
+    }
+    printf("Using backend: %s on %s\n\n",
+           ggml_backend_name(backend), ggml_backend_dev_name(dev));
+
+    // device buffer type (regular VRAM)
+    ggml_backend_buffer_type_t buft = ggml_backend_dev_buffer_type(dev);
+
+    // pinned host buffer type (if supported)
+    ggml_backend_buffer_type_t host_buft = ggml_backend_dev_host_buffer_type(dev);
+    printf("Device buffer type: %s\n", ggml_backend_buft_name(buft));
+    if (host_buft) {
+        printf("Host buffer type:   %s (pinned host memory)\n", ggml_backend_buft_name(host_buft));
+    } else {
+        printf("Host buffer type:   <none> (no pinned host memory available)\n");
+    }
+    printf("\n");
+
+    ggml_backend_dev_props props;
+    ggml_backend_dev_get_props(dev, &props);
+    printf("Device caps: async=%d host_buffer=%d events=%d\n\n",
+           (int)props.caps.async, (int)props.caps.host_buffer, (int)props.caps.events);
+
+    // Sizes that match a single Q4_K_M expert in Qwen3-30B-A3B:
+    //   one expert (gate or up or down) ≈ n_embd × n_ff_exp × 0.5625 byte
+    //   with n_embd=2048, n_ff_exp=768  →  ~880 KB
+    //   K' = 16 slots × 3 tensors × 880 KB ≈ 42 MB per layer
+    struct case_t { size_t bytes; int iters; const char * note; };
+    case_t cases[] = {
+        {  256 * 1024,        200, "256 KB (small)"      },
+        {  880 * 1024,        100, "~880 KB (1 expert)"  },
+        { 2  * 1024 * 1024,   80,  "2 MB"                },
+        { 8  * 1024 * 1024,   50,  "8 MB"                },
+        { 16 * 1024 * 1024,   30,  "16 MB"               },
+        { 42 * 1024 * 1024,   20,  "~42 MB (K=16 layer)" },
+        { 64 * 1024 * 1024,   15,  "64 MB"               },
+        { 128* 1024 * 1024,   10,  "128 MB"              },
+    };
+
+    printf("=== sync ggml_backend_tensor_set (pageable host memory) ===\n");
+    for (auto & c : cases) {
+        bench_one(backend, buft, c.bytes, c.iters, false, c.note);
+    }
+
+    printf("\n=== async ggml_backend_tensor_set_async (pageable host memory) ===\n");
+    for (auto & c : cases) {
+        bench_one(backend, buft, c.bytes, c.iters, true, c.note);
+    }
+
+    if (host_buft) {
+        // For pinned-host benchmarks we can't use the same simple bench helper,
+        // so we hand-roll: alloc the staging buffer in host_buft, copy via memcpy
+        // there once, then time the device transfer.
+        printf("\n=== sync (pinned host buffer source via memcpy → device tensor) ===\n");
+        for (auto & c : cases) {
+            const size_t n_elem = c.bytes / sizeof(float);
+            const size_t actual_bytes = n_elem * sizeof(float);
+
+            ggml_init_params ip = { ggml_tensor_overhead(), NULL, true };
+            ggml_context * ctx = ggml_init(ip);
+            ggml_tensor * t = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n_elem);
+
+            ggml_backend_buffer_t dev_buf  = ggml_backend_buft_alloc_buffer(buft, actual_bytes);
+            ggml_backend_buffer_t host_buf = ggml_backend_buft_alloc_buffer(host_buft, actual_bytes);
+            if (!dev_buf || !host_buf) {
+                printf("  alloc failed for %zu KB\n", c.bytes / 1024);
+                if (dev_buf) ggml_backend_buffer_free(dev_buf);
+                if (host_buf) ggml_backend_buffer_free(host_buf);
+                ggml_free(ctx);
+                continue;
+            }
+            ggml_tallocr alloc = ggml_tallocr_new(dev_buf);
+            ggml_tallocr_alloc(&alloc, t);
+
+            void * pinned = ggml_backend_buffer_get_base(host_buf);
+            for (size_t i = 0; i < actual_bytes; ++i) ((uint8_t*)pinned)[i] = (uint8_t)(i & 0xff);
+
+            // warmup
+            ggml_backend_tensor_set(t, pinned, 0, actual_bytes);
+            ggml_backend_synchronize(backend);
+
+            double t0 = now_ms();
+            for (int i = 0; i < c.iters; ++i) {
+                ggml_backend_tensor_set(t, pinned, 0, actual_bytes);
+            }
+            double t1 = now_ms();
+
+            double total_ms = t1 - t0;
+            double per_ms = total_ms / c.iters;
+            double total_bytes = (double)actual_bytes * c.iters;
+            double gbps = (total_bytes / (total_ms / 1000.0)) / (1024.0 * 1024.0 * 1024.0);
+
+            printf("  [%-20s] size=%6zu KB  iters=%4d  total=%8.2f ms  per=%7.3f ms  bw=%6.2f GB/s\n",
+                   c.note, c.bytes / 1024, c.iters, total_ms, per_ms, gbps);
+
+            ggml_backend_buffer_free(dev_buf);
+            ggml_backend_buffer_free(host_buf);
+            ggml_free(ctx);
+        }
+    }
+
+    ggml_backend_free(backend);
+    return 0;
+}
