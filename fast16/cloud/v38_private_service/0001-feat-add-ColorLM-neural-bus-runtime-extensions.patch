+static void q35_neural_island_teacher_dump_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data) {
+        return;
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+    if (src->type != GGML_TYPE_F32 || src->ne[0] <= 0 || src->ne[1] <= 0) {
+        return;
+    }
+    const char * raw_path =
+        std::getenv("COLORLM_NEURAL_ISLAND_TEACHER_DUMP");
+    if (!raw_path || raw_path[0] == '\0') {
+        return;
+    }
+    const char * raw_limit =
+        std::getenv("COLORLM_NEURAL_ISLAND_TEACHER_DUMP_MAX_RECORDS");
+    const uint32_t limit = raw_limit
+        ? (uint32_t) std::max(0, std::atoi(raw_limit))
+        : 256u;
+    std::lock_guard<std::mutex> lock(
+        g_q35_neural_island_teacher_dump_mutex);
+    const bool reset =
+        g_q35_neural_island_teacher_dump_path != raw_path;
+    if (reset) {
+        g_q35_neural_island_teacher_dump_path = raw_path;
+        g_q35_neural_island_teacher_dump_count = 0;
+    }
+    if (g_q35_neural_island_teacher_dump_count >= limit) {
+        return;
+    }
+    struct teacher_dump_header {
+        uint32_t magic;
+        uint32_t version;
+        int32_t layer;
+        uint32_t kind; // 0 = island input, 1 = raw island delta
+        uint64_t ne0;
+        uint64_t ne1;
+        uint64_t payload_bytes;
+    };
+    const uintptr_t tag = (uintptr_t) userdata;
+    const teacher_dump_header header = {
+        0x544c4349u, // "ICLT" in little endian
+        1u,
+        (int32_t) (tag >> 1),
+        (uint32_t) (tag & 1u),
+        (uint64_t) src->ne[0],
+        (uint64_t) src->ne[1],
+        (uint64_t) ggml_nbytes(src),
+    };
+    std::ofstream output(
+        raw_path,
+        std::ios::binary | std::ios::out |
+            (reset ? std::ios::trunc : std::ios::app));
+    if (!output) {
+        LLAMA_LOG_ERROR(
+            "ColorLM Neural Island teacher dump cannot open: %s\n",
+            raw_path);
+        return;
+    }
+    output.write((const char *) &header, sizeof(header));
+    output.write((const char *) src->data, (std::streamsize) ggml_nbytes(src));
+    ++g_q35_neural_island_teacher_dump_count;
+}
