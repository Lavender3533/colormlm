+    uint64_t bytes = 0;
+};
+
+static std::string sha256_file(const std::filesystem::path & path) {
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) {
+        throw std::runtime_error("cannot open Neural Output Head file for SHA-256: " + path.string());
+    }
+    sha256_t context;
+    sha256_init(&context);
+    std::vector<unsigned char> buffer(8 * 1024 * 1024);
+    while (stream) {
+        stream.read(reinterpret_cast<char *>(buffer.data()), (std::streamsize) buffer.size());
+        const std::streamsize count = stream.gcount();
+        if (count > 0) {
+            sha256_update(&context, buffer.data(), (size_t) count);
+        }
+    }
+    if (!stream.eof()) {
+        throw std::runtime_error("failed while hashing Neural Output Head file: " + path.string());
+    }
+    std::array<unsigned char, SHA256_DIGEST_SIZE> digest {};
+    sha256_final(&context, digest.data());
+    std::ostringstream encoded;
+    encoded << std::hex << std::setfill('0');
+    for (unsigned char value : digest) {
+        encoded << std::setw(2) << (unsigned int) value;
+    }
+    return encoded.str();
+}
+
+static bool is_sha256(const std::string & value) {
+    return value.size() == SHA256_DIGEST_SIZE * 2 &&
+        std::all_of(value.begin(), value.end(), [](unsigned char c) {
+            return std::isxdigit(c) != 0;
+        });
+}
+
+static ggml_type parse_type(const std::string & value) {
+    if (value == "F32") {
+        return GGML_TYPE_F32;
+    }
+    if (value == "Q6_K") {
+        return GGML_TYPE_Q6_K;
+    }
+    if (value == "I32") {
+        return GGML_TYPE_I32;
+    }
+    if (value == "I64") {
+        return GGML_TYPE_I64;
+    }
+    throw std::runtime_error("unsupported Neural Output Head tensor dtype: " + value);
+}
+
+static std::filesystem::path checked_blob_path(
+        const std::filesystem::path & directory,
+        const std::string & file) {
+    const std::filesystem::path relative(file);
+    if (relative.empty() || relative.is_absolute() || relative.has_parent_path()) {
+        throw std::runtime_error("Neural Output Head weights file must be a basename");
+    }
+    return directory / relative;
+}
+
+} // namespace
+
+std::unique_ptr<llama_neural_output_head> llama_neural_output_head::load_qwen3next_q6k(
+        const std::filesystem::path & directory,
+        ggml_backend_buffer_type_t buft,
+        const std::string & expected_manifest_sha256,
+        bool verify_weights_sha256) {
+    if (!buft) {
+        return nullptr;
+    }
+    const std::filesystem::path manifest_path = directory / "head.json";
+    if (!expected_manifest_sha256.empty()) {
+        if (!is_sha256(expected_manifest_sha256) ||
+            sha256_file(manifest_path) != expected_manifest_sha256) {
+            throw std::runtime_error("Neural Output Head manifest SHA-256 mismatch");
+        }
+    }
+    std::ifstream manifest_stream(manifest_path);
+    if (!manifest_stream) {
+        throw std::runtime_error("Neural Output Head requires head.json");
+    }
+    const nlohmann::json manifest = nlohmann::json::parse(manifest_stream);
+    if (manifest.at("format").get<std::string>() !=
+            "colorlm-neural-output-head-runtime-v2" ||
+        !manifest.at("formal").get<bool>() ||
+        manifest.at("runtime_layout").get<std::string>() !=
+            "single-aligned-tensor-blob-v1" ||
+        manifest.at("alignment").get<uint64_t>() != 64) {
+        throw std::runtime_error("unsupported Neural Output Head runtime contract");
+    }
+    const auto & source = manifest.at("source");
+    const auto & target = manifest.at("target");
+    const auto & mapping = manifest.at("mapping");
+    const int donor_vocab = source.at("vocab_size").get<int>();
+    const int base_vocab = target.at("vocab_size").get<int>();
+    const int mapped_tokens = mapping.at("mapped_tokens").get<int>();
+    if (source.at("architecture").get<std::string>() != "Qwen3NextForCausalLM" ||
+        source.at("hidden_size").get<int>() != 2048 ||
+        source.at("output_tied_to_embedding").get<bool>() ||
+        target.at("architecture").get<std::string>() != "ColorLMV4" ||
+        donor_vocab != 151936 || base_vocab != 248320 ||
+        mapped_tokens <= 0 || mapped_tokens > donor_vocab ||
+        mapping.at("method").get<std::string>() !=
+            "exact-tokenizer.ggml.tokens-raw-bytes" ||
+        mapping.at("target_collisions").get<int>() != 0) {
+        throw std::runtime_error("Neural Output Head architecture or mapping mismatch");
+    }
+    const auto & tensor_records = manifest.at("tensors");
+    if (!tensor_records.is_array() || tensor_records.size() != 3 ||
+        tensor_records.size() != manifest.at("tensor_count").get<size_t>()) {
+        throw std::runtime_error("Neural Output Head requires exactly three tensors");
+    }
+    const auto & weights = manifest.at("weights");
+    const std::string weights_sha256 = weights.at("sha256").get<std::string>();
+    if (!is_sha256(weights_sha256)) {
+        throw std::runtime_error("invalid Neural Output Head weights SHA-256");
+    }
+    const std::filesystem::path weights_path = checked_blob_path(
+        directory, weights.at("file").get<std::string>());
+    const uint64_t weights_bytes = weights.at("bytes").get<uint64_t>();
+    std::error_code error;
+    if (std::filesystem::file_size(weights_path, error) != weights_bytes || error) {
+        throw std::runtime_error("Neural Output Head weights size mismatch");
+    }
+    if (verify_weights_sha256 && sha256_file(weights_path) != weights_sha256) {
+        throw std::runtime_error("Neural Output Head weights SHA-256 mismatch");
+    }
+
+    auto head = std::unique_ptr<llama_neural_output_head>(new llama_neural_output_head());
+    head->donor_vocab_size_ = donor_vocab;
+    head->base_vocab_size_ = base_vocab;
+    head->mapped_tokens_ = mapped_tokens;
+    ggml_init_params params = {
+        /*.mem_size   =*/ (tensor_records.size() + 1) * ggml_tensor_overhead() + 64 * 1024,
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    head->ctx_ = ggml_init(params);
+    if (!head->ctx_) {
+        return nullptr;
+    }
+
+    std::vector<tensor_load_record> loads;
+    loads.reserve(tensor_records.size());
+    uint64_t previous_end = 0;
+    for (size_t index = 0; index < tensor_records.size(); ++index) {
+        const auto & record = tensor_records.at(index);
+        const std::string name = record.at("name").get<std::string>();
+        const std::string digest = record.at("sha256").get<std::string>();
+        const std::vector<int64_t> shape = record.at("ggml_shape").get<std::vector<int64_t>>();
+        const uint64_t offset = record.at("offset").get<uint64_t>();
+        const uint64_t bytes = record.at("bytes").get<uint64_t>();
+        if (name.empty() || !is_sha256(digest) || shape.empty() || shape.size() > 4 ||
+            std::any_of(shape.begin(), shape.end(), [](int64_t value) { return value <= 0; }) ||
+            offset % 64 != 0 || offset < previous_end ||
+            bytes > weights_bytes || offset > weights_bytes - bytes) {
+            throw std::runtime_error("invalid Neural Output Head tensor record: " + name);
+        }
+        ggml_tensor * tensor = ggml_new_tensor(
+            head->ctx_, parse_type(record.at("dtype").get<std::string>()),
+            (int) shape.size(), shape.data());
+        if (ggml_nbytes(tensor) != bytes) {
+            throw std::runtime_error("Neural Output Head tensor byte mismatch: " + name);
+        }
+        if (!head->tensors_.emplace(name, tensor).second) {
+            throw std::runtime_error("duplicate Neural Output Head tensor: " + name);
+        }
+        const std::string runtime_name = "neural_output_head." + std::to_string(index);
+        ggml_set_name(tensor, runtime_name.c_str());
+        loads.push_back({tensor, offset, bytes});
+        previous_end = offset + bytes;
+    }
+    const auto require = [&](const std::string & name, ggml_type type,
+                             int64_t ne0, int64_t ne1) {
+        const auto found = head->tensors_.find(name);
+        if (found == head->tensors_.end() || found->second->type != type ||
+            found->second->ne[0] != ne0 || found->second->ne[1] != ne1) {
+            throw std::runtime_error("Neural Output Head missing or invalid tensor: " + name);
+        }
+    };
+    if (mapping.at("projection_layout").get<std::string>() !=
+            "mapped-only-q6-k-raw-rows" ||
+        mapping.at("source_row_bytes").get<int>() != 1680 ||
+        !is_sha256(mapping.at("source_donor_ids_sha256").get<std::string>())) {
+        throw std::runtime_error("unsupported Neural Output Head projection layout");
+    }
+    require("output_norm.weight", GGML_TYPE_F32, 2048, 1);
+    require("output_mapped.weight", GGML_TYPE_Q6_K, 2048, mapped_tokens);
+    require("mapping.base_ids", GGML_TYPE_I64, mapped_tokens, 1);
+
+    head->buffer_ = ggml_backend_alloc_ctx_tensors_from_buft(head->ctx_, buft);
+    if (!head->buffer_) {
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(head->buffer_, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    std::ifstream blob(weights_path, std::ios::binary);
+    if (!blob) {
+        throw std::runtime_error("cannot open Neural Output Head weights blob");
+    }
+    uint64_t max_bytes = 0;
+    for (const auto & record : loads) {
+        max_bytes = std::max(max_bytes, record.bytes);
+    }
+    if (max_bytes > (uint64_t) std::numeric_limits<size_t>::max()) {
+        throw std::runtime_error("Neural Output Head tensor exceeds addressable memory");
+    }
+    std::vector<uint8_t> scratch((size_t) max_bytes);
+    for (const auto & record : loads) {
+        blob.seekg((std::streamoff) record.offset, std::ios::beg);
+        if (!blob.read(reinterpret_cast<char *>(scratch.data()), (std::streamsize) record.bytes)) {
+            throw std::runtime_error("failed to read Neural Output Head tensor from blob");
+        }
+        ggml_backend_tensor_set(record.tensor, scratch.data(), 0, (size_t) record.bytes);
+    }
+    LLAMA_LOG_INFO(
+        "ColorLM Neural Output Head loaded: donor vocab %d -> base vocab %d, mapped %d, %.2f MiB on %s\n",
+        donor_vocab, base_vocab, mapped_tokens,
+        ggml_backend_buffer_get_size(head->buffer_) / 1024.0 / 1024.0,
+        ggml_backend_buffer_name(head->buffer_));
+    return head;
+}
+
+llama_neural_output_head::~llama_neural_output_head() {
+    if (buffer_) {
+        ggml_backend_buffer_free(buffer_);
+    }
+    if (ctx_) {
+        ggml_free(ctx_);
+    }
+}
+
+ggml_tensor * llama_neural_output_head::output_norm() const {
+    return tensors_.at("output_norm.weight");
+}
+
+ggml_tensor * llama_neural_output_head::output() const {
+    return tensors_.at("output_mapped.weight");
+}
+
+ggml_tensor * llama_neural_output_head::base_ids() const {
+    return tensors_.at("mapping.base_ids");
+}
+
+int llama_neural_output_head::donor_vocab_size() const {
+    return donor_vocab_size_;
+}
+
+int llama_neural_output_head::base_vocab_size() const {
+    return base_vocab_size_;
+}
+
+int llama_neural_output_head::mapped_tokens() const {
+    return mapped_tokens_;
+}
+
+size_t llama_neural_output_head::weight_bytes() const {
+    return buffer_ ? ggml_backend_buffer_get_size(buffer_) : 0;
+}
+
+const char * llama_neural_output_head::buffer_name() const {
+    return buffer_ ? ggml_backend_buffer_name(buffer_) : "none";
+}
