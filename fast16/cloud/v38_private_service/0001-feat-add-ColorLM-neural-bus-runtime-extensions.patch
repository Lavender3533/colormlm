+        }
+
+        auto t0 = clk::now();
+        for (int i = 0; i < n_iters; i++) {
+            int cur = i % n_layers;
+            ggml_backend_tensor_set(layers[cur].w,
+                                    layers[cur].w_host.data(), 0, bytes_per_w);
+            ggml_backend_graph_compute(backend, graphs[cur]);
+        }
+        ggml_backend_synchronize(backend);
+        double total = now_ms(t0);
+        printf("  total %.2f ms  | per-iter %.3f ms\n", total, total / n_iters);
+    }
+
+    // ── Test E: pure compute latency (sync per iter) ────
+    // Compute the SAME pre-loaded weight + sync each iter.
+    // Tells us how much of D's 6.63 ms is compute vs transfer.
+    {
+        printf("\n[Test E] compute-only: sync after each compute (no upload)\n");
+        size_t graph_mem = ggml_tensor_overhead() * 8 + ggml_graph_overhead();
+        ggml_init_params gp = { graph_mem, NULL, true };
+        ggml_context_ptr gctx(ggml_init(gp));
