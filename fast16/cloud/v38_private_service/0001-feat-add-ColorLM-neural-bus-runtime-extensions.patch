index 0000000..c7ffab0
--- /dev/null
+++ b/src/llama-neural-policy-head.cpp
@@ -0,0 +1,404 @@
+#include "llama-neural-policy-head.h"
+
+#include "llama-impl.h"
+#include "../vendor/nlohmann/json.hpp"
+
+extern "C" {
+#include "sha256.h"
+}
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+
+struct tensor_load_record {
+    ggml_tensor * tensor = nullptr;
+    uint64_t offset = 0;
+    uint64_t bytes = 0;
+};
+
+static std::string sha256_file(const std::filesystem::path & path) {
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) {
+        throw std::runtime_error("cannot open Sequence Policy file for SHA-256: " + path.string());
+    }
+    sha256_t context;
+    sha256_init(&context);
+    std::vector<unsigned char> buffer(1024 * 1024);
+    while (stream) {
+        stream.read(reinterpret_cast<char *>(buffer.data()), (std::streamsize) buffer.size());
+        const std::streamsize count = stream.gcount();
+        if (count > 0) {
+            sha256_update(&context, buffer.data(), (size_t) count);
+        }
+    }
+    if (!stream.eof()) {
+        throw std::runtime_error("failed while hashing Sequence Policy file: " + path.string());
+    }
+    std::array<unsigned char, SHA256_DIGEST_SIZE> digest {};
+    sha256_final(&context, digest.data());
+    std::ostringstream encoded;
+    encoded << std::hex << std::setfill('0');
+    for (unsigned char value : digest) {
+        encoded << std::setw(2) << (unsigned int) value;
+    }
+    return encoded.str();
+}
+
+static bool is_sha256(const std::string & value) {
+    return value.size() == SHA256_DIGEST_SIZE * 2 &&
+        std::all_of(value.begin(), value.end(), [](unsigned char c) {
+            return std::isxdigit(c) != 0;
+        });
+}
+
+static ggml_type parse_type(const std::string & value) {
+    if (value == "F32") {
+        return GGML_TYPE_F32;
+    }
+    if (value == "I64") {
+        return GGML_TYPE_I64;
+    }
+    throw std::runtime_error("unsupported Sequence Policy tensor dtype: " + value);
+}
+
+static std::filesystem::path checked_blob_path(
+        const std::filesystem::path & directory,
+        const std::string & file) {
+    const std::filesystem::path relative(file);
+    if (relative.empty() || relative.is_absolute() || relative.has_parent_path()) {
+        throw std::runtime_error("Sequence Policy weights file must be a basename");
+    }
+    return directory / relative;
+}
+
+} // namespace
+
+std::unique_ptr<llama_neural_policy_head> llama_neural_policy_head::load_linear_f32(
+        const std::filesystem::path & directory,
+        ggml_backend_buffer_type_t buft,
+        const std::string & expected_manifest_sha256,
+        bool verify_weights_sha256) {
+    if (!buft) {
+        return nullptr;
+    }
+    const std::filesystem::path manifest_path = directory / "policy.json";
+    if (!expected_manifest_sha256.empty()) {
+        if (!is_sha256(expected_manifest_sha256) ||
+            sha256_file(manifest_path) != expected_manifest_sha256) {
+            throw std::runtime_error("Sequence Policy manifest SHA-256 mismatch");
+        }
+    }
+    std::ifstream manifest_stream(manifest_path);
+    if (!manifest_stream) {
+        throw std::runtime_error("Sequence Policy requires policy.json");
+    }
+    const nlohmann::json manifest = nlohmann::json::parse(manifest_stream);
+    const std::string format = manifest.at("format").get<std::string>();
+    const bool dynamic = format == "colorlm-sequence-policy-runtime-v2";
+    const bool pca_multiclass = format == "colorlm-sequence-policy-runtime-v3";
+    if ((format != "colorlm-sequence-policy-runtime-v1" && !dynamic && !pca_multiclass) ||
+        !manifest.at("formal").get<bool>() ||
+        manifest.at("architecture").get<std::string>() != "ColorLMV4" ||
+        manifest.at("runtime_layout").get<std::string>() !=
+            "single-aligned-tensor-blob-v1" ||
+        manifest.at("alignment").get<uint64_t>() != 64) {
+        throw std::runtime_error("unsupported Sequence Policy runtime contract");
+    }
+    const int hidden_size = manifest.at("hidden_size").get<int>();
+    const int base_vocab_size = manifest.at("base_vocab_size").get<int>();
+    const int candidate_tokens = dynamic
+        ? manifest.at("static_token_count").get<int>()
+        : manifest.at("candidate_token_count").get<int>();
+    const int rank = dynamic
+        ? manifest.at("rank").get<int>()
+        : pca_multiclass ? manifest.at("pca_rank").get<int>() : 0;
+    const int class_count = pca_multiclass
+        ? manifest.at("class_count").get<int>()
+        : candidate_tokens;
+    const int candidate_capacity = dynamic
+        ? manifest.at("candidate_capacity").get<int>()
+        : candidate_tokens;
+    const float correction_min = pca_multiclass
+        ? 0.0f : manifest.at("correction_min").get<float>();
+    const float correction_max = pca_multiclass
+        ? 0.0f : manifest.at("correction_max").get<float>();
+    const float correction_strength = pca_multiclass
+        ? manifest.at("correction_strength").get<float>() : 0.0f;
+    if (hidden_size != 2048 || base_vocab_size != 248320 ||
+        candidate_tokens <= 0 || candidate_tokens > 256 ||
+        candidate_capacity < candidate_tokens || candidate_capacity > 256 ||
+        (dynamic && (
+            manifest.at("mode").get<std::string>() != "dynamic-low-rank-bilinear" ||
+            manifest.at("embedding_size").get<int>() != hidden_size ||
+            manifest.at("hidden_normalization").get<std::string>() != "per-sample-l2" ||
+            manifest.at("embedding_normalization").get<std::string>() != "per-token-l2" ||
+            rank <= 0 || rank > 256)) ||
+        (pca_multiclass && (
+            manifest.at("mode").get<std::string>() != "pca-rank8-multiclass-noop-sparse" ||
+            manifest.at("hidden_normalization").get<std::string>() != "per-sample-l2" ||
+            manifest.at("no_op_rule").get<std::string>() !=
+                "exact-no-op-iff-class-0-is-argmax" ||
+            rank != 8 || candidate_tokens < 4 || candidate_tokens > 16 ||
+            class_count != candidate_tokens + 1 ||
+            manifest.at("no_op_class").get<int>() != 0 ||
+            !std::isfinite(correction_strength) || correction_strength <= 0.0f ||
+            correction_strength > 64.0f)) ||
+        (!dynamic && !pca_multiclass &&
+            manifest.at("normalization").get<std::string>() != "per-sample-l2") ||
+        (!pca_multiclass && (
+            !std::isfinite(correction_min) || !std::isfinite(correction_max) ||
+            correction_min >= correction_max)) ||
+        !is_sha256(manifest.at("source_contract_sha256").get<std::string>())) {
+        throw std::runtime_error("Sequence Policy architecture or correction contract mismatch");
+    }
+    const auto & tensor_records = manifest.at("tensors");
+    const size_t expected_tensor_count = pca_multiclass ? 6 : 3;
+    if (!tensor_records.is_array() || tensor_records.size() != expected_tensor_count ||
+        tensor_records.size() != manifest.at("tensor_count").get<size_t>()) {
+        throw std::runtime_error("Sequence Policy tensor count does not match its format");
+    }
+    const auto & weights = manifest.at("weights");
+    const std::string weights_sha256 = weights.at("sha256").get<std::string>();
+    if (!is_sha256(weights_sha256)) {
+        throw std::runtime_error("invalid Sequence Policy weights SHA-256");
+    }
+    const std::filesystem::path weights_path = checked_blob_path(
+        directory, weights.at("file").get<std::string>());
+    const uint64_t weights_bytes = weights.at("bytes").get<uint64_t>();
+    std::error_code error;
+    if (std::filesystem::file_size(weights_path, error) != weights_bytes || error) {
+        throw std::runtime_error("Sequence Policy weights size mismatch");
+    }
+    if ((verify_weights_sha256 || pca_multiclass) &&
+        sha256_file(weights_path) != weights_sha256) {
+        throw std::runtime_error("Sequence Policy weights SHA-256 mismatch");
+    }
+
+    auto head = std::unique_ptr<llama_neural_policy_head>(new llama_neural_policy_head());
+    head->hidden_size_ = hidden_size;
+    head->base_vocab_size_ = base_vocab_size;
+    head->candidate_tokens_ = candidate_tokens;
+    head->dynamic_ = dynamic;
+    head->pca_multiclass_ = pca_multiclass;
+    head->rank_ = rank;
+    head->class_count_ = class_count;
+    head->candidate_capacity_ = candidate_capacity;
+    head->correction_min_ = correction_min;
+    head->correction_max_ = correction_max;
+    ggml_init_params params = {
+        /*.mem_size   =*/ (tensor_records.size() + 1) * ggml_tensor_overhead() + 64 * 1024,
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    head->ctx_ = ggml_init(params);
+    if (!head->ctx_) {
+        return nullptr;
+    }
+
+    std::vector<tensor_load_record> loads;
+    loads.reserve(tensor_records.size());
+    uint64_t previous_end = 0;
+    for (size_t index = 0; index < tensor_records.size(); ++index) {
+        const auto & record = tensor_records.at(index);
+        const std::string name = record.at("name").get<std::string>();
+        const std::string digest = record.at("sha256").get<std::string>();
+        const std::vector<int64_t> shape = record.at("ggml_shape").get<std::vector<int64_t>>();
+        const uint64_t offset = record.at("offset").get<uint64_t>();
+        const uint64_t bytes = record.at("bytes").get<uint64_t>();
+        if (name.empty() || !is_sha256(digest) || shape.empty() || shape.size() > 4 ||
+            std::any_of(shape.begin(), shape.end(), [](int64_t value) { return value <= 0; }) ||
+            offset % 64 != 0 || offset < previous_end ||
+            bytes > weights_bytes || offset > weights_bytes - bytes) {
+            throw std::runtime_error("invalid Sequence Policy tensor record: " + name);
+        }
+        ggml_tensor * tensor = ggml_new_tensor(
+            head->ctx_, parse_type(record.at("dtype").get<std::string>()),
+            (int) shape.size(), shape.data());
+        if (ggml_nbytes(tensor) != bytes) {
+            throw std::runtime_error("Sequence Policy tensor byte mismatch: " + name);
+        }
+        if (!head->tensors_.emplace(name, tensor).second) {
+            throw std::runtime_error("duplicate Sequence Policy tensor: " + name);
+        }
+        const std::string runtime_name = "sequence_policy." + std::to_string(index);
+        ggml_set_name(tensor, runtime_name.c_str());
+        loads.push_back({tensor, offset, bytes});
+        previous_end = offset + bytes;
+    }
+    const auto require = [&](const std::string & name, ggml_type type,
+                             int64_t ne0, int64_t ne1) {
+        const auto found = head->tensors_.find(name);
+        if (found == head->tensors_.end() || found->second->type != type ||
+            found->second->ne[0] != ne0 || found->second->ne[1] != ne1) {
+            throw std::runtime_error("Sequence Policy missing or invalid tensor: " + name);
+        }
+    };
+    ggml_tensor * base_ids_i32 = nullptr;
+    if (dynamic) {
+        require("policy.left", GGML_TYPE_F32, hidden_size, rank);
+        require("policy.right", GGML_TYPE_F32, hidden_size, rank);
+        require("policy.static_ids", GGML_TYPE_I64, candidate_tokens, 1);
+    } else if (pca_multiclass) {
+        require("policy.base_ids", GGML_TYPE_I64, candidate_tokens, 1);
+        require("policy.hidden_mean", GGML_TYPE_F32, hidden_size, 1);
+        require("policy.pca_components", GGML_TYPE_F32, hidden_size, rank);
+        require("policy.classifier", GGML_TYPE_F32, rank, class_count);
+        require("policy.classifier_bias", GGML_TYPE_F32, class_count, 1);
+        require("policy.correction_strength", GGML_TYPE_F32, 1, 1);
+        base_ids_i32 = ggml_new_tensor_1d(
+            head->ctx_, GGML_TYPE_I32, candidate_tokens);
+        ggml_set_name(base_ids_i32, "sequence_policy.base_ids_i32");
+        head->tensors_.emplace("policy.base_ids_i32", base_ids_i32);
+    } else {
+        require("policy.weight", GGML_TYPE_F32, hidden_size, candidate_tokens);
+        require("policy.bias", GGML_TYPE_F32, candidate_tokens, 1);
+        require("policy.base_ids", GGML_TYPE_I64, candidate_tokens, 1);
+        base_ids_i32 = ggml_new_tensor_1d(
+            head->ctx_, GGML_TYPE_I32, candidate_tokens);
+        ggml_set_name(base_ids_i32, "sequence_policy.base_ids_i32");
+        head->tensors_.emplace("policy.base_ids_i32", base_ids_i32);
+    }
+
+    head->buffer_ = ggml_backend_alloc_ctx_tensors_from_buft(head->ctx_, buft);
+    if (!head->buffer_) {
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(head->buffer_, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    std::ifstream blob(weights_path, std::ios::binary);
+    if (!blob) {
+        throw std::runtime_error("cannot open Sequence Policy weights blob");
+    }
+    uint64_t max_bytes = 0;
+    for (const auto & record : loads) {
+        max_bytes = std::max(max_bytes, record.bytes);
+    }
+    if (max_bytes > (uint64_t) std::numeric_limits<size_t>::max()) {
+        throw std::runtime_error("Sequence Policy tensor exceeds addressable memory");
+    }
+    std::vector<uint8_t> scratch((size_t) max_bytes);
+    std::vector<int32_t> base_ids_i32_values;
+    for (const auto & record : loads) {
+        blob.seekg((std::streamoff) record.offset, std::ios::beg);
+        if (!blob.read(reinterpret_cast<char *>(scratch.data()), (std::streamsize) record.bytes)) {
+            throw std::runtime_error("failed to read Sequence Policy tensor from blob");
+        }
+        if (record.tensor->type == GGML_TYPE_F32) {
+            for (size_t offset = 0; offset < (size_t) record.bytes; offset += sizeof(float)) {
+                float value = 0.0f;
+                std::memcpy(&value, scratch.data() + offset, sizeof(value));
+                if (!std::isfinite(value)) {
+                    throw std::runtime_error("Sequence Policy contains a non-finite F32 value");
+                }
+            }
+        }
+        if (pca_multiclass &&
+            record.tensor == head->tensors_.at("policy.correction_strength")) {
+            float value = 0.0f;
+            std::memcpy(&value, scratch.data(), sizeof(value));
+            if (value != correction_strength) {
+                throw std::runtime_error(
+                    "Sequence Policy correction strength tensor does not match manifest");
+            }
+        }
+        ggml_backend_tensor_set(record.tensor, scratch.data(), 0, (size_t) record.bytes);
+        const bool is_ids = dynamic
+            ? record.tensor == head->tensors_.at("policy.static_ids")
+            : record.tensor == head->tensors_.at("policy.base_ids");
+        if (is_ids) {
+            base_ids_i32_values.resize((size_t) candidate_tokens);
+            head->static_token_ids_.resize(
+                (dynamic || pca_multiclass) ? (size_t) candidate_tokens : 0);
+            for (int index = 0; index < candidate_tokens; ++index) {
+                int64_t value = 0;
+                std::memcpy(
+                    &value,
+                    scratch.data() + (size_t) index * sizeof(int64_t),
+                    sizeof(value));
+                if (value < 0 || value >= base_vocab_size) {
+                    throw std::runtime_error("Sequence Policy base token ID out of range");
+                }
+                base_ids_i32_values[(size_t) index] = (int32_t) value;
+                if (dynamic || pca_multiclass) {
+                    head->static_token_ids_[(size_t) index] = value;
+                }
+            }
+        }
+    }
+    if (base_ids_i32_values.size() != (size_t) candidate_tokens) {
+        throw std::runtime_error("Sequence Policy base token IDs were not loaded");
+    }
+    if (pca_multiclass &&
+        !std::is_sorted(head->static_token_ids_.begin(), head->static_token_ids_.end())) {
+        throw std::runtime_error("Sequence Policy v3 token IDs must be strictly increasing");
+    }
+    if (pca_multiclass &&
+        std::adjacent_find(head->static_token_ids_.begin(),
+                           head->static_token_ids_.end()) != head->static_token_ids_.end()) {
+        throw std::runtime_error("Sequence Policy v3 token IDs must be unique");
+    }
+    if (!dynamic) {
+        ggml_backend_tensor_set(
+            base_ids_i32, base_ids_i32_values.data(), 0,
+            base_ids_i32_values.size() * sizeof(int32_t));
+    }
+    LLAMA_LOG_INFO(
+        "ColorLM Sequence Policy loaded: %s, %d tokens, rank=%d, %.3f MiB on %s\n",
+        dynamic ? "dynamic" : pca_multiclass ? "pca-multiclass-noop" : "static",
+        dynamic ? candidate_capacity : candidate_tokens,
+        rank,
+        ggml_backend_buffer_get_size(head->buffer_) / 1024.0 / 1024.0,
+        ggml_backend_buffer_name(head->buffer_));
+    return head;
+}
+
+llama_neural_policy_head::~llama_neural_policy_head() {
+    if (buffer_) {
+        ggml_backend_buffer_free(buffer_);
+    }
+    if (ctx_) {
+        ggml_free(ctx_);
+    }
+}
+
+ggml_tensor * llama_neural_policy_head::weight() const { return tensors_.at("policy.weight"); }
+ggml_tensor * llama_neural_policy_head::bias() const { return tensors_.at("policy.bias"); }
+ggml_tensor * llama_neural_policy_head::base_ids() const { return tensors_.at("policy.base_ids"); }
