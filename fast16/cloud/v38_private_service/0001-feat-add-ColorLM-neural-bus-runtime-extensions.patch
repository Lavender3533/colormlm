+static void q35_trace_neural_bus_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data) {
+        return;
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+    if (src->type != GGML_TYPE_F32 || g_q35_neural_bus_trace_count.fetch_add(1) >= 8) {
+        return;
+    }
+    const float * values = (const float *) src->data;
+    const size_t count = ggml_nelements(src);
+    double sum_sq = 0.0;
+    float max_abs = 0.0f;
+    for (size_t i = 0; i < count; ++i) {
+        sum_sq += (double) values[i] * values[i];
+        max_abs = std::max(max_abs, std::fabs(values[i]));
+    }
+    LLAMA_LOG_INFO(
+        "ColorLM Neural Bus trace: layer=%d rms=%.8f max_abs=%.8f elements=%zu\n",
+        (int) (uintptr_t) userdata, std::sqrt(sum_sq / std::max<size_t>(count, 1)), max_abs, count);
+}
+
+static void q35_trace_k3_macro_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data) {
+        return;
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+    if (src->type != GGML_TYPE_F32 || g_q35_k3_macro_trace_count.fetch_add(1) >= 32) {
+        return;
+    }
+    const float * values = (const float *) src->data;
+    const size_t count = ggml_nelements(src);
+    double sum_sq = 0.0;
+    float max_abs = 0.0f;
+    for (size_t i = 0; i < count; ++i) {
+        sum_sq += (double) values[i] * values[i];
+        max_abs = std::max(max_abs, std::fabs(values[i]));
+    }
+    const uintptr_t trace_id = (uintptr_t) userdata;
+    const unsigned stage_id = (unsigned) (trace_id >> 16);
+    const char * stage = stage_id == 1 ? "raw" : stage_id == 2 ? "gate" : "applied";
+    LLAMA_LOG_INFO(
+        "ColorLM K3 trace: layer=%d stage=%s rms=%.8f max_abs=%.8f elements=%zu\n",
+        (int) (trace_id & 0xffffu), stage,
+        std::sqrt(sum_sq / std::max<size_t>(count, 1)), max_abs, count);
+}
+
+static void q35_trace_k3_route_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data) {
+        return;
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+    if (src->type != GGML_TYPE_F32 || g_q35_k3_route_trace_count.fetch_add(1) >= 48) {
+        return;
+    }
+    const float * values = (const float *) src->data;
+    const size_t count = ggml_nelements(src);
+    double sum = 0.0;
+    for (size_t i = 0; i < count; ++i) {
+        sum += values[i];
+    }
+    const uintptr_t trace_id = (uintptr_t) userdata;
+    LLAMA_LOG_INFO(
+        "ColorLM K3 route: layer=%d candidate=%d share=%.6f tokens=%zu\n",
+        (int) (trace_id & 0xffu), (int) ((trace_id >> 8) & 0xffu) - 1,
+        sum / std::max<size_t>(count, 1), count);
+}
+
+static void q35_trace_neural_bus_route_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data) {
+        return;
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+    if (src->type != GGML_TYPE_F32 || g_q35_neural_bus_route_trace_count.fetch_add(1) >= 16) {
+        return;
+    }
+    const float * values = (const float *) src->data;
+    const size_t count = ggml_nelements(src);
+    double primary = 0.0;
+    for (size_t i = 0; i < count; ++i) {
+        primary += values[i];
+    }
+    const uintptr_t trace_id = (uintptr_t) userdata;
+    const bool active_mask = (trace_id & 0x10000u) != 0;
+    LLAMA_LOG_INFO(
+        "ColorLM Neural Bus route: layer=%d %s=%.6f tokens=%zu\n",
+        (int) (trace_id & 0xffffu), active_mask ? "active_share" : "primary_share",
+        primary / std::max<size_t>(count, 1), count);
+}
+
+static void q35_trace_intelligence_route_cb(
+        ggml_tensor * dst,
+        const ggml_tensor * src,
+        int ith,
+        int,
+        void * userdata) {
+    if (ith != 0 || !dst || !src || !dst->data || !src->data) {
+        return;
+    }
+    std::memcpy(dst->data, src->data, ggml_nbytes(src));
+    if (src->type != GGML_TYPE_F32 ||
+        g_q35_intelligence_trace_count.fetch_add(1) >= 96) {
+        return;
+    }
+    if (src->ne[0] != 3) {
+        return;
+    }
+    const float * values = (const float *) src->data;
+    const size_t tokens = ggml_nelements(src) / 3;
+    const char * names[3] = {"no_op", "coder", "k3"};
+    for (int route = 0; route < 3; ++route) {
+        double sum = 0.0;
+        for (size_t token = 0; token < tokens; ++token) {
+            sum += values[token * 3 + route];
+        }
+        LLAMA_LOG_INFO(
+            "ColorLM Intelligence route: layer=%d route=%s share=%.6f tokens=%zu\n",
+            (int) (uintptr_t) userdata, names[route],
+            sum / std::max<size_t>(tokens, 1), tokens);
+    }
+}
