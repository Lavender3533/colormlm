diff --git a/common/debug.cpp b/common/debug.cpp
index 102c692..3746189 100644
--- a/common/debug.cpp
+++ b/common/debug.cpp
@@ -3,7 +3,17 @@
 #include "common.h"
 #include "log.h"
 
+#include <atomic>
+#include <cerrno>
+#include <charconv>
 #include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <mutex>
 #include <regex>
 #include <string>
 #include <vector>
@@ -188,3 +198,206 @@ bool common_debug_cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
 
     return true;
 }
+
+#pragma pack(push, 1)
+struct common_activation_dump_header {
+    uint32_t magic;
+    uint32_t version;
+    int32_t  layer;
+    uint32_t tensor_type;
+    int64_t  ne[GGML_MAX_DIMS];
+    uint64_t payload_bytes;
+};
+#pragma pack(pop)
+
+static_assert(sizeof(common_activation_dump_header) == 56, "CLM9 v1 header layout drift");
+
+struct common_activation_dump_cb_user_data::impl {
+    std::ofstream output;
+    std::string path;
+    std::string tensor_name;
+    std::vector<uint8_t> data;
+    std::mutex output_mutex;
+    std::atomic<uint32_t> records{0};
+    std::atomic<bool> failed{false};
+    std::atomic<bool> warned_layout{false};
+    uint32_t max_records = 0;
+    int32_t layer = -1;
+    bool enabled = false;
+};
+
+static bool common_activation_dump_parse_layer(const std::string & tensor_name, int32_t & layer) {
+    const size_t dash = tensor_name.rfind('-');
+    if (dash == std::string::npos || dash + 1 == tensor_name.size()) {
+        return false;
+    }
+
+    int32_t parsed = -1;
+    const char * begin = tensor_name.data() + dash + 1;
+    const char * end = tensor_name.data() + tensor_name.size();
+    const auto result = std::from_chars(begin, end, parsed);
+    if (result.ec != std::errc{} || result.ptr != end || parsed < 0) {
+        return false;
+    }
+    layer = parsed;
+    return true;
+}
+
+static bool common_activation_dump_cb_eval(struct ggml_tensor * t, bool ask, void * user_data) {
+    auto * cb_data = static_cast<common_activation_dump_cb_user_data *>(user_data);
+    auto * pimpl = cb_data->pimpl.get();
+
+    const bool matches = t != nullptr && pimpl->tensor_name == t->name;
+    if (ask) {
+        return matches &&
+            !pimpl->failed.load(std::memory_order_relaxed) &&
+            pimpl->records.load(std::memory_order_relaxed) < pimpl->max_records;
+    }
+    if (!matches || pimpl->failed.load(std::memory_order_relaxed)) {
+        return true;
+    }
+
+    std::lock_guard<std::mutex> lock(pimpl->output_mutex);
+    if (pimpl->records.load(std::memory_order_relaxed) >= pimpl->max_records) {
+        return true;
+    }
+
+    const size_t payload_bytes = ggml_nelements(t) * sizeof(float);
+    if (t->type != GGML_TYPE_F32 || !ggml_is_contiguous(t) || ggml_nbytes(t) != payload_bytes) {
+        if (!pimpl->warned_layout.exchange(true)) {
+            LOG_ERR(
+                "activation dump: tensor '%s' must be contiguous F32 (type=%s, bytes=%zu, expected=%zu)\n",
+                t->name, ggml_type_name(t->type), ggml_nbytes(t), payload_bytes);
+        }
+        return true;
+    }
+
+    const bool is_host = t->buffer != nullptr && ggml_backend_buffer_is_host(t->buffer);
+    const uint8_t * payload = nullptr;
+    if (is_host) {
+        payload = static_cast<const uint8_t *>(t->data);
+    } else {
+        pimpl->data.resize(payload_bytes);
+        ggml_backend_tensor_get(t, pimpl->data.data(), 0, payload_bytes);
+        payload = pimpl->data.data();
+    }
+    if (payload == nullptr) {
+        LOG_ERR("activation dump: tensor '%s' has no readable data\n", t->name);
+        pimpl->failed.store(true, std::memory_order_relaxed);
+        return true;
+    }
+
+    const common_activation_dump_header header = {
+        0x394d4c43u, // "CLM9" in little endian
+        1u,
+        pimpl->layer,
+        static_cast<uint32_t>(t->type),
+        {t->ne[0], t->ne[1], t->ne[2], t->ne[3]},
+        static_cast<uint64_t>(payload_bytes),
+    };
+    pimpl->output.write(reinterpret_cast<const char *>(&header), sizeof(header));
+    pimpl->output.write(reinterpret_cast<const char *>(payload), static_cast<std::streamsize>(payload_bytes));
+    pimpl->output.flush();
+    if (!pimpl->output) {
+        LOG_ERR("activation dump: failed writing CLM9 record to '%s'\n", pimpl->path.c_str());
+        pimpl->failed.store(true, std::memory_order_relaxed);
+        return true;
+    }
+
+    pimpl->records.fetch_add(1, std::memory_order_relaxed);
+    return true;
+}
+
+common_activation_dump_cb_user_data::common_activation_dump_cb_user_data(
+        common_params & params,
+        const std::string & path,
+        const std::string & tensor_name,
+        uint32_t max_records)
+    : pimpl(std::make_unique<impl>()) {
+    pimpl->path = path;
+    pimpl->tensor_name = tensor_name;
+    pimpl->max_records = max_records;
+
+    if (!common_activation_dump_parse_layer(tensor_name, pimpl->layer)) {
+        LOG_ERR("activation dump: target tensor must end in a non-negative layer number: '%s'\n", tensor_name.c_str());
+        return;
+    }
+
+    const std::filesystem::path output_path = std::filesystem::u8path(path);
+    std::error_code error;
+    if (!output_path.parent_path().empty()) {
+        std::filesystem::create_directories(output_path.parent_path(), error);
+    }
+    if (error) {
+        LOG_ERR("activation dump: cannot create output directory for '%s': %s\n", path.c_str(), error.message().c_str());
+        return;
+    }
+
+    pimpl->output.open(output_path, std::ios::binary | std::ios::out | std::ios::trunc);
+    if (!pimpl->output) {
+        LOG_ERR("activation dump: cannot open '%s'\n", path.c_str());
+        return;
+    }
+
+    params.cb_eval = common_activation_dump_cb_eval;
+    params.cb_eval_user_data = this;
+    pimpl->enabled = true;
+    LOG_INF(
+        "activation dump: enabled exact tensor '%s' -> '%s' (max records: %u)\n",
+        tensor_name.c_str(), path.c_str(), max_records);
+}
+
+common_activation_dump_cb_user_data::~common_activation_dump_cb_user_data() = default;
+
+bool common_activation_dump_cb_user_data::enabled() const {
+    return pimpl->enabled;
+}
+
+std::unique_ptr<common_activation_dump_cb_user_data> common_activation_dump_init_from_env(common_params & params) {
+    const char * raw_path = std::getenv("COLORLM_ACTIVATION_DUMP");
+    const char * raw_tensor = std::getenv("COLORLM_ACTIVATION_TENSOR");
+    const bool has_path = raw_path != nullptr && raw_path[0] != '\0';
+    const bool has_tensor = raw_tensor != nullptr && raw_tensor[0] != '\0';
+
+    if (!has_path && !has_tensor) {
+        return nullptr;
+    }
+    if (!has_path || !has_tensor) {
+        LOG_ERR("activation dump: COLORLM_ACTIVATION_DUMP and COLORLM_ACTIVATION_TENSOR must be set together\n");
+        return nullptr;
+    }
+    if (params.cb_eval != nullptr) {
+        LOG_ERR("activation dump: an eval callback is already configured; refusing to replace it\n");
+        return nullptr;
+    }
+
+    std::string tensor_name(raw_tensor);
+    if (tensor_name.size() >= 2 && tensor_name.front() == '^' && tensor_name.back() == '$') {
+        tensor_name = tensor_name.substr(1, tensor_name.size() - 2);
+    }
+    if (tensor_name.empty()) {
+        LOG_ERR("activation dump: COLORLM_ACTIVATION_TENSOR is empty after removing optional ^...$ anchors\n");
+        return nullptr;
+    }
+
+    uint32_t max_records = 96;
+    const char * raw_max_records = std::getenv("COLORLM_ACTIVATION_DUMP_MAX_RECORDS");
+    if (raw_max_records != nullptr && raw_max_records[0] != '\0') {
+        errno = 0;
+        char * end = nullptr;
+        const unsigned long long parsed = std::strtoull(raw_max_records, &end, 10);
+        if (errno != 0 || end == raw_max_records || *end != '\0' || raw_max_records[0] == '-' ||
+            parsed == 0 || parsed > std::numeric_limits<uint32_t>::max()) {
+            LOG_ERR("activation dump: invalid COLORLM_ACTIVATION_DUMP_MAX_RECORDS='%s'\n", raw_max_records);
+            return nullptr;
+        }
+        max_records = static_cast<uint32_t>(parsed);
+    }
+
+    auto result = std::make_unique<common_activation_dump_cb_user_data>(
+        params, raw_path, tensor_name, max_records);
+    if (!result->enabled()) {
+        return nullptr;
+    }
+    return result;
+}
