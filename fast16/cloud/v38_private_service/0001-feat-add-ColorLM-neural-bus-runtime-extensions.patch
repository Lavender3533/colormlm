+
+        auto t0 = clk::now();
+        for (int i = 0; i < n_iters; i++) {
+            ggml_backend_graph_compute(backend, gf);
+            ggml_backend_synchronize(backend);
+        }
+        double total = now_ms(t0);
+        printf("  total %.2f ms  | per-iter %.3f ms\n", total, total / n_iters);
+    }
+
+    // ── Test F: pure upload latency (sync per iter) ─────
+    // Upload one weight + sync, no compute. Tells us pure PCIe cost.
+    {
+        printf("\n[Test F] upload-only: sync after each upload (no compute)\n");
+        auto t0 = clk::now();
+        for (int i = 0; i < n_iters; i++) {
+            int cur = i % n_layers;
+            ggml_backend_tensor_set(layers[cur].w,
+                                    layers[cur].w_host.data(), 0, bytes_per_w);
+            ggml_backend_synchronize(backend);
+        }
+        double total = now_ms(t0);
+        double bw = (n_iters * bytes_per_w) / (total / 1000.0) / (1024.0 * 1024.0 * 1024.0);
+        printf("  total %.2f ms  | per-iter %.3f ms  | %.2f GB/s\n",
+               total, total / n_iters, bw);
+    }
+
+    // Summary so we don't have to do mental math
+    printf("\n=== Summary ===\n");
+    printf("If E (compute only) + F (upload only) > D (serial both), then transfer\n");
+    printf("and compute ARE somewhat overlapped already in D. If ≈, fully serialized.\n");
+    printf("If C (async) > D (sync), async path is broken on this backend.\n");
+
+    ggml_backend_buffer_free(buf);
+    ggml_backend_free(backend);
+    printf("\nDone.\n");
+    return 0;
+}
