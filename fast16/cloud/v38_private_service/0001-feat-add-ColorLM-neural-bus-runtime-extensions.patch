+
+static ggml_tensor * q35_build_exact_slot_moe(
+        ggml_context * ctx0,
+        ggml_cgraph * gf,
+        slot_pool * pool,
+        int il,
+        int64_t n_expert,
+        int64_t n_expert_used,
+        float weight_scale,
+        ggml_tensor * cur,
+        ggml_tensor * router_logits) {
+    const int64_t n_embd = cur->ne[0];
+    const int64_t n_tokens = cur->ne[1];
+
+    ggml_tensor * probs = ggml_soft_max(ctx0, router_logits);
+    ggml_tensor * selected = ggml_cont(ctx0, ggml_argsort_top_k(ctx0, probs, n_expert_used));
+    selected = ggml_map_custom1(
+        ctx0, selected, q35_stage_selected_experts_cb, 1, (void *) (uintptr_t) il);
+
+    probs = ggml_reshape_3d(ctx0, probs, 1, n_expert, n_tokens);
+    ggml_tensor * weights = ggml_get_rows(ctx0, probs, selected);
+    weights = ggml_reshape_2d(ctx0, weights, n_expert_used, n_tokens);
+    ggml_tensor * weights_sum = ggml_sum_rows(ctx0, weights);
+    weights_sum = ggml_clamp(ctx0, weights_sum, 6.103515625e-5f, INFINITY);
+    weights = ggml_div(ctx0, weights, weights_sum);
+    if (weight_scale != 0.0f && weight_scale != 1.0f) {
+        weights = ggml_scale(ctx0, weights, weight_scale);
+    }
+    weights = ggml_reshape_3d(ctx0, weights, 1, n_expert_used, n_tokens);
+    ggml_build_forward_expand(gf, weights);
+
+    ggml_tensor * selected_flat = ggml_view_1d(ctx0, selected, n_expert_used * n_tokens, 0);
+    ggml_tensor * remapped_flat = ggml_get_rows(ctx0, pool->lut_gpu((uint32_t) il), selected_flat);
+    ggml_tensor * remapped = ggml_reshape_2d(ctx0, remapped_flat, n_expert_used, n_tokens);
+    cur = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+
+    ggml_tensor * up = ggml_mul_mat_id(ctx0, pool->up((uint32_t) il), cur, remapped);
+    ggml_tensor * gate = ggml_mul_mat_id(ctx0, pool->gate((uint32_t) il), cur, remapped);
+    cur = ggml_swiglu_split(ctx0, gate, up);
+    ggml_tensor * experts = ggml_mul_mat_id(ctx0, pool->down((uint32_t) il), cur, remapped);
+    experts = ggml_mul(ctx0, experts, weights);
+    ggml_build_forward_expand(gf, experts);
+
+    ggml_tensor * result = nullptr;
+    for (int64_t k = 0; k < n_expert_used; ++k) {
+        ggml_tensor * expert = ggml_view_2d(
+            ctx0, experts, n_embd, n_tokens, experts->nb[2], k * experts->nb[1]);
+        result = result ? ggml_add(ctx0, result, expert) : expert;
+    }
+    if (n_expert_used == 1) {
+        result = ggml_cont(ctx0, result);
+    }
+    return result;
+}
