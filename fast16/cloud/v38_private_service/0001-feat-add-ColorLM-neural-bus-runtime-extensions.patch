+        double per_iter = total / n_iters;
+        double bw_gbs = (n_iters * bytes_per_w) / (total / 1000.0) / (1024.0 * 1024.0 * 1024.0);
+        printf("  total %.2f ms  | per-iter %.3f ms  | upload-equiv BW %.2f GB/s\n",
+               total, per_iter, bw_gbs);
+    }
+
+    // ── Test D: serial_no_overlap (baseline for C) ──────
+    // Same as C but explicit sync between upload and compute (no overlap possible)
+    {
+        printf("\n[Test D] serial: upload then compute then sync (no overlap)\n");
+
+        std::vector<ggml_context_ptr> gctxs;
+        std::vector<ggml_cgraph *> graphs;
+        for (int l = 0; l < n_layers; l++) {
+            size_t graph_mem = ggml_tensor_overhead() * 8 + ggml_graph_overhead();
+            ggml_init_params gp = { graph_mem, NULL, true };
+            gctxs.emplace_back(ggml_init(gp));
