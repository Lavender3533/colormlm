+static bool q35_hidden_dump_enabled_at(int il) {
+    const char * raw_path = std::getenv("COLORLM_HIDDEN_DUMP");
+    if (!raw_path || raw_path[0] == '\0') {
+        return false;
+    }
+
+    const char * raw_sites = std::getenv("COLORLM_HIDDEN_DUMP_SITES");
+    std::stringstream stream(raw_sites ? raw_sites : "12,28,39");
+    std::string item;
+    while (std::getline(stream, item, ',')) {
+        if (!item.empty() && std::stoi(item) == il) {
+            return true;
+        }
+    }
+    return false;
+}
