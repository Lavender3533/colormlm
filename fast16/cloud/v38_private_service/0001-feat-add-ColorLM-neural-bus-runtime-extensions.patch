+bool llama_memory_recurrent::colorlm_semantic_consolidate(llama_seq_id seq_id, float rate) {
+    if (!colorlm_semantic || !std::isfinite(rate) || rate <= 0.0f || rate > 1.0f ||
+            seq_id < 0 || (uint32_t) seq_id >= n_seq_max) {
+        return false;
+    }
+
+    const int32_t tail = cells[seq_id].tail;
+    if (tail < 0) {
+        return false;
+    }
+
+    size_t n_layers = 0;
+    for (uint32_t il = 0; il < hparams.n_layer; ++il) {
+        ggml_tensor * semantic = semantic_s_l[il];
+        ggml_tensor * working = s_l[il];
+        if (semantic == nullptr) {
+            continue;
+        }
+        if (semantic->type != GGML_TYPE_F32 || working->type != GGML_TYPE_F32) {
+            LLAMA_LOG_ERROR("%s: ColorLM semantic state requires F32 recurrent state\n", __func__);
+            return false;
+        }
+
+        const size_t row_size = ggml_row_size(working->type, hparams.n_embd_s());
+        std::vector<float> current(row_size / sizeof(float));
+        ggml_backend_tensor_get(working, current.data(), tail * row_size, row_size);
+
+        auto & slow = semantic_host[il];
+        GGML_ASSERT(slow.size() == current.size());
+        for (size_t i = 0; i < slow.size(); ++i) {
+            slow[i] += rate * (current[i] - slow[i]);
+        }
+        ggml_backend_tensor_set(semantic, slow.data(), 0, row_size);
+        ++n_layers;
+    }
+
+    if (n_layers == 0 || !semantic_save()) {
+        return false;
+    }
+    LLAMA_LOG_INFO("%s: consolidated %zu ColorLM semantic layers at rate %.3f\n", __func__, n_layers, rate);
+    return true;
+}
+
+bool llama_memory_recurrent::colorlm_semantic_clear() {
+    if (!colorlm_semantic) {
+        return false;
+    }
+    for (uint32_t il = 0; il < hparams.n_layer; ++il) {
+        if (semantic_s_l[il] != nullptr) {
+            std::fill(semantic_host[il].begin(), semantic_host[il].end(), 0.0f);
+        }
+    }
+    semantic_restore_device();
+    return semantic_save();
+}
+
+void llama_memory_recurrent::semantic_restore_device() {
+    if (!colorlm_semantic) {
+        return;
+    }
+    for (uint32_t il = 0; il < hparams.n_layer; ++il) {
+        if (semantic_s_l[il] != nullptr) {
+            ggml_backend_tensor_set(
+                semantic_s_l[il], semantic_host[il].data(), 0, semantic_host[il].size() * sizeof(float));
+        }
+    }
+}
+
+bool llama_memory_recurrent::semantic_save() const {
+    if (semantic_path.empty()) {
+        LLAMA_LOG_ERROR("%s: COLORLM_V4_SEMANTIC_PATH is not set\n", __func__);
+        return false;
+    }
+
+    const auto path = std::filesystem::u8path(semantic_path);
+    const auto tmp = std::filesystem::path(path.string() + ".tmp");
+    std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+    if (!out) {
+        return false;
+    }
+
+    const uint32_t magic = 0x344d4c43; // CLM4
+    const uint32_t version = 1;
+    const uint32_t n_layer = hparams.n_layer;
+    const uint32_t n_embd = hparams.n_embd;
+    const uint32_t n_embd_s = hparams.n_embd_s();
+    const uint32_t count = (uint32_t) std::count_if(
+        semantic_s_l.begin(), semantic_s_l.end(), [](const ggml_tensor * t) { return t != nullptr; });
+    out.write(reinterpret_cast<const char *>(&magic), sizeof(magic));
+    out.write(reinterpret_cast<const char *>(&version), sizeof(version));
+    out.write(reinterpret_cast<const char *>(&n_layer), sizeof(n_layer));
+    out.write(reinterpret_cast<const char *>(&n_embd), sizeof(n_embd));
+    out.write(reinterpret_cast<const char *>(&n_embd_s), sizeof(n_embd_s));
+    out.write(reinterpret_cast<const char *>(&count), sizeof(count));
+    for (uint32_t il = 0; il < hparams.n_layer; ++il) {
+        if (semantic_s_l[il] == nullptr) {
+            continue;
+        }
+        const uint64_t byte_size = semantic_host[il].size() * sizeof(float);
+        out.write(reinterpret_cast<const char *>(&il), sizeof(il));
+        out.write(reinterpret_cast<const char *>(&byte_size), sizeof(byte_size));
+        out.write(reinterpret_cast<const char *>(semantic_host[il].data()), byte_size);
+    }
+    out.close();
+    if (!out) {
+        return false;
+    }
+
+    std::error_code error;
+    std::filesystem::remove(path, error);
+    error.clear();
+    std::filesystem::rename(tmp, path, error);
+    return !error;
+}
+
+bool llama_memory_recurrent::semantic_load() {
+    std::ifstream in(std::filesystem::u8path(semantic_path), std::ios::binary);
+    if (!in) {
+        return false;
+    }
+
+    uint32_t magic;
+    uint32_t version;
+    uint32_t n_layer;
+    uint32_t n_embd;
+    uint32_t n_embd_s;
+    uint32_t count;
+    in.read(reinterpret_cast<char *>(&magic), sizeof(magic));
+    in.read(reinterpret_cast<char *>(&version), sizeof(version));
+    in.read(reinterpret_cast<char *>(&n_layer), sizeof(n_layer));
+    in.read(reinterpret_cast<char *>(&n_embd), sizeof(n_embd));
+    in.read(reinterpret_cast<char *>(&n_embd_s), sizeof(n_embd_s));
+    in.read(reinterpret_cast<char *>(&count), sizeof(count));
+    if (!in || magic != 0x344d4c43 || version != 1 || n_layer != hparams.n_layer ||
+            n_embd != hparams.n_embd || n_embd_s != hparams.n_embd_s()) {
+        return false;
+    }
+
+    std::vector<bool> loaded(hparams.n_layer, false);
+    for (uint32_t i = 0; i < count; ++i) {
+        uint32_t il;
+        uint64_t byte_size;
+        in.read(reinterpret_cast<char *>(&il), sizeof(il));
+        in.read(reinterpret_cast<char *>(&byte_size), sizeof(byte_size));
+        if (!in || il >= hparams.n_layer || semantic_s_l[il] == nullptr ||
+                byte_size != semantic_host[il].size() * sizeof(float) || loaded[il]) {
+            return false;
+        }
+        in.read(reinterpret_cast<char *>(semantic_host[il].data()), byte_size);
+        if (!in) {
+            return false;
+        }
+        loaded[il] = true;
+    }
+    const uint32_t expected = (uint32_t) std::count_if(
+        semantic_s_l.begin(), semantic_s_l.end(), [](const ggml_tensor * t) { return t != nullptr; });
+    if (count != expected) {
+        return false;
+    }
+    semantic_restore_device();
+    return true;
+}
+
+bool llama_memory_recurrent::plastic_create() {
+    if (plastic_rank == 0 || plastic_a == nullptr || plastic_b == nullptr || plastic_path.empty()) {
+        return false;
+    }
+
+    const uint64_t a_count = (uint64_t) hparams.n_embd * plastic_rank;
+    const uint64_t b_count = (uint64_t) plastic_rank * plastic_n_vocab;
+    std::vector<float> a(a_count);
+    std::vector<uint16_t> b(b_count, 0);
+
+    // Deterministic normalized random projection. It is fixed after creation;
+    // learning changes only B through local next-token prediction error.
+    uint32_t rng = 0xc01a4f17u;
+    for (uint32_t r = 0; r < plastic_rank; ++r) {
+        double norm2 = 0.0;
+        float * row = a.data() + (uint64_t) r * hparams.n_embd;
+        for (uint32_t i = 0; i < hparams.n_embd; ++i) {
+            rng ^= rng << 13;
+            rng ^= rng >> 17;
+            rng ^= rng << 5;
+            row[i] = ((int32_t) (rng & 0x00ffffffu) - 0x00800000) / 8388608.0f;
+            norm2 += (double) row[i] * row[i];
+        }
+        const float inv_norm = 1.0f / std::sqrt((float) std::max(norm2, 1e-20));
+        for (uint32_t i = 0; i < hparams.n_embd; ++i) {
+            row[i] *= inv_norm;
+        }
     }
+
+    const uint32_t magic = 0x34504c43; // CLP4
+    const uint32_t version = 1;
+    const uint32_t reserved = 0;
+    const auto path = std::filesystem::u8path(plastic_path);
+    const auto tmp = std::filesystem::path(path.string() + ".tmp");
+    std::ofstream out(tmp, std::ios::binary | std::ios::trunc);
+    if (!out) {
+        return false;
+    }
+    out.write(reinterpret_cast<const char *>(&magic), sizeof(magic));
+    out.write(reinterpret_cast<const char *>(&version), sizeof(version));
+    out.write(reinterpret_cast<const char *>(&hparams.n_embd), sizeof(uint32_t));
+    out.write(reinterpret_cast<const char *>(&plastic_n_vocab), sizeof(plastic_n_vocab));
+    out.write(reinterpret_cast<const char *>(&plastic_rank), sizeof(plastic_rank));
+    out.write(reinterpret_cast<const char *>(&reserved), sizeof(reserved));
+    out.write(reinterpret_cast<const char *>(&a_count), sizeof(a_count));
+    out.write(reinterpret_cast<const char *>(&b_count), sizeof(b_count));
+    out.write(reinterpret_cast<const char *>(a.data()), a.size() * sizeof(float));
+    out.write(reinterpret_cast<const char *>(b.data()), b.size() * sizeof(uint16_t));
+    out.close();
+    if (!out) {
+        return false;
+    }
+
+    std::error_code error;
+    std::filesystem::remove(path, error);
+    error.clear();
+    std::filesystem::rename(tmp, path, error);
+    if (error) {
+        return false;
+    }
+
+    ggml_backend_tensor_set(plastic_a, a.data(), 0, a.size() * sizeof(float));
+    ggml_backend_tensor_set(plastic_b, b.data(), 0, b.size() * sizeof(uint16_t));
+    return true;
+}
+
+bool llama_memory_recurrent::plastic_load() {
+    if (plastic_rank == 0 || plastic_a == nullptr || plastic_b == nullptr || plastic_path.empty()) {
+        return false;
+    }
+
+    std::ifstream in(std::filesystem::u8path(plastic_path), std::ios::binary);
+    if (!in) {
+        return false;
+    }
+    uint32_t magic;
+    uint32_t version;
+    uint32_t n_embd;
+    uint32_t n_vocab;
+    uint32_t rank;
+    uint32_t reserved;
+    uint64_t a_count;
+    uint64_t b_count;
+    in.read(reinterpret_cast<char *>(&magic), sizeof(magic));
+    in.read(reinterpret_cast<char *>(&version), sizeof(version));
+    in.read(reinterpret_cast<char *>(&n_embd), sizeof(n_embd));
+    in.read(reinterpret_cast<char *>(&n_vocab), sizeof(n_vocab));
+    in.read(reinterpret_cast<char *>(&rank), sizeof(rank));
+    in.read(reinterpret_cast<char *>(&reserved), sizeof(reserved));
+    in.read(reinterpret_cast<char *>(&a_count), sizeof(a_count));
+    in.read(reinterpret_cast<char *>(&b_count), sizeof(b_count));
+    if (!in || magic != 0x34504c43 || version != 1 || n_embd != hparams.n_embd ||
+            n_vocab != plastic_n_vocab || rank != plastic_rank ||
+            a_count != (uint64_t) hparams.n_embd * plastic_rank ||
+            b_count != (uint64_t) plastic_rank * plastic_n_vocab) {
+        return false;
+    }
+
+    std::vector<float> a(a_count);
+    std::vector<uint16_t> b(b_count);
+    in.read(reinterpret_cast<char *>(a.data()), a.size() * sizeof(float));
+    in.read(reinterpret_cast<char *>(b.data()), b.size() * sizeof(uint16_t));
+    if (!in) {
+        return false;
+    }
+    ggml_backend_tensor_set(plastic_a, a.data(), 0, a.size() * sizeof(float));
+    ggml_backend_tensor_set(plastic_b, b.data(), 0, b.size() * sizeof(uint16_t));
+    return true;
+}
+
+bool llama_memory_recurrent::colorlm_plastic_reload() {
+    return colorlm_semantic && plastic_load();
 }
 
