+set(TARGET llama-collector)
+add_executable(${TARGET} collector.cpp)
+
+# Link the Rust MoE scheduler staticlib.
+# Built separately by `cargo build --release -p moe_scheduler_c` from
+# D:/project/大模型ssd化/scheduler/.
+set(MOE_SCHEDULER_DIR "${CMAKE_SOURCE_DIR}/../scheduler")
+set(MOE_SCHEDULER_LIB "${MOE_SCHEDULER_DIR}/target/release/moe_scheduler_c.lib")
+set(MOE_SCHEDULER_INCLUDE "${MOE_SCHEDULER_DIR}/moe_scheduler_c/include")
+
+if(EXISTS "${MOE_SCHEDULER_LIB}")
+    message(STATUS "MoE scheduler lib found: ${MOE_SCHEDULER_LIB}")
+    target_compile_definitions(${TARGET} PRIVATE MOE_SCHEDULER_AVAILABLE=1)
+    target_include_directories(${TARGET} PRIVATE "${MOE_SCHEDULER_INCLUDE}")
+    target_link_libraries(${TARGET} PRIVATE
+        "${MOE_SCHEDULER_LIB}"
+        # Windows system libs that Rust staticlibs typically need
+        ws2_32 userenv bcrypt ntdll advapi32
+    )
+else()
+    message(WARNING "MoE scheduler lib NOT found at ${MOE_SCHEDULER_LIB}; building without scheduler integration")
+endif()
+
+target_link_libraries(${TARGET} PRIVATE llama-common llama ${CMAKE_THREAD_LIBS_INIT})
+target_compile_features(${TARGET} PRIVATE cxx_std_17)
diff --git a/tools/collector/collector.cpp b/tools/collector/collector.cpp
new file mode 100644
index 0000000..0f1dde2
--- /dev/null
+++ b/tools/collector/collector.cpp
@@ -0,0 +1,338 @@
+// MoE Router activation collector
+//
+// Hooks into llama.cpp's `cb_eval` mechanism to capture every (layer, token)
+// router output: which top-k experts were selected and their weights.
+//
+// Output: a sequence of `ActivationRecord` (112 bytes each) written to a
+// binary file. Format must match the Rust `predictor::ActivationRecord`.
+//
+// Usage:
+//     llama-collector -m model.gguf -p "your prompt" -n 16 [-o activations.bin]
+
+#include "arg.h"
+#include "common.h"
+#include "log.h"
+#include "llama.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <string>
+#include <vector>
+
+#ifdef MOE_SCHEDULER_AVAILABLE
+#include "moe_scheduler.h"
+#endif
+
+#pragma pack(push, 1)
+struct ActivationRecord {
+    uint64_t timestamp_ns;
+    uint32_t token_idx;
+    uint16_t layer;
+    uint8_t  n_experts_used;
+    uint8_t  _padding;
+    uint16_t expert_ids[16];
+    float    expert_weights[16];
+};
+#pragma pack(pop)
+static_assert(sizeof(ActivationRecord) == 112, "ActivationRecord layout drift");
+
+struct PendingTopK {
+    bool has_data = false;
+    int n_used = 0;
+    int n_tokens = 0;
+    size_t stride1 = 0;  // elements between consecutive tokens
+    std::vector<int32_t> ids;  // raw buffer, may include stride padding
+};
+
+struct CollectorContext {
+    std::ofstream out;
+    uint32_t base_token_idx = 0;
+    std::vector<PendingTopK> pending;  // indexed by layer
+    std::atomic<uint64_t> records{0};
+    bool verbose = false;
+
+#ifdef MOE_SCHEDULER_AVAILABLE
+    MoeScheduler* scheduler = nullptr;
+    std::atomic<uint64_t> sched_prefetches{0};
+    std::atomic<uint64_t> sched_evictions{0};
+#endif
+};
+
+static int parse_layer_id(const char * name) {
+    const char * dash = strrchr(name, '-');
+    if (!dash) return -1;
+    char * end = nullptr;
+    long v = strtol(dash + 1, &end, 10);
+    if (end == dash + 1) return -1;
+    return (int) v;
+}
+
+static uint64_t now_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static bool collector_cb(struct ggml_tensor * t, bool ask, void * ud) {
+    auto * c = (CollectorContext *) ud;
+
+    const bool is_topk    = strncmp(t->name, "ffn_moe_topk-", 13) == 0;
+    const bool is_weights = strncmp(t->name, "ffn_moe_weights-", 16) == 0;
+
+    if (c->verbose) {
+        fprintf(stderr, "[cb] ask=%d name=%s topk=%d weights=%d\n",
+                (int)ask, t->name, (int)is_topk, (int)is_weights);
+    }
+
+    if (ask) {
+        return is_topk || is_weights;
+    }
+
+    if (!is_topk && !is_weights) return true;
+
+    int layer = parse_layer_id(t->name);
+    if (layer < 0) return true;
+
+    if ((int) c->pending.size() <= layer) {
+        // Should be pre-sized, but be safe in case of unexpected layer counts.
+        // Note: never grow during callback if we can avoid — references can invalidate.
+        return true;
+    }
+
+    if (is_topk) {
+        // I32 tensor, logical shape [n_expert_used, n_tokens] but may be a VIEW
+        // with non-contiguous strides. ggml_nbytes returns the underlying buffer
+        // span (in bytes), which can be larger than n_used * n_tokens * 4.
+        const int    n_used   = (int) t->ne[0];
+        const int    n_tokens = (int) t->ne[1];
+        const size_t nbytes   = ggml_nbytes(t);
+        if (c->verbose) {
+            fprintf(stderr, "[topk] layer=%d n_used=%d n_tokens=%d nbytes=%zu nb0=%zu nb1=%zu\n",
+                    layer, n_used, n_tokens, nbytes, t->nb[0], t->nb[1]);
+        }
+        if (n_used <= 0 || n_tokens <= 0) return true;
+
+        auto & p = c->pending[layer];
+        // Allocate enough u32 slots to hold the underlying buffer span
+        p.ids.resize(nbytes / sizeof(int32_t));
+        ggml_backend_tensor_get(t, p.ids.data(), 0, nbytes);
+        p.n_used   = n_used;
+        p.n_tokens = n_tokens;
+        p.stride1  = t->nb[1] / sizeof(int32_t);  // stride between tokens (in i32 elements)
+        p.has_data = true;
+        return true;
+    }
+
+    // is_weights: F32 with logical shape (1, n_used, n_tokens), also potentially a view
+    const int    n_used   = (int) t->ne[1];
+    const int    n_tokens = (int) t->ne[2];
+    const size_t nbytes   = ggml_nbytes(t);
+
+    auto & p = c->pending[layer];
+    if (c->verbose) {
+        fprintf(stderr, "[weights] layer=%d n_used=%d n_tokens=%d nbytes=%zu nb1=%zu nb2=%zu has_data=%d p.n_used=%d p.n_tokens=%d\n",
+                layer, n_used, n_tokens, nbytes, t->nb[1], t->nb[2],
+                (int)p.has_data, p.n_used, p.n_tokens);
+    }
+    if (!p.has_data || p.n_used != n_used || p.n_tokens != n_tokens) {
+        return true;
+    }
+
+    std::vector<float> weights(nbytes / sizeof(float));
+    ggml_backend_tensor_get(t, weights.data(), 0, nbytes);
+    const size_t w_stride2 = t->nb[2] / sizeof(float);  // stride between tokens (f32)
+    const size_t w_stride1 = t->nb[1] / sizeof(float);  // stride between experts within a token
+
+    const uint64_t ts = now_ns();
+    const int n_keep = std::min(n_used, 16);
+
+    for (int tok = 0; tok < n_tokens; ++tok) {
+        ActivationRecord rec = {};
+        rec.timestamp_ns    = ts;
+        rec.token_idx       = c->base_token_idx + (uint32_t) tok;
+        rec.layer           = (uint16_t) layer;
+        rec.n_experts_used  = (uint8_t) n_keep;
+
+        for (int i = 0; i < n_keep; ++i) {
+            rec.expert_ids[i]     = (uint16_t) p.ids[(size_t) tok * p.stride1 + i];
+            rec.expert_weights[i] = weights[(size_t) tok * w_stride2 + (size_t) i * w_stride1];
+        }
+
+        c->out.write(reinterpret_cast<const char *>(&rec), sizeof(rec));
+        c->records.fetch_add(1, std::memory_order_relaxed);
+
+#ifdef MOE_SCHEDULER_AVAILABLE
+        // Feed to scheduler (online matrix learning + next-layer prefetch).
+        if (c->scheduler) {
+            uint16_t cmds[64 * 4];  // up to 64 commands × 4 u16 per
+            size_t n_cmds = moe_scheduler_observe_and_predict(
+                c->scheduler,
+                rec.token_idx, rec.layer,
+                rec.expert_ids, rec.n_experts_used,
+                cmds, 64
+            );
+            for (size_t i = 0; i < n_cmds; ++i) {
+                uint16_t action = cmds[i*4 + 0];
+                if (action == 0) c->sched_prefetches.fetch_add(1, std::memory_order_relaxed);
+                else             c->sched_evictions.fetch_add(1, std::memory_order_relaxed);
+            }
+        }
+#endif
+    }
+
+    p.has_data = false;
+    return true;
+}
+
+static bool run(llama_context * ctx, const common_params & params,
+                CollectorContext & cc, int n_decode_steps) {
+    const llama_model * model = llama_get_model(ctx);
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+    const bool add_bos = llama_vocab_get_add_bos(vocab);
+
+    std::vector<llama_token> tokens =
+        common_tokenize(ctx, params.prompt, add_bos, true);
+
+    if (tokens.empty()) {
+        LOG_ERR("collector: empty prompt\n");
+        return false;
+    }
+
+    LOG_INF("collector: %zu prompt tokens, %d layers in model\n",
+            tokens.size(), llama_model_n_layer(model));
+
+    cc.base_token_idx = 0;
+    if (llama_decode(ctx, llama_batch_get_one(tokens.data(), (int32_t) tokens.size()))) {
+        LOG_ERR("collector: prefill decode failed\n");
+        return false;
+    }
+    cc.base_token_idx += (uint32_t) tokens.size();
+
+    // Re-feed the last token N times to capture decode-style activations.
+    // We don't sample — we just want router patterns.
+    llama_token last_tok = tokens.back();
+    for (int i = 0; i < n_decode_steps; ++i) {
+        if (llama_decode(ctx, llama_batch_get_one(&last_tok, 1))) {
+            LOG_ERR("collector: decode step %d failed\n", i);
+            return false;
+        }
+        cc.base_token_idx += 1;
+    }
+
+    return true;
+}
+
+int main(int argc, char ** argv) {
+    common_params params;
+    common_init();
+
+    if (!common_params_parse(argc, argv, params, LLAMA_EXAMPLE_COMMON)) {
+        return 1;
+    }
+
+    const std::string out_path =
+        getenv("COLLECTOR_OUT") ? getenv("COLLECTOR_OUT") : "activations.bin";
+
+    CollectorContext cc;
+    cc.verbose = getenv("COLLECTOR_VERBOSE") != nullptr;
+    cc.out.open(out_path, std::ios::binary | std::ios::trunc);
+    if (!cc.out) {
+        LOG_ERR("collector: cannot open %s for writing\n", out_path.c_str());
+        return 1;
+    }
+
+    llama_backend_init();
+    llama_numa_init(params.numa);
+
+    params.cb_eval           = collector_cb;
+    params.cb_eval_user_data = &cc;
+    params.warmup            = false;
+
+    auto llama_init = common_init_from_params(params);
+    auto * model = llama_init->model();
+    auto * ctx   = llama_init->context();
+
+    if (!model || !ctx) {
+        LOG_ERR("collector: model/context init failed\n");
+        return 1;
+    }
+
+    LOG_INF("collector: writing records → %s\n", out_path.c_str());
+
+    // Pre-allocate pending buffer based on model layer count (avoid resize during callback)
+    cc.pending.resize(llama_model_n_layer(model));
+
+#ifdef MOE_SCHEDULER_AVAILABLE
+    // Initialize the scheduler if env var enables it.
+    // n_experts is parsed from model metadata if needed; for now, infer from first
+    // observed callback.  But we can also just use default config and not require it.
+    if (getenv("MOE_SCHEDULER") != nullptr) {
+        // Read defaults / overrides from env
+        const char* env_n_experts = getenv("MOE_N_EXPERTS");
+        const char* env_vram_cap  = getenv("MOE_VRAM_CAP");
+        const char* env_k_prime   = getenv("MOE_K_PRIME");
+
+        uint16_t n_layers  = (uint16_t) llama_model_n_layer(model);
+        uint16_t n_experts = (uint16_t) (env_n_experts ? atoi(env_n_experts) : 128);
+        uint32_t vram_cap  = (uint32_t) (env_vram_cap  ? atoi(env_vram_cap)  : 256);
+        uint32_t k_prime   = (uint32_t) (env_k_prime   ? atoi(env_k_prime)   : 16);
+
+        cc.scheduler = moe_scheduler_new(n_layers, n_experts, vram_cap, k_prime);
+        if (cc.scheduler) {
+            LOG_INF("collector: %s — scheduler enabled (n_layers=%u n_experts=%u vram_cap=%u k'=%u)\n",
+                    moe_scheduler_version(), n_layers, n_experts, vram_cap, k_prime);
+
+            // Optionally load a pre-trained matrix from disk.
+            const char* matrix_path = getenv("MOE_MATRIX_PATH");
+            if (matrix_path && *matrix_path) {
+                int rc = moe_scheduler_load_matrix(cc.scheduler, matrix_path);
+                if (rc == 0) {
+                    LOG_INF("collector: loaded pre-trained matrix from %s\n", matrix_path);
+                } else {
+                    LOG_ERR("collector: load_matrix failed (rc=%d), continuing with empty matrix\n", rc);
+                }
+            } else {
+                LOG_INF("collector: no MOE_MATRIX_PATH set, scheduler starts cold\n");
+            }
+        } else {
+            LOG_ERR("collector: failed to create scheduler\n");
+        }
+    }
+#endif
+
+    const int n_decode = std::max(params.n_predict, 0);
+    const bool ok = run(ctx, params, cc, n_decode);
+
+    cc.out.close();
+
+    const uint64_t n = cc.records.load();
+    LOG_INF("collector: done. %llu records (%llu bytes) written.\n",
+            (unsigned long long) n,
+            (unsigned long long) (n * sizeof(ActivationRecord)));
+
+#ifdef MOE_SCHEDULER_AVAILABLE
+    if (cc.scheduler) {
+        uint64_t obs = 0, vram_hits = 0, ram_hits = 0, misses = 0, total_acc = 0;
+        uint32_t n_in_vram = 0;
+        moe_scheduler_get_stats(cc.scheduler, &obs, &vram_hits, &ram_hits, &misses, &total_acc, &n_in_vram);
+        LOG_INF("scheduler: observations=%llu, prefetches=%llu, evictions=%llu\n",
+                (unsigned long long) obs,
+                (unsigned long long) cc.sched_prefetches.load(),
+                (unsigned long long) cc.sched_evictions.load());
+        LOG_INF("scheduler: cache vram_hits=%llu ram_hits=%llu misses=%llu (total=%llu)\n",
+                (unsigned long long) vram_hits,
+                (unsigned long long) ram_hits,
+                (unsigned long long) misses,
+                (unsigned long long) total_acc);
+        LOG_INF("scheduler: %u experts currently in VRAM cache (logical)\n", n_in_vram);
+
+        moe_scheduler_free(cc.scheduler);
+    }
+#endif
+
+    llama_backend_free();
+    return ok ? 0 : 1;
+}
