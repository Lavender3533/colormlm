+static q35_neural_island_config q35_read_neural_island_config(const llama_model & model) {
+    q35_neural_island_config config;
+    if (model.arch != LLM_ARCH_COLORLMV4) {
+        return config;
+    }
+    const char * raw_alpha = std::getenv("COLORLM_NEURAL_ISLAND_ALPHA");
+    config.alpha = std::clamp(raw_alpha ? (float) std::atof(raw_alpha) : 0.0f, 0.0f, 1.0f);
+    if (config.alpha <= 0.0f) {
+        return config;
+    }
+    const char * raw_manifest = std::getenv("COLORLM_NEURAL_ISLAND_MANIFEST");
+    if (!raw_manifest || raw_manifest[0] == '\0') {
+        throw std::runtime_error("COLORLM_NEURAL_ISLAND_MANIFEST is required when Neural Island is enabled");
+    }
+    config.manifest = std::filesystem::path(raw_manifest);
+    const char * raw_site = std::getenv("COLORLM_NEURAL_ISLAND_SITE");
+    config.site = raw_site ? std::atoi(raw_site) : (int) model.hparams.n_layer - 5;
+    if (config.site < 0 || config.site >= (int) model.hparams.n_layer) {
+        throw std::runtime_error("COLORLM_NEURAL_ISLAND_SITE is outside the model");
+    }
+    const char * raw_ratio = std::getenv("COLORLM_NEURAL_ISLAND_TARGET_RATIO");
+    config.target_ratio = std::clamp(
+        raw_ratio ? (float) std::atof(raw_ratio) : 0.04f, 1e-4f, 1.0f);
+    const char * raw_sharpness = std::getenv("COLORLM_NEURAL_ISLAND_SHARPNESS");
+    config.sharpness = std::clamp(
+        raw_sharpness ? (float) std::atof(raw_sharpness) : 4.0f, 0.25f, 16.0f);
+    const char * raw_verify = std::getenv("COLORLM_NEURAL_ISLAND_VERIFY_WEIGHTS");
+    config.verify_weights_sha256 = raw_verify && std::strcmp(raw_verify, "1") == 0;
+    const char * raw_cache_slots =
+        std::getenv("COLORLM_NEURAL_ISLAND_EXPERT_CACHE_SLOTS");
+    config.expert_cache_slots = raw_cache_slots ? std::atoi(raw_cache_slots) : 0;
+    if (config.expert_cache_slots != 0 &&
+        (config.expert_cache_slots < 10 || config.expert_cache_slots > 512)) {
+        throw std::runtime_error(
+            "COLORLM_NEURAL_ISLAND_EXPERT_CACHE_SLOTS must be 0 or 10..512");
+    }
+    const char * raw_batch_upload =
+        std::getenv("COLORLM_NEURAL_ISLAND_EXPERT_CACHE_BATCH_UPLOAD");
+    config.expert_cache_batch_upload =
+        !raw_batch_upload || std::strcmp(raw_batch_upload, "0") != 0;
+    const char * raw_cache_policy =
+        std::getenv("COLORLM_NEURAL_ISLAND_EXPERT_CACHE_POLICY");
+    if (raw_cache_policy && std::strcmp(raw_cache_policy, "lfu97") == 0) {
+        config.expert_cache_frequency_decay = 0.97f;
+    } else if (raw_cache_policy && std::strcmp(raw_cache_policy, "lru") != 0) {
+        throw std::runtime_error(
+            "COLORLM_NEURAL_ISLAND_EXPERT_CACHE_POLICY must be lru or lfu97");
+    }
+    return config;
+}
+
+static std::vector<llama_neural_block *> q35_try_init_neural_island(
+        const llama_model & model,
+        const q35_neural_island_config & config) {
+    std::vector<llama_neural_block *> result;
+    if (config.alpha <= 0.0f) {
+        return result;
+    }
+    std::lock_guard<std::mutex> lock(g_q35_neural_island_mutex);
+    if (g_q35_neural_island_model != &model) {
+        g_q35_neural_island_expert_caches.clear();
+        g_q35_neural_island.clear();
+        g_q35_neural_island_expert_cache_slots = 0;
+        g_q35_neural_island_model = &model;
+    }
+    if (g_q35_neural_island.empty()) {
+        std::ifstream stream(config.manifest);
+        if (!stream) {
+            throw std::runtime_error("ColorLM Neural Island requires island.json");
+        }
+        const nlohmann::json manifest = nlohmann::json::parse(stream);
+        if (manifest.at("format").get<std::string>() != "colorlm-neural-island-runtime-v1" ||
+            !manifest.at("formal").get<bool>() ||
+            manifest.at("execution").get<std::string>() !=
+                "contiguous-donor-coordinates-single-entry-single-exit" ||
+            manifest.at("target_site").get<int>() != config.site ||
+            manifest.at("source_layers").get<std::vector<int>>() !=
+                std::vector<int>({44, 45, 46, 47})) {
+            throw std::runtime_error("unsupported ColorLM Neural Island contract");
+        }
+        const auto & layers = manifest.at("layers");
+        if (!layers.is_array() || layers.size() != 4) {
+            throw std::runtime_error("ColorLM Neural Island requires four contiguous layers");
+        }
+        for (size_t index = 0; index < layers.size(); ++index) {
+            const auto & layer = layers.at(index);
+            const int expected_layer = 44 + (int) index;
+            if (layer.at("source_layer").get<int>() != expected_layer) {
+                throw std::runtime_error("ColorLM Neural Island layer order mismatch");
+            }
+            std::filesystem::path package = layer.at("package").get<std::string>();
+            if (package.is_relative()) {
+                package = std::filesystem::absolute(package);
+            }
+            ggml_backend_buffer_type_t buft = q35_pick_gpu_buft(model);
+            if (!buft) {
+                buft = model.select_buft(config.site);
+            }
+            ggml_backend_buffer_type_t experts_buft = q35_pick_gpu_host_buft();
+            auto block = llama_neural_block::load_qwen3next_q4(
+                package, buft, layer.at("manifest_sha256").get<std::string>(),
+                config.verify_weights_sha256, experts_buft);
+            if (!block || block->source_layer() != expected_layer ||
+                block->target_site() != config.site ||
+                block->is_recurrent() != (expected_layer < 47)) {
+                throw std::runtime_error("ColorLM Neural Island layer validation failed");
+            }
+            g_q35_neural_island.push_back(std::move(block));
+        }
+        LLAMA_LOG_INFO(
+            "ColorLM Neural Island loaded: L44-L47 -> site %d, hot path on GPU and exact top-k experts in mapped host memory\n",
+            config.site);
+    }
+    if (g_q35_neural_island_expert_cache_slots != config.expert_cache_slots) {
+        g_q35_neural_island_expert_caches.clear();
+        g_q35_neural_island_expert_cache_slots = 0;
+    }
+    if (config.expert_cache_slots > 0 &&
+        g_q35_neural_island_expert_caches.empty()) {
+        ggml_backend_buffer_type_t cache_buft = q35_pick_gpu_buft(model);
+        if (!cache_buft) {
+            cache_buft = model.select_buft(config.site);
+        }
+        size_t cache_bytes = 0;
+        for (const auto & block : g_q35_neural_island) {
+            llama_neural_expert_cache::config cache_config{};
+            cache_config.slots = (uint32_t) config.expert_cache_slots;
+            cache_config.gpu_buft = cache_buft;
+            cache_config.source_layer = block->source_layer();
+            cache_config.batch_upload = config.expert_cache_batch_upload;
+            cache_config.frequency_decay = config.expert_cache_frequency_decay;
+            cache_config.max_batch_experts =
+                (uint32_t) block->experts_per_token();
+            auto cache = llama_neural_expert_cache::create(
+                block->experts_gate(), block->experts_up(), block->experts_down(),
+                cache_config);
+            if (!cache) {
+                g_q35_neural_island_expert_caches.clear();
+                throw std::runtime_error(
+                    "ColorLM Neural Island expert cache allocation failed");
+            }
+            cache_bytes += cache->pool()->total_vram_bytes();
+            g_q35_neural_island_expert_caches.push_back(std::move(cache));
+        }
+        g_q35_neural_island_expert_cache_slots = config.expert_cache_slots;
+        const bool batch_upload_enabled = std::all_of(
+            g_q35_neural_island_expert_caches.begin(),
+            g_q35_neural_island_expert_caches.end(),
+            [](const auto & cache) { return cache->batch_upload_enabled(); });
+        LLAMA_LOG_INFO(
+            "ColorLM Neural Island exact expert cache: 4 x %d slots, %.2f MiB VRAM; decode only; batch_upload=%s policy=%s\n",
+            config.expert_cache_slots, cache_bytes / (1024.0 * 1024.0),
+            batch_upload_enabled ? "on" : "off",
+            config.expert_cache_frequency_decay > 0.0f ? "lfu97" : "lru");
+    }
+    result.reserve(g_q35_neural_island.size());
+    for (const auto & block : g_q35_neural_island) {
+        result.push_back(block.get());
+    }
+    return result;
+}
