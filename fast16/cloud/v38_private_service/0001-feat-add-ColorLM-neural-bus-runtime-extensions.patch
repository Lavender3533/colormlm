index 0000000..7745c38
--- /dev/null
+++ b/tools/slot-pool-test/slot_pool_test.cpp
@@ -0,0 +1,248 @@
+// Smoke test: allocate a slot pool sized for Qwen3-30B-A3B layout,
+// stage some synthetic expert bytes, read back and verify correctness.
+// Then build and execute a real MoE FFN inner-loop graph on Vulkan to
+// validate the LUT remap + MUL_MAT_ID(slot_pool, ...) routing path.
+//
+// Verifies:
+//  - VRAM allocation succeeds for the planned 48-layer × K'=16 layout
+//  - ggml_backend_tensor_set writes the right bytes to the right slot
+//  - Total VRAM accounting matches expectation
+//  - LUT remap via ggml_get_rows works on Vulkan
+//  - MUL_MAT_ID against slot_pool tensor + remapped indices runs end-to-end
+
+#include "llama-slot-pool.h"
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+static double now_ms() {
+    using clock = std::chrono::steady_clock;
+    static const auto t0 = clock::now();
+    return std::chrono::duration<double, std::milli>(clock::now() - t0).count();
+}
+
+int main() {
+    ggml_backend_load_all();
+
+    // pick first non-CPU device
+    ggml_backend_dev_t dev = nullptr;
+    for (int i = 0; i < (int) ggml_backend_dev_count(); ++i) {
+        auto * d = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(d) != GGML_BACKEND_DEVICE_TYPE_CPU) { dev = d; break; }
+    }
+    if (!dev) { fprintf(stderr, "no GPU device found\n"); return 1; }
+
+    auto * backend = ggml_backend_dev_init(dev, nullptr);
+    if (!backend) { fprintf(stderr, "backend init failed\n"); return 1; }
+
+    auto * buft = ggml_backend_dev_buffer_type(dev);
+    printf("Using backend: %s on %s\n\n", ggml_backend_name(backend), ggml_backend_dev_name(dev));
+
+    // Qwen3-30B-A3B layout
+    slot_pool::config cfg;
+    cfg.n_layers = 48;
+    cfg.k_prime  = 16;
+    cfg.n_embd   = 2048;
+    cfg.n_ff_exp = 768;
+    cfg.type     = GGML_TYPE_Q4_K;     // matches Q4_K_M weights
+    cfg.buft     = buft;
+
+    printf("Allocating slot pool: %u layers × K'=%u × {gate,up,down}\n",
+           cfg.n_layers, cfg.k_prime);
+    printf("  gate/up: [%lld, %lld, %u]  down: [%lld, %lld, %u]  type=%s\n",
+           (long long) cfg.n_embd, (long long) cfg.n_ff_exp, cfg.k_prime,
+           (long long) cfg.n_ff_exp, (long long) cfg.n_embd, cfg.k_prime,
+           ggml_type_name(cfg.type));
+
+    double t0 = now_ms();
+    auto pool = slot_pool::create(cfg);
+    double t1 = now_ms();
+    if (!pool) { fprintf(stderr, "slot_pool::create failed\n"); return 1; }
+
+    const size_t total = pool->total_vram_bytes();
+    printf("\nAllocated in %.2f ms\n", t1 - t0);
+    printf("  total VRAM: %.2f MB\n", total / (1024.0 * 1024.0));
+    printf("  per expert: gate=%zu B, up=%zu B, down=%zu B\n",
+           pool->gate_bytes_per_expert(),
+           pool->up_bytes_per_expert(),
+           pool->down_bytes_per_expert());
+    printf("  per layer (k'=%u): %.2f MB\n",
+           cfg.k_prime,
+           (pool->gate_bytes_per_expert() + pool->up_bytes_per_expert() + pool->down_bytes_per_expert())
+               * cfg.k_prime / (1024.0 * 1024.0));
+
+    // Stage one expert's worth of bytes to layer=0 slot=0, with a recognizable pattern.
+    // Then verify by reading back via ggml_backend_tensor_get.
+    const size_t gate_bytes = pool->gate_bytes_per_expert();
+    const size_t up_bytes   = pool->up_bytes_per_expert();
+    const size_t down_bytes = pool->down_bytes_per_expert();
+    std::vector<uint8_t> gate_src(gate_bytes), up_src(up_bytes), down_src(down_bytes);
+    for (size_t i = 0; i < gate_bytes; ++i) gate_src[i] = (uint8_t)((i * 7 + 3)  & 0xff);
+    for (size_t i = 0; i < up_bytes;   ++i) up_src[i]   = (uint8_t)((i * 11 + 5) & 0xff);
+    for (size_t i = 0; i < down_bytes; ++i) down_src[i] = (uint8_t)((i * 13 + 9) & 0xff);
+
+    printf("\nStaging 1 expert into (layer=0, slot=0)...\n");
+    double s0 = now_ms();
+    pool->stage(0, 0, gate_src.data(), gate_bytes, up_src.data(), up_bytes, down_src.data(), down_bytes);
+    ggml_backend_synchronize(backend);
+    double s1 = now_ms();
+    printf("  staged %.2f MB in %.3f ms (%.2f GB/s)\n",
+           (gate_bytes + up_bytes + down_bytes) / (1024.0 * 1024.0),
+           s1 - s0,
+           ((gate_bytes + up_bytes + down_bytes) / 1.0e9) / ((s1 - s0) / 1000.0));
+
+    // readback verify
+    std::vector<uint8_t> rb(gate_bytes);
+    ggml_backend_tensor_get(pool->gate(0), rb.data(), 0, gate_bytes);
+    bool ok = std::memcmp(rb.data(), gate_src.data(), gate_bytes) == 0;
+    printf("  readback match (gate, slot 0): %s\n", ok ? "OK" : "MISMATCH");
+
+    // Stage 8 experts into layer=10 (typical decode-step scenario), measure full latency
+    printf("\nStaging 8 experts into layer=10 (typical decode step, all 3 tensor kinds)...\n");
+    double m0 = now_ms();
+    for (uint32_t s = 0; s < 8; ++s) {
+        pool->stage(10, s, gate_src.data(), gate_bytes, up_src.data(), up_bytes, down_src.data(), down_bytes);
+    }
+    ggml_backend_synchronize(backend);
+    double m1 = now_ms();
+    const double bytes_8 = 8 * (gate_bytes + up_bytes + down_bytes);
+    printf("  staged %.2f MB in %.3f ms (%.2f GB/s)\n",
+           bytes_8 / (1024.0 * 1024.0), m1 - m0,
+           (bytes_8 / 1.0e9) / ((m1 - m0) / 1000.0));
+
+    // Per-token estimate (48 layers, 8 experts each, all miss = upper bound)
+    const double per_layer_ms = m1 - m0;
+    printf("  → per-token upper bound (48 layers × 8 exp all miss): %.1f ms = %.1f tok/s\n",
+           48 * per_layer_ms, 1000.0 / (48 * per_layer_ms));
+
+    // ============================================================================
+    //  Inner-loop architecture validation:
+    //  Build a real MoE FFN graph using slot_pool tensors + LUT remap, on Vulkan.
+    // ============================================================================
+    printf("\n=== Inner-loop graph: MoE FFN with slot pool + LUT remap (single layer, n_tokens=1) ===\n");
+
+    pool->set_n_logical_experts(128);
+
+    // For the test, pretend logical experts {3, 7, 11, ..., 0..K_PRIME pattern} are staged in slots 0..K'-1.
+    // We'll need the gate/up/down tensors to actually contain valid Q4_K data — so stage random bytes
+    // (the math output will be garbage, but ggml only cares the bytes are well-formed Q4_K blocks).
+    // For now we already staged synthetic bytes above into (layer 0, slot 0); stage rest here.
+    for (uint32_t s = 1; s < cfg.k_prime; ++s) {
+        pool->stage(0, s, gate_src.data(), gate_bytes, up_src.data(), up_bytes, down_src.data(), down_bytes);
+    }
+    ggml_backend_synchronize(backend);
+
+    // Logical → slot map for layer 0: logical (s*7+3) % 128 → slot s. Rest = SENTINEL.
+    int32_t * lut = pool->lut_host(0);
+    std::vector<uint16_t> staged_logical(cfg.k_prime);
+    for (uint32_t s = 0; s < cfg.k_prime; ++s) {
+        uint16_t logical = (uint16_t)((s * 7 + 3) % 128);
+        staged_logical[s] = logical;
+        lut[logical] = (int32_t) s;
+    }
+
+    // Build a graph that does the inner-loop MoE FFN against slot pool, for n_tokens=1, K=8.
+    const int n_tokens     = 1;
+    const int n_expert_use = 8;
+
+    // Pick selected_experts[k, t] from the staged set so we get hits (not sentinels) — we are
+    // testing the routing infrastructure, not miss handling.
+    std::vector<int32_t> selected_logical(n_expert_use * n_tokens);
+    for (int t = 0; t < n_tokens; ++t) {
+        for (int k = 0; k < n_expert_use; ++k) {
+            selected_logical[t * n_expert_use + k] = (int32_t) staged_logical[k];
+        }
+    }
+
+    // input x: [n_embd, n_tokens] f32
+    std::vector<float> x_host(cfg.n_embd * n_tokens);
+    for (auto & v : x_host) v = ((float) rand() / RAND_MAX) * 0.01f;
+
+    // Build the graph in a separate ggml_context (no_alloc=true; bound to backend below)
+    ggml_init_params gip = { /*mem_size=*/ 1024 * 1024, /*mem_buffer=*/ NULL, /*no_alloc=*/ true };
+    ggml_context * gctx = ggml_init(gip);
+
+    ggml_tensor * x_t            = ggml_new_tensor_2d(gctx, GGML_TYPE_F32, cfg.n_embd, n_tokens);
+    ggml_tensor * sel_t          = ggml_new_tensor_2d(gctx, GGML_TYPE_I32, n_expert_use, n_tokens);
+    // LUT shaped as [1, n_logical] so get_rows returns [1, K*T] (elementwise lookup, not row selection)
+    ggml_tensor * lut_t          = ggml_new_tensor_2d(gctx, GGML_TYPE_I32, 1, pool->n_logical_experts());
+    ggml_set_name(x_t, "x");
+    ggml_set_name(sel_t, "selected_experts");
+    ggml_set_name(lut_t, "lut");
+
+    // remapped[k,t] = lut[ selected_experts[k,t] ] -- elementwise lookup
+    // Flatten selected to 1D, get_rows returns [1, K*T], reshape back to [K, T].
+    ggml_tensor * sel_flat       = ggml_view_1d(gctx, sel_t, n_expert_use * n_tokens, 0);
+    ggml_tensor * remapped_flat  = ggml_get_rows(gctx, lut_t, sel_flat);
+    ggml_tensor * remapped       = ggml_reshape_2d(gctx, remapped_flat, n_expert_use, n_tokens);
+    ggml_set_name(remapped, "remapped_slot_indices");
+
+    // up = MUL_MAT_ID(slot_pool->up(0), x, remapped)  → [n_ff_exp, K, T]
+    ggml_tensor * up_out         = ggml_mul_mat_id(gctx, pool->up(0),   x_t, remapped);
+    // gate = MUL_MAT_ID(slot_pool->gate(0), x, remapped) → [n_ff_exp, K, T]
+    ggml_tensor * gate_out       = ggml_mul_mat_id(gctx, pool->gate(0), x_t, remapped);
+    // swiglu(gate) * up
+    ggml_tensor * gate_silu      = ggml_silu(gctx, gate_out);
+    ggml_tensor * inner          = ggml_mul(gctx, gate_silu, up_out);
+    // down = MUL_MAT_ID(slot_pool->down(0), inner, remapped) → [n_embd, K, T]
+    ggml_tensor * down_out       = ggml_mul_mat_id(gctx, pool->down(0), inner, remapped);
+    ggml_set_name(down_out, "moe_ffn_out");
+
+    // Build the forward graph for down_out
+    ggml_cgraph * gf = ggml_new_graph(gctx);
+    ggml_build_forward_expand(gf, down_out);
+
+    // Allocate input tensors on the backend buffer.
+    ggml_backend_buffer_t graph_buf = ggml_backend_alloc_ctx_tensors(gctx, backend);
+    if (!graph_buf) {
+        fprintf(stderr, "graph buffer alloc failed\n");
+        return 2;
+    }
+
+    // Upload inputs
+    ggml_backend_tensor_set(x_t,   x_host.data(),           0, ggml_nbytes(x_t));
+    ggml_backend_tensor_set(sel_t, selected_logical.data(), 0, ggml_nbytes(sel_t));
+    ggml_backend_tensor_set(lut_t, pool->lut_host(0),       0, ggml_nbytes(lut_t));
+
+    // Warmup
+    ggml_backend_graph_compute(backend, gf);
+    ggml_backend_synchronize(backend);
+
+    // Time
+    const int n_iters = 50;
+    double i0 = now_ms();
+    for (int i = 0; i < n_iters; ++i) {
+        ggml_backend_graph_compute(backend, gf);
+    }
+    ggml_backend_synchronize(backend);
+    double i1 = now_ms();
+
+    double per_iter_ms = (i1 - i0) / n_iters;
+    printf("  graph compute (1 layer MoE FFN, K=8, T=1): %.3f ms / iter\n", per_iter_ms);
+    printf("  → per-token (48 layers, no transfer): %.1f ms = %.1f tok/s (compute only)\n",
+           48 * per_iter_ms, 1000.0 / (48 * per_iter_ms));
+
+    // Read back a few output values to confirm it computed something (won't crash if numerical garbage).
+    std::vector<float> out_host(ggml_nelements(down_out));
+    ggml_backend_tensor_get(down_out, out_host.data(), 0, ggml_nbytes(down_out));
+    bool any_nonzero = false;
+    int n_nan = 0;
+    for (float v : out_host) {
+        if (v != 0.0f) any_nonzero = true;
+        if (v != v)    n_nan++;
+    }
+    printf("  output: %zu floats, any_nonzero=%d, n_nan=%d, sample=[%.4g %.4g %.4g %.4g]\n",
+           out_host.size(), (int) any_nonzero, n_nan,
+           out_host[0], out_host[1], out_host[2], out_host[3]);
+
+    ggml_backend_buffer_free(graph_buf);
+    ggml_free(gctx);
+
+    backend = nullptr; // pool drops first via unique_ptr scope
+    return ok ? 0 : 1;
+}
