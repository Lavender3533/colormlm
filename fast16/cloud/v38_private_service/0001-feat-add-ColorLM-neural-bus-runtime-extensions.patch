+    q35_sequence_policy_dynamic_input(
+            const llama_neural_policy_head * policy,
+            const std::vector<llama_token> * tokens) :
+        policy(policy), tokens(tokens) {
+    }
+
+    void set_input(const llama_ubatch * ubatch) override {
+        GGML_UNUSED(ubatch);
+        const int capacity = policy->candidate_capacity();
+        std::vector<int32_t> ids_i32;
+        std::vector<int64_t> ids_i64;
+        std::vector<float> mask;
+        ids_i32.reserve((size_t) capacity);
+        ids_i64.reserve((size_t) capacity);
+        mask.reserve((size_t) capacity);
+        std::unordered_set<int64_t> used;
+        used.reserve((size_t) capacity * 2);
+        const auto append = [&](int64_t token, float active) {
+            if (token < 0 || token >= policy->base_vocab_size() ||
+                used.find(token) != used.end() ||
+                (int) ids_i64.size() >= capacity) {
+                return;
+            }
+            used.insert(token);
+            ids_i32.push_back((int32_t) token);
+            ids_i64.push_back(token);
+            mask.push_back(active);
+        };
+        for (int64_t token : policy->static_token_ids()) {
+            append(token, 1.0f);
+        }
+        if (tokens) {
+            for (auto it = tokens->rbegin();
+                 it != tokens->rend() && (int) ids_i64.size() < capacity;
+                 ++it) {
+                append((int64_t) *it, 1.0f);
+            }
+        }
+        for (int64_t token = 0;
+             (int) ids_i64.size() < capacity && token < policy->base_vocab_size();
+             ++token) {
+            append(token, 0.0f);
+        }
+        if ((int) ids_i64.size() != capacity) {
+            GGML_ABORT("ColorLM dynamic policy could not fill candidate input");
+        }
+        ggml_backend_tensor_set(
+            this->ids_i32, ids_i32.data(), 0, ids_i32.size() * sizeof(ids_i32[0]));
+        ggml_backend_tensor_set(
+            this->ids_i64, ids_i64.data(), 0, ids_i64.size() * sizeof(ids_i64[0]));
+        ggml_backend_tensor_set(
+            this->mask, mask.data(), 0, mask.size() * sizeof(mask[0]));
+    }
+
+    bool can_reuse(const llm_graph_params & params) override {
+        return params.sequence_policy_tokens == tokens;
+    }
+
+    const llama_neural_policy_head * policy = nullptr;
+    const std::vector<llama_token> * tokens = nullptr;
+    ggml_tensor * ids_i32 = nullptr;
+    ggml_tensor * ids_i64 = nullptr;
+    ggml_tensor * mask = nullptr;
+};
