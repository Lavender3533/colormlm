+
+    common_activation_dump_cb_user_data(
+            common_params & params,
+            const std::string & path,
+            const std::string & tensor_name,
+            uint32_t max_records);
+    ~common_activation_dump_cb_user_data();
+
+    common_activation_dump_cb_user_data(const common_activation_dump_cb_user_data &) = delete;
+    common_activation_dump_cb_user_data & operator=(const common_activation_dump_cb_user_data &) = delete;
+
+    bool enabled() const;
+};
+
+std::unique_ptr<common_activation_dump_cb_user_data> common_activation_dump_init_from_env(common_params & params);
