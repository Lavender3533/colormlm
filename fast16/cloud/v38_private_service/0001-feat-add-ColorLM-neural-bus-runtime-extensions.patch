+    llama_neural_output_head & operator=(const llama_neural_output_head &) = delete;
+
+    ggml_tensor * output_norm() const;
+    ggml_tensor * output() const;
+    ggml_tensor * base_ids() const;
+
+    int donor_vocab_size() const;
+    int base_vocab_size() const;
+    int mapped_tokens() const;
+    size_t weight_bytes() const;
