+    ggml_tensor * down_ = nullptr;
+    ggml_tensor * router_ = nullptr;
+};
+
+// A learned three-way capability router over ColorLM hidden states.
+// Route order is fixed by the ABI: no_op, coder, k3.
+class llama_neural_bus_intelligence_router {
+public:
+    static std::unique_ptr<llama_neural_bus_intelligence_router> load_f32_3way(
+        const std::filesystem::path & directory,
+        ggml_backend_buffer_type_t buft,
+        int64_t n_embd,
+        const std::string & expected_manifest_sha256);
+
+    ~llama_neural_bus_intelligence_router();
+
+    llama_neural_bus_intelligence_router(const llama_neural_bus_intelligence_router &) = delete;
+    llama_neural_bus_intelligence_router & operator=(const llama_neural_bus_intelligence_router &) = delete;
+
+    ggml_tensor * build_logits(ggml_context * ctx, ggml_tensor * input) const;
+    size_t weight_bytes() const;
+    const char * buffer_name() const;
+
+private:
+    llama_neural_bus_intelligence_router() = default;
+
+    ggml_context * ctx_ = nullptr;
+    ggml_backend_buffer_t buffer_ = nullptr;
+    ggml_tensor * weight_ = nullptr;
+    ggml_tensor * bias_ = nullptr;
+};
+
+// A complete Kimi K3 latent expert transported into ColorLM coordinates.
+// Files are headerless, row-major matrices in PyTorch [out, in] order.
+// v1/v2 use F16 throughout; v3 keeps the transport in F16 and stores the
+// three expert matrices as native ggml Q4_0 rows.
+class llama_neural_bus_k3_capsule {
+public:
+    static std::unique_ptr<llama_neural_bus_k3_capsule> load_situ(
+        const std::filesystem::path & directory,
+        ggml_backend_buffer_type_t buft,
+        int64_t n_embd,
+        int64_t n_latent,
+        int64_t n_ff,
+        const std::string & expected_manifest_sha256 = {});
+
+    ~llama_neural_bus_k3_capsule();
+
+    llama_neural_bus_k3_capsule(const llama_neural_bus_k3_capsule &) = delete;
+    llama_neural_bus_k3_capsule & operator=(const llama_neural_bus_k3_capsule &) = delete;
+
+    ggml_tensor * build_delta(ggml_context * ctx, ggml_tensor * input) const;
+    ggml_tensor * build_input_latent(ggml_context * ctx, ggml_tensor * input) const;
+    ggml_tensor * build_expert_latent(ggml_context * ctx, ggml_tensor * latent) const;
+    ggml_tensor * build_output_delta(ggml_context * ctx, ggml_tensor * latent) const;
+    ggml_tensor * build_router_score(ggml_context * ctx, ggml_tensor * input) const;
+    bool shares_transport_with(const llama_neural_bus_k3_capsule & other) const;
+    bool has_router() const;
+    float router_l2_norm() const;
+    size_t weight_bytes() const;
+    const char * buffer_name() const;
+    int source_layer() const;
+    int source_expert() const;
+
+private:
+    llama_neural_bus_k3_capsule() = default;
+
+    ggml_context * ctx_ = nullptr;
+    ggml_backend_buffer_t buffer_ = nullptr;
+    ggml_tensor * b_in_ = nullptr;
+    ggml_tensor * gate_ = nullptr;
+    ggml_tensor * up_ = nullptr;
+    ggml_tensor * down_ = nullptr;
+    ggml_tensor * gate_decode_ = nullptr;
+    ggml_tensor * up_decode_ = nullptr;
+    ggml_tensor * down_decode_ = nullptr;
+    ggml_tensor * norm_ = nullptr;
+    ggml_tensor * b_out_ = nullptr;
+    ggml_tensor * router_ = nullptr;
+    float rms_norm_eps_ = 1e-5f;
+    float router_l2_norm_ = 0.0f;
+    std::string transport_fingerprint_;
+    int source_layer_ = -1;
+    int source_expert_ = -1;
+};
diff --git a/src/llama-neural-expert-cache.cpp b/src/llama-neural-expert-cache.cpp
new file mode 100644
index 0000000..c19e9c1
--- /dev/null
+++ b/src/llama-neural-expert-cache.cpp
@@ -0,0 +1,367 @@
+#include "llama-neural-expert-cache.h"
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+
+namespace {
+
+bool has_exact_expert_layout(
+        const ggml_tensor * gate,
+        const ggml_tensor * up,
+        const ggml_tensor * down) {
+    if (!gate || !up || !down || !gate->buffer || !up->buffer || !down->buffer ||
+        !ggml_get_data(gate) || !ggml_get_data(up) || !ggml_get_data(down) ||
+        !ggml_backend_buffer_is_host(gate->buffer) ||
+        !ggml_backend_buffer_is_host(up->buffer) ||
+        !ggml_backend_buffer_is_host(down->buffer)) {
+        return false;
+    }
+
+    const int64_t n_embd = gate->ne[0];
+    const int64_t n_ff = gate->ne[1];
+    const int64_t n_expert = gate->ne[2];
+    if (n_embd <= 0 || n_ff <= 0 || n_expert <= 0 ||
+        up->ne[0] != n_embd || up->ne[1] != n_ff || up->ne[2] != n_expert ||
+        down->ne[0] != n_ff || down->ne[1] != n_embd || down->ne[2] != n_expert) {
+        return false;
+    }
+
+    const size_t gate_expert_bytes = ggml_row_size(gate->type, n_embd) * (size_t) n_ff;
+    const size_t up_expert_bytes = ggml_row_size(up->type, n_embd) * (size_t) n_ff;
+    const size_t down_expert_bytes = ggml_row_size(down->type, n_ff) * (size_t) n_embd;
+    return gate->nb[2] == gate_expert_bytes &&
+        up->nb[2] == up_expert_bytes &&
+        down->nb[2] == down_expert_bytes;
+}
+
+} // namespace
+
+std::unique_ptr<llama_neural_expert_cache> llama_neural_expert_cache::create(
+        ggml_tensor * source_gate,
+        ggml_tensor * source_up,
+        ggml_tensor * source_down,
+        const config & cfg) {
+    if (!cfg.gpu_buft || cfg.slots == 0 ||
+        !has_exact_expert_layout(source_gate, source_up, source_down)) {
+        return nullptr;
+    }
+
+    const uint32_t n_logical = (uint32_t) source_gate->ne[2];
+    if (cfg.slots > n_logical) {
+        return nullptr;
+    }
+
+    auto cache = std::unique_ptr<llama_neural_expert_cache>(new llama_neural_expert_cache());
+    cache->source_gate_ = source_gate;
+    cache->source_up_ = source_up;
+    cache->source_down_ = source_down;
+    cache->stats_.capacity = cfg.slots;
+    cache->stats_.source_layer = cfg.source_layer;
+    cache->batch_upload_ = cfg.batch_upload;
+    cache->frequency_decay_ =
+        cfg.frequency_decay > 0.0f && cfg.frequency_decay <= 1.0f
+        ? cfg.frequency_decay
+        : 0.0f;
+
+    slot_pool::config pool_cfg{};
+    pool_cfg.n_layers = 1;
+    pool_cfg.k_prime = cfg.slots;
+    pool_cfg.n_embd = source_gate->ne[0];
+    pool_cfg.n_ff_exp = source_gate->ne[1];
+    pool_cfg.gate_type = source_gate->type;
+    pool_cfg.up_type = source_up->type;
+    pool_cfg.down_type = source_down->type;
+    pool_cfg.buft = cfg.gpu_buft;
+    cache->pool_ = slot_pool::create(pool_cfg);
+    if (!cache->pool_) {
+        return nullptr;
+    }
+    cache->pool_->set_n_logical_experts(n_logical);
+    if (!cache->pool_->lut_gpu(0) || !cache->pool_->lut_host(0)) {
+        return nullptr;
+    }
+
+    ggml_backend_dev_t device = ggml_backend_buft_get_device(cfg.gpu_buft);
+    cache->upload_backend_ = device ? ggml_backend_dev_init(device, nullptr) : nullptr;
+    if (!cache->upload_backend_) {
+        return nullptr;
+    }
+
+    if (cache->batch_upload_ && cfg.max_batch_experts > 0) {
+        ggml_backend_buffer_type_t host_buft =
+            device ? ggml_backend_dev_host_buffer_type(device) : nullptr;
+        const uint32_t staging_experts =
+            std::min(cfg.max_batch_experts, cfg.slots);
+        const size_t bytes_per_expert =
+            cache->pool_->gate_bytes_per_expert() +
+            cache->pool_->up_bytes_per_expert() +
+            cache->pool_->down_bytes_per_expert();
+        cache->staging_buffer_ = host_buft
+            ? ggml_backend_buft_alloc_buffer(
+                host_buft, (size_t) staging_experts * bytes_per_expert)
+            : nullptr;
+        cache->staging_data_ = cache->staging_buffer_
+            ? static_cast<uint8_t *>(
+                ggml_backend_buffer_get_base(cache->staging_buffer_))
+            : nullptr;
+        cache->staging_experts_ = cache->staging_data_ ? staging_experts : 0;
+        if (!cache->staging_data_) {
+            if (cache->staging_buffer_) {
+                ggml_backend_buffer_free(cache->staging_buffer_);
+                cache->staging_buffer_ = nullptr;
+            }
+            cache->batch_upload_ = false;
+        }
+    } else {
+        cache->batch_upload_ = false;
+    }
+
+    cache->slot_to_expert_.assign(cfg.slots, slot_pool::SENTINEL_SLOT);
+    cache->slot_last_use_.assign(cfg.slots, 0);
+    cache->slot_frequency_.assign(cfg.slots, 0.0f);
+    int32_t * lut = cache->pool_->lut_host(0);
+    std::fill(lut, lut + n_logical, slot_pool::SENTINEL_SLOT);
+    // The first exact decode step always uploads a populated LUT before use.
+    // Initializing the device copy to zero keeps diagnostics deterministic.
+    cache->pool_->lut_upload(0);
+    return cache;
+}
+
+llama_neural_expert_cache::~llama_neural_expert_cache() {
+    if (upload_backend_) {
+        ggml_backend_synchronize(upload_backend_);
+        ggml_backend_free(upload_backend_);
+    }
+    if (staging_buffer_) {
+        ggml_backend_buffer_free(staging_buffer_);
+    }
+}
+
+bool llama_neural_expert_cache::ensure_resident(
+        const int32_t * logical_experts,
+        size_t count,
+        stats * snapshot) {
+    if ((!logical_experts && count != 0) || !pool_ || !upload_backend_) {
+        return false;
+    }
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    const uint32_t n_logical = pool_->n_logical_experts();
+    const uint32_t k_prime = pool_->get_config().k_prime;
+    int32_t * lut = pool_->lut_host(0);
+
+    std::vector<int32_t> unique;
+    unique.reserve(std::min<size_t>(count, k_prime));
+    std::vector<uint8_t> requested(n_logical, 0);
+    for (size_t i = 0; i < count; ++i) {
+        const int32_t expert = logical_experts[i];
+        if (expert < 0 || (uint32_t) expert >= n_logical) {
+            return false;
+        }
+        if (!requested[(uint32_t) expert]) {
+            requested[(uint32_t) expert] = 1;
+            unique.push_back(expert);
+        }
+    }
+    if (unique.size() > k_prime) {
+        return false;
+    }
+
+    const uint64_t use_epoch = ++tick_;
+    ++stats_.steps;
+    if (frequency_decay_ > 0.0f) {
+        for (float & frequency : slot_frequency_) {
+            frequency *= frequency_decay_;
+        }
+    }
+    std::vector<uint8_t> pinned(k_prime, 0);
+    std::vector<int32_t> misses;
+    misses.reserve(unique.size());
+    for (const int32_t expert : unique) {
+        const int32_t slot = lut[expert];
+        if (slot >= 0 && (uint32_t) slot < k_prime &&
+            slot_to_expert_[(uint32_t) slot] == expert) {
+            pinned[(uint32_t) slot] = 1;
+            slot_last_use_[(uint32_t) slot] = use_epoch;
+            slot_frequency_[(uint32_t) slot] += 1.0f;
+            ++stats_.hits;
+        } else {
+            misses.push_back(expert);
+            ++stats_.misses;
+        }
+    }
+
+    if (misses.empty()) {
+        if (snapshot) {
+            *snapshot = stats_;
+        }
+        return true;
+    }
+
+    const size_t gate_bytes = pool_->gate_bytes_per_expert();
+    const size_t up_bytes = pool_->up_bytes_per_expert();
+    const size_t down_bytes = pool_->down_bytes_per_expert();
+    const auto * gate_data = (const uint8_t *) ggml_get_data(source_gate_);
+    const auto * up_data = (const uint8_t *) ggml_get_data(source_up_);
+    const auto * down_data = (const uint8_t *) ggml_get_data(source_down_);
+
+    struct upload_record {
+        int32_t expert;
+        uint32_t victim;
+    };
+    std::vector<upload_record> uploads;
+    uploads.reserve(misses.size());
+    for (const int32_t expert : misses) {
+        uint32_t victim = k_prime;
+        uint64_t oldest = std::numeric_limits<uint64_t>::max();
+        for (uint32_t slot = 0; slot < k_prime; ++slot) {
+            if (pinned[slot]) {
+                continue;
+            }
+            if (slot_to_expert_[slot] == slot_pool::SENTINEL_SLOT) {
+                victim = slot;
+                break;
+            }
+            if (frequency_decay_ > 0.0f) {
+                if (victim == k_prime ||
+                    slot_frequency_[slot] < slot_frequency_[victim] ||
+                    (slot_frequency_[slot] == slot_frequency_[victim] &&
+                     slot_last_use_[slot] < slot_last_use_[victim])) {
+                    victim = slot;
+                }
+            } else if (slot_last_use_[slot] < oldest) {
+                oldest = slot_last_use_[slot];
+                victim = slot;
+            }
+        }
+        if (victim == k_prime) {
+            return false;
+        }
+
+        const int32_t evicted = slot_to_expert_[victim];
+        if (evicted >= 0) {
+            lut[evicted] = slot_pool::SENTINEL_SLOT;
+        } else {
+            ++stats_.resident;
+        }
+
+        lut[expert] = (int32_t) victim;
+        slot_to_expert_[victim] = expert;
+        slot_last_use_[victim] = use_epoch;
+        slot_frequency_[victim] = 1.0f;
+        pinned[victim] = 1;
+        uploads.push_back({expert, victim});
+    }
+
+    if (batch_upload_ && uploads.size() <= staging_experts_) {
+        // Group adjacent destination slots into one Vulkan 2D upload. The
+        // source experts are gathered into stable scratch buffers because
+        // their logical ids are not contiguous. This preserves byte-exact
+        // weights and eviction decisions while reducing queue submissions.
+        std::sort(uploads.begin(), uploads.end(), [](const auto & lhs, const auto & rhs) {
+            return lhs.victim < rhs.victim;
+        });
+        uint8_t * gate_staging = staging_data_;
+        uint8_t * up_staging =
+            gate_staging + (size_t) staging_experts_ * gate_bytes;
+        uint8_t * down_staging =
+            up_staging + (size_t) staging_experts_ * up_bytes;
+        for (size_t i = 0; i < uploads.size(); ++i) {
+            const size_t expert = (size_t) uploads[i].expert;
+            std::memcpy(gate_staging + i * gate_bytes,
+                gate_data + expert * gate_bytes, gate_bytes);
+            std::memcpy(up_staging + i * up_bytes,
+                up_data + expert * up_bytes, up_bytes);
+            std::memcpy(down_staging + i * down_bytes,
+                down_data + expert * down_bytes, down_bytes);
+        }
+
+        for (size_t begin = 0; begin < uploads.size();) {
+            size_t end = begin + 1;
+            while (end < uploads.size() &&
+                   uploads[end].victim == uploads[end - 1].victim + 1) {
+                ++end;
+            }
+            const size_t copies = end - begin;
+            ggml_backend_tensor_set_2d_async(
+                upload_backend_, pool_->gate(0),
+                gate_staging + begin * gate_bytes,
+                (size_t) uploads[begin].victim * gate_bytes,
+                gate_bytes, copies, gate_bytes, gate_bytes);
+            ggml_backend_tensor_set_2d_async(
+                upload_backend_, pool_->up(0),
+                up_staging + begin * up_bytes,
+                (size_t) uploads[begin].victim * up_bytes,
+                up_bytes, copies, up_bytes, up_bytes);
+            ggml_backend_tensor_set_2d_async(
+                upload_backend_, pool_->down(0),
+                down_staging + begin * down_bytes,
+                (size_t) uploads[begin].victim * down_bytes,
+                down_bytes, copies, down_bytes, down_bytes);
+            stats_.weight_upload_calls += 3;
+            begin = end;
+        }
+    } else {
+        for (const auto & upload : uploads) {
+            const size_t expert = (size_t) upload.expert;
+            const size_t victim = (size_t) upload.victim;
+            ggml_backend_tensor_set_async(
+                upload_backend_, pool_->gate(0),
+                gate_data + expert * gate_bytes,
+                victim * gate_bytes, gate_bytes);
+            ggml_backend_tensor_set_async(
+                upload_backend_, pool_->up(0),
+                up_data + expert * up_bytes,
+                victim * up_bytes, up_bytes);
+            ggml_backend_tensor_set_async(
+                upload_backend_, pool_->down(0),
+                down_data + expert * down_bytes,
+                victim * down_bytes, down_bytes);
+            stats_.weight_upload_calls += 3;
+        }
+    }
+
+    // mul_mat_id must never observe SENTINEL_SLOT. Only selected logical ids
+    // are consumed, and those are guaranteed resident above; zero is used for
+    // all other LUT entries solely to keep the device tensor in range.
+    std::vector<int32_t> device_lut(n_logical, 0);
+    for (uint32_t expert = 0; expert < n_logical; ++expert) {
+        if (lut[expert] >= 0) {
+            device_lut[expert] = lut[expert];
+        }
+    }
+    ggml_backend_tensor_set_async(
+        upload_backend_, pool_->lut_gpu(0), device_lut.data(), 0,
+        device_lut.size() * sizeof(device_lut[0]));
+    ggml_backend_synchronize(upload_backend_);
+
+    stats_.upload_bytes += (uint64_t) misses.size() *
+        (gate_bytes + up_bytes + down_bytes);
+    ++stats_.upload_batches;
+    if (snapshot) {
+        *snapshot = stats_;
+    }
+    return true;
+}
+
+slot_pool * llama_neural_expert_cache::pool() const {
+    return pool_.get();
+}
+
+uint32_t llama_neural_expert_cache::slots() const {
+    return pool_ ? pool_->get_config().k_prime : 0;
+}
+
+uint32_t llama_neural_expert_cache::logical_experts() const {
+    return pool_ ? pool_->n_logical_experts() : 0;
+}
+
+bool llama_neural_expert_cache::batch_upload_enabled() const {
+    return batch_upload_;
+}
+
+llama_neural_expert_cache::stats llama_neural_expert_cache::get_stats() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return stats_;
+}
