+ggml_tensor * llama_model_qwen35moe::graph::build_layer_attn_kernel(
+        llm_graph_input_rs * inp,
+        ggml_tensor *        cur,
+        int                  il) {
+    const auto * mctx_cur = inp->mctx;
+    const int64_t n_seqs = ubatch.n_seqs;
+    const int64_t n_seq_tokens = ubatch.n_seq_tokens;
+    const int64_t kernel_dim = 128;
+    const int64_t kernel_heads = 32;
+    const int64_t donor_heads = 16;
+    const int64_t donor_kv_heads = 4;
+    const auto kv_head = mctx_cur->get_head();
+
+    GGML_ASSERT(n_seqs != 0);
+    GGML_ASSERT(ubatch.equal_seqs());
+    GGML_ASSERT(ubatch.n_tokens == n_seq_tokens * n_seqs);
+
+    // Donor Q is interleaved as [Q(256), gate(256)] for each of 16
+    // heads. Split every donor head into two 128-dimensional kernel heads.
+    ggml_tensor * q_gate = build_lora_mm(model.layers[il].wq, cur, model.layers[il].wq_s);
+    ggml_tensor * q_view = ggml_view_4d(
+        ctx0, q_gate, kernel_dim, 2, donor_heads, n_tokens,
+        q_gate->nb[0] * kernel_dim,
+        q_gate->nb[0] * kernel_dim * 4,
+        q_gate->nb[1],
+        0);
+    ggml_tensor * gate_view = ggml_view_4d(
+        ctx0, q_gate, kernel_dim, 2, donor_heads, n_tokens,
+        q_gate->nb[0] * kernel_dim,
+        q_gate->nb[0] * kernel_dim * 4,
+        q_gate->nb[1],
+        q_gate->nb[0] * kernel_dim * 2);
+    ggml_tensor * q = ggml_cont_4d(ctx0, q_view, kernel_dim, kernel_heads, n_seq_tokens, n_seqs);
+    ggml_tensor * output_gate = ggml_cont_4d(ctx0, gate_view, kernel_dim, kernel_heads, n_seq_tokens, n_seqs);
+
+    ggml_tensor * k = build_lora_mm(model.layers[il].wk, cur, model.layers[il].wk_s);
+    ggml_tensor * v = build_lora_mm(model.layers[il].wv, cur, model.layers[il].wv_s);
+    k = ggml_reshape_4d(ctx0, k, kernel_dim, donor_kv_heads, n_seq_tokens, n_seqs);
+    v = ggml_reshape_4d(ctx0, v, kernel_dim, donor_kv_heads, n_seq_tokens, n_seqs);
+    k = ggml_repeat_4d(ctx0, k, kernel_dim, kernel_heads, n_seq_tokens, n_seqs);
+    v = ggml_repeat_4d(ctx0, v, kernel_dim, kernel_heads, n_seq_tokens, n_seqs);
+
+    q = ggml_l2_norm(ctx0, q, hparams.f_norm_rms_eps);
+    k = ggml_l2_norm(ctx0, k, hparams.f_norm_rms_eps);
+
+    ggml_tensor * gate_scalar = ggml_view_4d(
+        ctx0, output_gate, 1, kernel_heads, n_seq_tokens, n_seqs,
+        output_gate->nb[1], output_gate->nb[2], output_gate->nb[3], 0);
+    gate_scalar = ggml_cont(ctx0, gate_scalar);
+    ggml_tensor * beta = ggml_sigmoid(ctx0, gate_scalar);
+    ggml_tensor * decay = ggml_neg(ctx0, ggml_softplus(ctx0, gate_scalar));
+
+    ggml_tensor * ssm_states_all = mctx_cur->get_s_l(il);
+    ggml_tensor * state = build_rs(inp, ssm_states_all, hparams.n_embd_s(), n_seqs);
+    state = ggml_reshape_4d(ctx0, state, kernel_dim, kernel_dim, kernel_heads, n_seqs);
+
+    ggml_tensor * semantic = mctx_cur->get_semantic_s_l(il);
+
+    auto kernel_result = build_delta_net(q, k, v, decay, beta, state, il);
+    ggml_tensor * output = kernel_result.first;
+    ggml_tensor * new_state = kernel_result.second;
+
+    // The slow state is read-only during inference and is consulted for every
+    // token. Keeping it outside the decaying working state prevents a new
+    // prompt from erasing a consolidated association before it can be read.
+    const char * raw_semantic_alpha = std::getenv("COLORLM_V4_SEMANTIC_ALPHA");
+    const float semantic_alpha = std::clamp(
+        raw_semantic_alpha ? (float) std::atof(raw_semantic_alpha) : 0.25f, 0.0f, 1.0f);
+    if (semantic != nullptr && semantic_alpha > 0.0f) {
+        semantic = ggml_reshape_4d(ctx0, semantic, kernel_dim, kernel_dim, kernel_heads, 1);
+        semantic = ggml_cont(ctx0, ggml_repeat(ctx0, semantic, state));
+
+        ggml_tensor * semantic_q = ggml_cont(ctx0, q);
+        semantic_q = ggml_scale(ctx0, semantic_q, 1.0f / std::sqrt((float) kernel_dim));
+        semantic_q = ggml_cont(ctx0, ggml_permute(ctx0, semantic_q, 0, 2, 1, 3));
+        ggml_tensor * semantic_output = ggml_mul_mat(ctx0, semantic, semantic_q);
+        semantic_output = ggml_cont(ctx0, ggml_permute(ctx0, semantic_output, 0, 2, 1, 3));
+        output = ggml_add(ctx0, output, ggml_scale(ctx0, semantic_output, semantic_alpha));
+        cb(semantic_output, "color_semantic_read", il);
+    }
+    cb(output, "color_kernel_output", il);
+    cb(new_state, "color_kernel_state", il);
+
+    ggml_build_forward_expand(gf,
+        ggml_cpy(ctx0, new_state,
+            ggml_view_2d(ctx0, ssm_states_all, hparams.n_embd_s(), n_seqs, ssm_states_all->nb[1],
+                kv_head * hparams.n_embd_s() * ggml_element_size(ssm_states_all))));
+
+    output = ggml_reshape_2d(ctx0, output, kernel_dim * kernel_heads, n_tokens);
+    output_gate = ggml_reshape_2d(ctx0, output_gate, kernel_dim * kernel_heads, n_tokens);
+    output = ggml_mul(ctx0, output, ggml_sigmoid(ctx0, output_gate));
+    output = build_lora_mm(model.layers[il].wo, output, model.layers[il].wo_s);
+    cb(output, "color_kernel_projected", il);
+    return output;
+}
