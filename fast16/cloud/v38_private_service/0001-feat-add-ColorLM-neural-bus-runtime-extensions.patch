+
+static std::string sha256_file(const std::filesystem::path & path) {
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) {
+        throw std::runtime_error("cannot open Neural Block file for SHA-256: " + path.string());
+    }
+    sha256_t context;
+    sha256_init(&context);
+    std::vector<unsigned char> buffer(8 * 1024 * 1024);
+    while (stream) {
+        stream.read(reinterpret_cast<char *>(buffer.data()), (std::streamsize) buffer.size());
+        const std::streamsize count = stream.gcount();
+        if (count > 0) {
+            sha256_update(&context, buffer.data(), (size_t) count);
+        }
+    }
+    if (!stream.eof()) {
+        throw std::runtime_error("failed while hashing Neural Block file: " + path.string());
+    }
+    std::array<unsigned char, SHA256_DIGEST_SIZE> digest {};
+    sha256_final(&context, digest.data());
+    std::ostringstream encoded;
+    encoded << std::hex << std::setfill('0');
+    for (unsigned char value : digest) {
+        encoded << std::setw(2) << (unsigned int) value;
+    }
+    return encoded.str();
+}
+
+static bool is_sha256(const std::string & value) {
+    return value.size() == SHA256_DIGEST_SIZE * 2 &&
+        std::all_of(value.begin(), value.end(), [](unsigned char c) {
+            return std::isxdigit(c) != 0;
+        });
+}
+
+static ggml_type parse_type(const std::string & value) {
+    if (value == "Q4_0") {
+        return GGML_TYPE_Q4_0;
+    }
+    if (value == "F32") {
+        return GGML_TYPE_F32;
+    }
+    if (value == "F16") {
+        return GGML_TYPE_F16;
+    }
+    throw std::runtime_error("unsupported Neural Block tensor dtype: " + value);
+}
+
+static std::filesystem::path checked_blob_path(
+        const std::filesystem::path & directory,
+        const std::string & file) {
+    const std::filesystem::path relative(file);
+    if (relative.empty() || relative.is_absolute() || relative.has_parent_path()) {
+        throw std::runtime_error("Neural Block weights file must be a basename");
+    }
+    return directory / relative;
+}
+
+} // namespace
+
+std::unique_ptr<llama_neural_block> llama_neural_block::load_qwen3next_q4(
+        const std::filesystem::path & directory,
+        ggml_backend_buffer_type_t buft,
+        const std::string & expected_manifest_sha256,
+        bool verify_weights_sha256,
+        ggml_backend_buffer_type_t experts_buft) {
+    if (!buft) {
+        return nullptr;
+    }
+    const std::filesystem::path manifest_path = directory / "block.json";
+    if (!expected_manifest_sha256.empty()) {
+        if (!is_sha256(expected_manifest_sha256) ||
+            sha256_file(manifest_path) != expected_manifest_sha256) {
+            throw std::runtime_error("Neural Block manifest SHA-256 mismatch");
+        }
+    }
+
+    std::ifstream manifest_stream(manifest_path);
+    if (!manifest_stream) {
+        throw std::runtime_error("Neural Block requires block.json");
+    }
+    const nlohmann::json manifest = nlohmann::json::parse(manifest_stream);
+    if (manifest.at("format").get<std::string>() != "colorlm-neural-block-runtime-v1" ||
+        !manifest.at("formal").get<bool>() ||
+        manifest.at("runtime_layout").get<std::string>() !=
+            "single-aligned-tensor-blob-v1" ||
+        manifest.at("alignment").get<uint64_t>() != 64) {
+        throw std::runtime_error("unsupported Neural Block runtime contract");
+    }
+    const auto & interface = manifest.at("interface");
+    const auto & attention = manifest.at("attention");
+    const auto & moe = manifest.at("moe");
+    const auto & target = manifest.at("target");
+    const std::string layer_type = attention.at("type").get<std::string>();
+    const bool recurrent = layer_type == "gated_deltanet";
+    const bool full_attention = layer_type == "full_attention";
+    const std::string expected_memory = recurrent
+        ? "independent-recurrent-state-required"
+        : "independent-sidecar-kv-required";
+    if ((!recurrent && !full_attention) ||
+        interface.at("input_width").get<int>() != 2048 ||
+        interface.at("output_width").get<int>() != 2048 ||
+        attention.at("query_heads").get<int>() != 16 ||
+        attention.at("kv_heads").get<int>() != 2 ||
+        attention.at("head_dim").get<int>() != 256 ||
+        attention.at("memory").get<std::string>() != expected_memory ||
+        moe.at("expert_count").get<int>() != 512 ||
+        moe.at("experts_per_token").get<int>() != 10 ||
+        moe.at("expert_width").get<int>() != 512 ||
+        target.at("base_hidden_width").get<int>() != 2048) {
+        throw std::runtime_error("Neural Block architecture mismatch");
+    }
+
+    const int source_layer = manifest.contains("source")
+        ? manifest.at("source").at("layer").get<int>()
+        : 47;
+    if (source_layer < 0 || source_layer >= 48) {
+        throw std::runtime_error("Neural Block source layer is outside Qwen3Next");
+    }
+    const int target_site = target.at("site").get<int>();
+    if (target_site < 0 || target_site >= 40) {
+        throw std::runtime_error("Neural Block target site is outside ColorLM");
+    }
+    const auto & tensor_records = manifest.at("tensors");
+    if (!tensor_records.is_array() ||
+        tensor_records.size() != manifest.at("tensor_count").get<size_t>() ||
+        tensor_records.size() != (recurrent ? 19 : 18)) {
+        throw std::runtime_error("Neural Block runtime tensor count does not match layer type");
+    }
+    const auto & weights = manifest.at("weights");
+    const std::string weights_sha256 = weights.at("sha256").get<std::string>();
+    if (!is_sha256(weights_sha256)) {
+        throw std::runtime_error("invalid Neural Block weights SHA-256");
+    }
+    const std::filesystem::path weights_path = checked_blob_path(
+        directory, weights.at("file").get<std::string>());
+    const uint64_t weights_bytes = weights.at("bytes").get<uint64_t>();
+    std::error_code error;
+    if (std::filesystem::file_size(weights_path, error) != weights_bytes || error) {
+        throw std::runtime_error("Neural Block weights size mismatch");
+    }
+    if (verify_weights_sha256 && sha256_file(weights_path) != weights_sha256) {
+        throw std::runtime_error("Neural Block weights SHA-256 mismatch");
+    }
+
+    auto block = std::unique_ptr<llama_neural_block>(new llama_neural_block());
+    block->source_layer_ = source_layer;
+    block->target_site_ = target_site;
+    block->expert_count_ = moe.at("expert_count").get<int>();
+    block->experts_per_token_ = moe.at("experts_per_token").get<int>();
+    block->recurrent_ = recurrent;
+    if (!experts_buft) {
+        experts_buft = buft;
+    }
+    ggml_init_params params = {
+        /*.mem_size   =*/ (tensor_records.size() + 1) * ggml_tensor_overhead() + 64 * 1024,
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    block->ctx_ = ggml_init(params);
+    block->experts_ctx_ = ggml_init(params);
+    if (!block->ctx_ || !block->experts_ctx_) {
+        return nullptr;
+    }
+
+    std::vector<tensor_load_record> loads;
+    loads.reserve(tensor_records.size());
+    uint64_t previous_end = 0;
+    for (size_t index = 0; index < tensor_records.size(); ++index) {
+        const auto & record = tensor_records.at(index);
+        const std::string name = record.at("name").get<std::string>();
+        const std::string digest = record.at("sha256").get<std::string>();
+        const std::vector<int64_t> shape = record.at("ggml_shape").get<std::vector<int64_t>>();
+        const uint64_t offset = record.at("offset").get<uint64_t>();
+        const uint64_t bytes = record.at("bytes").get<uint64_t>();
+        if (name.empty() || !is_sha256(digest) || shape.empty() || shape.size() > 4 ||
+            std::any_of(shape.begin(), shape.end(), [](int64_t value) { return value <= 0; }) ||
+            offset % 64 != 0 || offset < previous_end ||
+            bytes > weights_bytes || offset > weights_bytes - bytes) {
+            throw std::runtime_error("invalid Neural Block tensor record: " + name);
+        }
+        const bool expert_bank = name.find(".mlp.experts.") != std::string::npos;
+        ggml_context * tensor_ctx = expert_bank ? block->experts_ctx_ : block->ctx_;
+        ggml_tensor * tensor = ggml_new_tensor(
+            tensor_ctx, parse_type(record.at("dtype").get<std::string>()),
+            (int) shape.size(), shape.data());
+        if (ggml_nbytes(tensor) != bytes) {
+            throw std::runtime_error("Neural Block tensor byte mismatch: " + name);
+        }
+        if (!block->tensors_.emplace(name, tensor).second) {
+            throw std::runtime_error("duplicate Neural Block tensor: " + name);
+        }
+        const std::string runtime_name = "neural_block." + std::to_string(index);
+        ggml_set_name(tensor, runtime_name.c_str());
+        loads.push_back({tensor, offset, bytes});
+        previous_end = offset + bytes;
+    }
+    if (block->tensors_.size() != tensor_records.size()) {
+        throw std::runtime_error("Neural Block tensor map size mismatch");
+    }
+
+    const std::string prefix = "model.layers." + std::to_string(source_layer) + ".";
+    std::vector<std::string> required = {
+        prefix + "input_layernorm.weight",
+        prefix + "post_attention_layernorm.weight",
+        prefix + "mlp.gate.weight",
+        prefix + "mlp.shared_expert_gate.weight",
+        prefix + "mlp.shared_expert.gate_proj.weight",
+        prefix + "mlp.shared_expert.up_proj.weight",
+        prefix + "mlp.shared_expert.down_proj.weight",
+        prefix + "mlp.experts.gate_proj.weight",
+        prefix + "mlp.experts.up_proj.weight",
+        prefix + "mlp.experts.down_proj.weight",
+        "colorlm.neural_block.transport_in.weight",
+        "colorlm.neural_block.transport_out.weight",
+    };
+    if (recurrent) {
+        required.insert(required.end(), {
+            prefix + "linear_attn.A_log",
+            prefix + "linear_attn.conv1d.weight",
+            prefix + "linear_attn.dt_bias",
+            prefix + "linear_attn.in_proj_ba.weight",
+            prefix + "linear_attn.in_proj_qkvz.weight",
+            prefix + "linear_attn.norm.weight",
+            prefix + "linear_attn.out_proj.weight",
+        });
+    } else {
+        required.insert(required.end(), {
+            prefix + "self_attn.q_proj.weight",
+            prefix + "self_attn.k_proj.weight",
+            prefix + "self_attn.v_proj.weight",
+            prefix + "self_attn.o_proj.weight",
+            prefix + "self_attn.q_norm.weight",
+            prefix + "self_attn.k_norm.weight",
+        });
+    }
+    for (const auto & name : required) {
+        if (block->tensors_.count(name) != 1) {
+            throw std::runtime_error("Neural Block missing required tensor: " + name);
+        }
+    }
+    block->buffer_ = ggml_backend_alloc_ctx_tensors_from_buft(block->ctx_, buft);
+    block->experts_buffer_ = ggml_backend_alloc_ctx_tensors_from_buft(
+        block->experts_ctx_, experts_buft);
+    if (!block->buffer_ || !block->experts_buffer_) {
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(block->buffer_, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_buffer_set_usage(
+        block->experts_buffer_, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    std::ifstream blob(weights_path, std::ios::binary);
+    if (!blob) {
+        throw std::runtime_error("cannot open Neural Block weights blob");
+    }
+    uint64_t max_bytes = 0;
+    for (const auto & record : loads) {
+        max_bytes = std::max(max_bytes, record.bytes);
+    }
+    if (max_bytes > (uint64_t) std::numeric_limits<size_t>::max()) {
+        throw std::runtime_error("Neural Block tensor exceeds addressable memory");
+    }
+    std::vector<uint8_t> scratch((size_t) max_bytes);
+    for (const auto & record : loads) {
+        blob.seekg((std::streamoff) record.offset, std::ios::beg);
+        if (!blob.read(reinterpret_cast<char *>(scratch.data()), (std::streamsize) record.bytes)) {
+            throw std::runtime_error("failed to read Neural Block tensor from blob");
+        }
+        ggml_backend_tensor_set(record.tensor, scratch.data(), 0, (size_t) record.bytes);
+    }
+    LLAMA_LOG_INFO(
+        "ColorLM Neural Block loaded: L%d -> site %d, hot %.2f MiB on %s, experts %.2f MiB on %s, top-k=%d\n",
+        block->source_layer_, block->target_site_,
+        ggml_backend_buffer_get_size(block->buffer_) / 1024.0 / 1024.0,
+        ggml_backend_buffer_name(block->buffer_),
+        ggml_backend_buffer_get_size(block->experts_buffer_) / 1024.0 / 1024.0,
+        ggml_backend_buffer_name(block->experts_buffer_),
+        block->experts_per_token_);
+    return block;
+}
+
+llama_neural_block::~llama_neural_block() {
+    if (experts_buffer_) {
+        ggml_backend_buffer_free(experts_buffer_);
+    }
+    if (buffer_) {
+        ggml_backend_buffer_free(buffer_);
+    }
+    if (ctx_) {
+        ggml_free(ctx_);
+    }
+    if (experts_ctx_) {
+        ggml_free(experts_ctx_);
+    }
+}
+
+ggml_tensor * llama_neural_block::tensor(const std::string & source_name) const {
+    const auto found = tensors_.find(source_name);
+    return found == tensors_.end() ? nullptr : found->second;
+}
+
+ggml_tensor * llama_neural_block::experts_gate() const {
+    return tensor("model.layers." + std::to_string(source_layer_) + ".mlp.experts.gate_proj.weight");
+}
+
+ggml_tensor * llama_neural_block::experts_up() const {
+    return tensor("model.layers." + std::to_string(source_layer_) + ".mlp.experts.up_proj.weight");
+}
+
+ggml_tensor * llama_neural_block::experts_down() const {
+    return tensor("model.layers." + std::to_string(source_layer_) + ".mlp.experts.down_proj.weight");
+}
+
+int llama_neural_block::source_layer() const {
+    return source_layer_;
+}
+
+int llama_neural_block::target_site() const {
+    return target_site_;
+}
+
+int llama_neural_block::expert_count() const {
+    return expert_count_;
+}
+
+int llama_neural_block::experts_per_token() const {
+    return experts_per_token_;
+}
+
+bool llama_neural_block::is_recurrent() const {
+    return recurrent_;
+}
+
+size_t llama_neural_block::weight_bytes() const {
+    return (buffer_ ? ggml_backend_buffer_get_size(buffer_) : 0) +
+        (experts_buffer_ ? ggml_backend_buffer_get_size(experts_buffer_) : 0);
+}
+
+const char * llama_neural_block::buffer_name() const {
+    return buffer_ ? ggml_backend_buffer_name(buffer_) : "none";
+}
