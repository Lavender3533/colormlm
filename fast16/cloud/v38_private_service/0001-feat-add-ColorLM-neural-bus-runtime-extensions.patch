new file mode 100644
index 0000000..7508939
--- /dev/null
+++ b/src/llama-slot-pool.h
@@ -0,0 +1,175 @@
+// MoE expert slot pool.
+//
+// Manages a fixed-size VRAM region that can hold K' < N_EXPERTS expert
+// weights at a time. The graph computes MUL_MAT_ID against these slot
+// tensors (instead of the packed CPU tensor) using remapped slot indices.
+//
+// Ownership: one slot_pool per (model, context) lives for the inference
+// session. Bytes are staged in via ggml_backend_tensor_set from the
+// packed CPU expert tensor.
+//
+// This file is part of the SSD-offloading runtime added by the project,
+// not upstream llama.cpp.
+
+#pragma once
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+class slot_pool {
+public:
+    struct config {
+        uint32_t n_layers;
+        uint32_t k_prime;       // slots per layer
+        int64_t  n_embd;        // expert in-dim
+        int64_t  n_ff_exp;      // expert hidden-dim
+        ggml_type gate_type;    // gate weight dtype (e.g. Q4_K for Q4_K_M)
+        ggml_type up_type;      // up weight dtype (typically same as gate)
+        ggml_type down_type;    // down weight dtype (e.g. Q6_K for Q4_K_M — different from gate/up!)
+        ggml_backend_buffer_type_t buft; // VRAM buft (e.g. Vulkan)
+    };
+
+    // Allocate the pool. Returns nullptr on failure.
+    static std::unique_ptr<slot_pool> create(const config & cfg);
+
+    ~slot_pool();
+
+    // Per-layer slot tensors. Caller passes their `il` index.
+    // Shape is {n_embd, n_ff_exp, k_prime} for gate/up,
+    //          {n_ff_exp, n_embd, k_prime} for down.
+    ggml_tensor * gate(uint32_t layer) const;
+    ggml_tensor * up  (uint32_t layer) const;
+    ggml_tensor * down(uint32_t layer) const;
+
+    // Stage one expert into a slot. The src pointers must point at the
+    // first byte of that expert's gate/up/down packed CPU tensor data
+    // (i.e. caller already computed offset = expert_idx × per_expert_bytes).
+    // Sizes must equal the per-expert byte size for that tensor kind.
+    //
+    // Synchronous: returns when bytes are committed to VRAM.
+    void stage(uint32_t layer, uint32_t slot_idx,
+               const void * gate_src, size_t gate_bytes,
+               const void * up_src,   size_t up_bytes,
+               const void * down_src, size_t down_bytes);
+
+    // Static one-shot prestage: take packed CPU tensors {gate,up,down} for one
+    // layer (with their full data ptrs and shape `[n_embd, n_ff_exp, n_logical]`),
+    // copy the first k_prime experts into the layer's slots, and fill the LUT
+    // accordingly. Logical IDs 0..k_prime-1 → slots 0..k_prime-1; rest = SENTINEL.
+    //
+    // Returns true on success. Does not call lut_upload — caller should after
+    // staging all layers (cheaper to batch).
+    bool prestage_first_k(uint32_t layer,
+                          const void * gate_packed_data,
+                          const void * up_packed_data,
+                          const void * down_packed_data);
+
+    // Per-expert byte sizes (computed from config + ggml type).
+    size_t gate_bytes_per_expert() const;
+    size_t up_bytes_per_expert  () const;
+    size_t down_bytes_per_expert() const;
+
+    // Total VRAM occupied by all pool tensors (for accounting).
+    size_t total_vram_bytes() const;
+
+    const config & get_config() const;
+
+    // Thread-local active pool — set by the host (collector / inference loop)
+    // before invoking llama_decode, so per-arch graph builders can locate it
+    // without plumbing it through llm_graph_params (which is shared upstream code).
+    static void          set_active(slot_pool * pool);
+    static slot_pool *   get_active();
+
+    // Per-layer logical → slot LUT, size = n_experts entries (i32).
+    // Returns the pointer the host should fill for the current step.
+    // Out-of-pool experts must be marked with `SENTINEL_SLOT` (= -1).
+    static constexpr int32_t SENTINEL_SLOT = -1;
+    int32_t * lut_host(uint32_t layer);
+
+    // GPU-resident LUT tensor for a layer, shape [1, n_logical_experts] i32.
+    // Returns nullptr if set_n_logical_experts() has not been called yet.
+    // The graph builder uses this directly as the source of get_rows.
+    ggml_tensor * lut_gpu(uint32_t layer) const;
+
+    // Upload the host LUT for one layer to its GPU tensor (synchronous).
+    // Call after editing lut_host(layer).
+    void lut_upload(uint32_t layer);
+
+    // Upload all layers' LUTs in one shot.
+    void lut_upload_all();
+
+    // Number of logical experts the LUT must cover.
+    uint32_t n_logical_experts() const;
+
+    // Setter for n_experts (we don't know it at create time — packed model
+    // is loaded later). Allocates LUT tensors on the same VRAM buft.
+    // Call once before any graph is built.
+    void set_n_logical_experts(uint32_t n);
+
+    // ─── Dynamic observation + restage (project-local; task #11) ───────────
+    //
+    // Observation accumulates per-layer expert activation counts. The custom op
+    // hook in qwen3moe.cpp's build_moe_ffn_b1 calls add_observation each time
+    // selected_experts is computed.
+    //
+    // After enough observations accumulate (>= observation_threshold), the next
+    // graph build triggers restage_from_observations, which picks the new top-K'
+    // experts per layer and re-stages slot pool contents.
+
+    void add_observation(uint32_t layer, const int32_t * expert_ids, int n);
+
+    // True when there are unused observations exceeding threshold.
+    bool has_pending_restage() const;
+
+    // Re-stage every layer using the current per-layer observation counts.
+    // `model_layers_data[il]` holds {gate_data, up_data, down_data} pointers
+    // (same packed CPU pointers passed to prestage at init).
+    // Returns true on success.
+    struct layer_data {
+        const void * gate;
+        const void * up;
+        const void * down;
+    };
+    bool restage_from_observations(const std::vector<layer_data> & layers,
+                                   uint32_t n_logical_experts);
+
+    void clear_observations();
+
+    // Total observations accumulated across all layers (diagnostic)
+    uint64_t total_observations() const;
+
+    // Tunable: how many observations needed before triggering restage.
+    // Default = n_layers * 16 (i.e., ~16 tokens worth of prefill).
+    uint64_t observation_threshold = 0;
+    // ────────────────────────────────────────────────────────────────────────
+
+private:
+    slot_pool() = default;
+
+    config cfg_{};
+    ggml_context        * ctx_       = nullptr;     // slot pool tensors
+    ggml_backend_buffer_t buf_       = nullptr;
+    ggml_context        * lut_ctx_   = nullptr;     // separate ctx for LUT tensors
+    ggml_backend_buffer_t lut_buf_   = nullptr;
+    // Tensors arranged as: [layer 0 gate][layer 0 up][layer 0 down][layer 1 gate]...
+    // We keep flat arrays of size n_layers each.
+    ggml_tensor       ** gate_       = nullptr;
+    ggml_tensor       ** up_         = nullptr;
+    ggml_tensor       ** down_       = nullptr;
+    ggml_tensor       ** lut_t_      = nullptr;   // per-layer GPU lut tensor [1, n_logical] i32
+
+    // Host-side LUT buffer: n_layers × n_logical_experts i32s.
+    // Filled by host before each step; uploaded into graph context on demand.
+    uint32_t              n_logical_ = 0;
+    int32_t             * lut_host_  = nullptr;
+
+    // Dynamic observation: per-layer expert activation counts.
+    // counts_[layer * n_logical + expert] = count
+    std::vector<uint32_t> obs_counts_;
+    uint64_t              obs_total_ = 0;
+    uint64_t              obs_total_at_last_restage_ = 0;
+};
