+// =============================================================================
+// B1: slot pool integration (project-local, not upstream).
+// On first graph build, if MOE_B1=1 in env, allocate a slot pool sized for the
+// loaded model and statically prestage the first K' experts of each layer.
+// Subsequent graph builds use the slot-pool MoE path: LUT-remapped MUL_MAT_ID
+// against VRAM slots instead of MUL_MAT_ID against the packed CPU tensor.
+//
+// First-cut policy: STATIC stage of experts {0..K'-1}. Hit rate will be poor
+// (~K'/n_expert if uniform). Real predictor-driven staging is a later step.
+// =============================================================================
+
+namespace {
+
+std::unique_ptr<slot_pool> g_pool;
+std::mutex                 g_pool_mutex;
+bool                       g_pool_init_failed = false;
+
+std::vector<slot_pool::layer_data> g_layer_data;
+
+#ifdef MOE_SCHEDULER_AVAILABLE
+MoeScheduler * g_rust_scheduler = nullptr;
+static uint32_t g_token_counter = 0;
+static uint32_t g_snapshot_interval = 500;
+
+struct PendingCmd {
+    uint16_t action;
+    uint16_t layer;
+    uint16_t expert;
+    uint16_t source_tier;
+};
+static std::mutex g_cmd_mutex;
+static std::vector<PendingCmd> g_pending_cmds;
+#endif
+
+// LRU eviction state for slot pool.
+// g_slot_last_use[layer * k_prime + slot] = monotonic tick when slot was last
+// touched by router selection. Eviction picks the slot with smallest tick.
+// Initialized lazily in observe callback (slot_pool is created after model load).
+static std::vector<uint64_t> g_slot_last_use;
+static std::atomic<uint64_t> g_lru_tick{0};
+static std::mutex g_lru_mutex;
+
+// Parse our MOEMTRX binary format (predictor::format::save layout) and return
+// row_totals[layer][expert] = how often `expert` was the prev-layer activator
+// at `layer` (across our training corpus). This is exactly the per-layer
+// activation frequency we want for static prestage.
+//
+// Format (little-endian):
+//   "MOEMTRX\0"  8B
+//   version u32
+//   n_layers u16, n_experts u16
+//   total_obs u64
+//   reserved 8B
+//   counts[n_layers * n_experts * n_experts] u32   ← skipped
+//   row_totals[n_layers * n_experts] u32           ← read
+//   global_freq[n_experts] u32                     ← skipped
+bool load_matrix_row_totals(const char * path,
+                            uint16_t expected_n_layers,
+                            uint16_t expected_n_experts,
+                            std::vector<uint32_t> & row_totals_out) {
+    FILE * f = fopen(path, "rb");
+    if (!f) {
+        fprintf(stderr, "[MOE_B1] cannot open matrix file %s\n", path);
+        return false;
+    }
+    char magic[8];
+    if (fread(magic, 1, 8, f) != 8 || memcmp(magic, "MOEMTRX\0", 8) != 0) {
+        fprintf(stderr, "[MOE_B1] bad magic in %s (not a MOEMTRX matrix)\n", path);
+        fclose(f);
+        return false;
+    }
+    uint32_t version = 0;
+    uint16_t n_layers = 0, n_experts = 0;
+    uint64_t total_obs = 0;
+    char reserved[8] = {0};
+    fread(&version,   4, 1, f);
+    fread(&n_layers,  2, 1, f);
+    fread(&n_experts, 2, 1, f);
+    fread(&total_obs, 8, 1, f);
+    fread(reserved,   8, 1, f);
+
+    if (n_layers != expected_n_layers || n_experts != expected_n_experts) {
+        fprintf(stderr, "[MOE_B1] matrix dim mismatch: file %ux%u vs model %ux%u\n",
+                n_layers, n_experts, expected_n_layers, expected_n_experts);
+        fclose(f);
+        return false;
+    }
+
+    // Skip counts table
+    const long long counts_bytes = (long long) n_layers * n_experts * n_experts * 4;
+    if (fseek(f, counts_bytes, SEEK_CUR) != 0) {
+        fprintf(stderr, "[MOE_B1] failed seek past counts in %s\n", path);
+        fclose(f);
+        return false;
+    }
+
+    row_totals_out.resize((size_t) n_layers * n_experts);
+    const size_t want = row_totals_out.size();
+    const size_t got  = fread(row_totals_out.data(), 4, want, f);
+    fclose(f);
+    if (got != want) {
+        fprintf(stderr, "[MOE_B1] truncated row_totals (wanted %zu, got %zu)\n", want, got);
+        return false;
+    }
+
+    fprintf(stderr, "[MOE_B1] loaded matrix from %s (n_layers=%u n_experts=%u total_obs=%llu)\n",
+            path, n_layers, n_experts, (unsigned long long) total_obs);
+    return true;
+}
+
+// Pick the K' expert ids with highest row_totals at this layer (descending).
+// Tie-break: lower id wins. Returns IDs unique and within [0, n_experts).
+std::vector<uint32_t> pick_top_k_experts(const std::vector<uint32_t> & row_totals,
+                                         uint32_t layer,
+                                         uint32_t n_experts,
+                                         uint32_t k_prime) {
+    std::vector<std::pair<uint32_t, uint32_t>> ranked;  // (freq, id)
+    ranked.reserve(n_experts);
+    for (uint32_t e = 0; e < n_experts; ++e) {
+        ranked.emplace_back(row_totals[(size_t) layer * n_experts + e], e);
+    }
+    // Sort: freq descending, then id ascending
+    std::sort(ranked.begin(), ranked.end(),
+              [](const std::pair<uint32_t,uint32_t> & a, const std::pair<uint32_t,uint32_t> & b){
+                  if (a.first != b.first) return a.first > b.first;
+                  return a.second < b.second;
+              });
+    std::vector<uint32_t> out;
+    out.reserve(k_prime);
+    for (uint32_t i = 0; i < k_prime && i < (uint32_t) ranked.size(); ++i) {
+        out.push_back(ranked[i].second);
+    }
+    return out;
+}
+
+// ─── Dynamic prestage observer: ggml custom op hook ─────────────────────────
+//
+// Runs as a side-effect during graph compute. Reads the selected_experts
+// tensor (CPU-side) and feeds counts to slot_pool.
+// userdata = (uintptr_t) layer index, no allocation needed.
+void observe_selected_experts_cb(struct ggml_tensor * dst,
+                                 const struct ggml_tensor * a,
+                                 int ith, int /*nth*/, void * userdata) {
+    if (ith != 0) return;
+    if (!a || !a->data) return;
+
+    const uint32_t layer = (uint32_t) (uintptr_t) userdata;
+    const int n_used   = (int) a->ne[0];
+    const int n_tokens = (int) a->ne[1];
+    const int32_t * data = (const int32_t *) a->data;
+
+    // Hit rate: count expert selections that hit the current pool LUT.
+    // lut[e] != 0 means e is mapped to a non-zero slot (definitely in pool).
+    // lut[0] == 0 with e == 0 is also a hit (expert 0 legitimately in slot 0).
+    // Any other lut[e] == 0 is a fallback miss.
+    // Also touch LRU for every hit slot so eviction can avoid recently-used slots.
+    {
+        slot_pool * pool = slot_pool::get_active();
+        if (pool) {
+            const auto & cfg = pool->get_config();
+            const uint32_t k_prime = cfg.k_prime;
+            const uint32_t n_layers = cfg.n_layers;
+            const int32_t * lut = pool->lut_host(layer);
+            static std::atomic<uint64_t> total_obs{0};
+            static std::atomic<uint64_t> hit_obs{0};
+            uint64_t local_total = 0, local_hit = 0;
+
+            // Lazy init LRU array (race-tolerant — init happens at first observation,
+            // any duplicate writes set the same value).
+            {
+                std::lock_guard<std::mutex> lk(g_lru_mutex);
+                if (g_slot_last_use.size() != (size_t) n_layers * k_prime) {
+                    g_slot_last_use.assign((size_t) n_layers * k_prime, 0);
+                }
+            }
+            const uint64_t tick = g_lru_tick.fetch_add(1) + 1;
+            for (int t = 0; t < n_tokens; ++t) {
+                for (int i = 0; i < n_used; ++i) {
+                    const int32_t e = data[(size_t) t * n_used + i];
+                    ++local_total;
+                    if (lut[e] != 0 || e == 0) {
+                        ++local_hit;
+                        const int32_t slot = lut[e]; // hit, so lut[e] is the real slot (0 only for e==0)
+                        if (slot >= 0 && (uint32_t) slot < k_prime) {
+                            g_slot_last_use[(size_t) layer * k_prime + slot] = tick;
+                        }
+                    }
+                }
+            }
+            uint64_t tot = total_obs.fetch_add(local_total) + local_total;
+            uint64_t hit = hit_obs.fetch_add(local_hit) + local_hit;
+            if ((tot / 1024) != ((tot - local_total) / 1024)) {
+                fprintf(stderr, "[HIT] %.1f%% (%llu/%llu)\n",
+                        100.0 * (double) hit / (double) tot,
+                        (unsigned long long) hit, (unsigned long long) tot);
+            }
+        }
+    }
+
+#ifdef MOE_SCHEDULER_AVAILABLE
+    // MOE_NO_DYNAMIC=1 disables scheduler-driven prefetch entirely (matrix
+    // prestage only). Useful for isolating prestage vs scheduler quality.
+    static const bool no_dynamic = []() {
+        const char * e = getenv("MOE_NO_DYNAMIC");
+        return e && e[0] != '0';
+    }();
+    if (g_rust_scheduler && !no_dynamic) {
+        uint16_t cmd_buf[256 * 4];
+        for (int t = 0; t < n_tokens; ++t) {
+            uint16_t expert_ids[16];
+            int n = std::min(n_used, 16);
+            for (int i = 0; i < n; ++i) {
+                expert_ids[i] = (uint16_t) data[(size_t) t * n_used + i];
+            }
+            size_t n_cmds = moe_scheduler_observe_and_predict(
+                g_rust_scheduler, g_token_counter, (uint16_t) layer,
+                expert_ids, (size_t) n, cmd_buf, 256);
+            if (n_cmds > 0) {
+                std::lock_guard<std::mutex> lk(g_cmd_mutex);
+                for (size_t i = 0; i < n_cmds; ++i) {
+                    g_pending_cmds.push_back({
+                        cmd_buf[i * 4 + 0], cmd_buf[i * 4 + 1],
+                        cmd_buf[i * 4 + 2], cmd_buf[i * 4 + 3]
+                    });
+                }
+            }
+        }
+        g_token_counter++;
+        if (g_token_counter % g_snapshot_interval == 0) {
+            moe_scheduler_promote_snapshot(g_rust_scheduler);
+        }
+    } else if (!no_dynamic)
+#else
+    if (true)
+#endif
+    {
+        slot_pool * pool = slot_pool::get_active();
+        if (!pool) return;
+        for (int t = 0; t < n_tokens; ++t) {
+            pool->add_observation(layer, data + (size_t) t * n_used, n_used);
+        }
+    }
+
+    if (dst && dst->data) {
+        std::memset(dst->data, 0, ggml_nbytes(dst));
+    }
+}
+
+ggml_backend_buffer_type_t pick_gpu_buft() {
+    for (int i = 0; i < (int) ggml_backend_dev_count(); ++i) {
+        auto * d = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(d) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            return ggml_backend_dev_buffer_type(d);
+        }
+    }
+    return nullptr;
+}
+
+void try_init_slot_pool(const llama_model & model) {
+    const char * env = getenv("MOE_B1");
+    if (!env || env[0] == '0') { g_pool_init_failed = true; return; }
+
+    auto & h = model.hparams;
+    const int64_t n_layer    = h.n_layer;
+    const int64_t n_expert   = h.n_expert;
+    const int64_t n_embd     = h.n_embd;
+    const int64_t n_ff_exp   = h.n_ff_exp ? h.n_ff_exp : (h.n_ff(0) / h.n_expert_used);
+
+    if (n_expert == 0 || n_layer == 0) { g_pool_init_failed = true; return; }
+
+    const char * env_kp = getenv("MOE_B1_K");
+    uint32_t k_prime = env_kp ? (uint32_t) atoi(env_kp) : 16;
+    if (k_prime == 0 || k_prime > (uint32_t) n_expert) k_prime = (uint32_t) n_expert;
+
+    // Need an expert tensor to determine ggml type and read packed bytes.
+    // Use layer 0 as the canonical reference.
+    const auto & l0 = model.layers[0];
+    if (!l0.ffn_gate_exps || !l0.ffn_up_exps || !l0.ffn_down_exps) {
+        fprintf(stderr, "[MOE_B1] layer 0 expert tensors missing — abort init\n");
+        g_pool_init_failed = true;
+        return;
+    }
+    if (!ggml_get_data(l0.ffn_gate_exps)) {
+        fprintf(stderr, "[MOE_B1] expert tensor data NULL — model not loaded yet, retry next call\n");
+        return;
+    }
+    // Per-tensor types — Q4_K_M models commonly mix Q4_K (gate/up) and Q6_K (down).
+    const ggml_type gate_type = l0.ffn_gate_exps->type;
+    const ggml_type up_type   = l0.ffn_up_exps->type;
+    const ggml_type down_type = l0.ffn_down_exps->type;
+
+    auto buft = pick_gpu_buft();
+    if (getenv("MOE_POOL_CPU")) {
+        // Diagnostic: force slot pool onto CPU buft to test if Vulkan mul_mat_id
+        // on our slot tensors is the source of garbage output.
+        for (int i = 0; i < (int) ggml_backend_dev_count(); ++i) {
+            auto * d = ggml_backend_dev_get(i);
+            if (ggml_backend_dev_type(d) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+                buft = ggml_backend_dev_buffer_type(d);
+                fprintf(stderr, "[MOE_B1] MOE_POOL_CPU=1, forcing slot pool onto CPU buft\n");
+                break;
+            }
+        }
+    }
+    if (!buft) {
+        fprintf(stderr, "[MOE_B1] no GPU buft found — abort init\n");
+        g_pool_init_failed = true;
+        return;
+    }
+
+    slot_pool::config cfg;
+    cfg.n_layers  = (uint32_t) n_layer;
+    cfg.k_prime   = k_prime;
+    cfg.n_embd    = n_embd;
+    cfg.n_ff_exp  = n_ff_exp;
+    cfg.gate_type = gate_type;
+    cfg.up_type   = up_type;
+    cfg.down_type = down_type;
+    cfg.buft      = buft;
+
+    fprintf(stderr, "[MOE_B1] allocating slot pool: %lld layers × K'=%u (n_expert=%lld) on %s "
+                    "(gate=%s up=%s down=%s)\n",
+            (long long) n_layer, k_prime, (long long) n_expert, ggml_backend_buft_name(buft),
+            ggml_type_name(gate_type), ggml_type_name(up_type), ggml_type_name(down_type));
+
+    auto pool = slot_pool::create(cfg);
+    if (!pool) {
+        fprintf(stderr, "[MOE_B1] slot_pool::create failed\n");
+        g_pool_init_failed = true;
+        return;
+    }
+    pool->set_n_logical_experts((uint32_t) n_expert);
+    fprintf(stderr, "[MOE_B1] pool allocated: %.2f MB VRAM\n",
+            pool->total_vram_bytes() / (1024.0 * 1024.0));
+
+    // Decide which experts to prestage per layer:
+    //   - if MOE_MATRIX_PATH points to a valid MOEMTRX file, use top-K' by
+    //     row_totals[layer] (data-informed prestage)
+    //   - otherwise fall back to {0..K'-1} (Session 2 default)
+    const char * matrix_path = getenv("MOE_MATRIX_PATH");
+    std::vector<uint32_t> row_totals;
+    bool use_matrix = false;
+    if (matrix_path && *matrix_path) {
+        use_matrix = load_matrix_row_totals(matrix_path,
+                                            (uint16_t) n_layer, (uint16_t) n_expert,
+                                            row_totals);
+    }
+    if (!use_matrix) {
+        fprintf(stderr, "[MOE_B1] no matrix loaded — falling back to first-K' static prestage\n");
+    }
+
+    const size_t gate_bytes = pool->gate_bytes_per_expert();
+    const size_t up_bytes   = pool->up_bytes_per_expert();
+    const size_t down_bytes = pool->down_bytes_per_expert();
+
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & ly = model.layers[il];
+        if (!ly.ffn_gate_exps || !ly.ffn_up_exps || !ly.ffn_down_exps) {
+            fprintf(stderr, "[MOE_B1] layer %d missing expert tensors\n", il);
+            g_pool_init_failed = true; return;
+        }
+        const void * gp = ggml_get_data(ly.ffn_gate_exps);
+        const void * up = ggml_get_data(ly.ffn_up_exps);
+        const void * dp = ggml_get_data(ly.ffn_down_exps);
+        if (!gp || !up || !dp) {
+            fprintf(stderr, "[MOE_B1] layer %d expert tensor data NULL\n", il);
+            g_pool_init_failed = true; return;
+        }
+
+        if (use_matrix) {
+            std::vector<uint32_t> hot = pick_top_k_experts(row_totals,
+                                                           (uint32_t) il,
+                                                           (uint32_t) n_expert,
+                                                           k_prime);
+
+            // LUT init: any expert NOT in our top-K' falls back to slot 0
+            // (its hot expert), instead of SENTINEL=-1 (which would feed
+            // negative indices into MUL_MAT_ID and read out-of-bounds → garbage).
+            // This sacrifices correctness for the missed experts (~30% of router
+            // calls when K'=40) but keeps output coherent. True fix needs
+            // dynamic per-prompt re-prestage (task #11).
+            int32_t * lut = pool->lut_host((uint32_t) il);
+            for (int64_t e = 0; e < n_expert; ++e) lut[e] = 0;  // fallback to slot 0
+
+            for (uint32_t i = 0; i < (uint32_t) hot.size(); ++i) {
+                const uint32_t expert_id = hot[i];
+                const char * g = (const char *) gp + (size_t) expert_id * gate_bytes;
+                const char * u = (const char *) up + (size_t) expert_id * up_bytes;
+                const char * d = (const char *) dp + (size_t) expert_id * down_bytes;
+                pool->stage((uint32_t) il, i,
+                            g, gate_bytes, u, up_bytes, d, down_bytes);
+                lut[expert_id] = (int32_t) i;  // hit experts get correct slot
+            }
+        } else {
+            pool->prestage_first_k((uint32_t) il, gp, up, dp);
+        }
+    }
+    pool->lut_upload_all();
+
+    // Verify GPU LUT matches host LUT for layer 0 (catch upload bugs)
+    {
+        const int32_t * host_lut = pool->lut_host(0);
+        int32_t gpu_lut[16];
+        ggml_backend_tensor_get(pool->lut_gpu(0), gpu_lut, 0, sizeof(gpu_lut));
+        fprintf(stderr, "[MOE_B1] L0 host lut[0..15]: ");
+        for (int i = 0; i < 16; ++i) fprintf(stderr, "%d ", host_lut[i]);
+        fprintf(stderr, "\n[MOE_B1] L0 gpu  lut[0..15]: ");
+        for (int i = 0; i < 16; ++i) fprintf(stderr, "%d ", gpu_lut[i]);
+        fprintf(stderr, "\n");
+    }
+
+    // Dump pool L0 gate vs vanilla L0 ffn_gate_exps metadata to find the difference
+    {
+        ggml_tensor * pg = pool->gate(0);
+        ggml_tensor * vg = model.layers[0].ffn_gate_exps;
+        auto dump = [](const char * tag, ggml_tensor * t) {
+            const char * bufname = t->buffer ? ggml_backend_buffer_name(t->buffer) : "(none)";
+            fprintf(stderr, "[META %s] name=%s type=%s ne={%lld,%lld,%lld,%lld} nb={%zu,%zu,%zu,%zu} "
+                            "view_src=%p view_offs=%zu data=%p buf=%s flags=%d op=%d\n",
+                    tag, t->name, ggml_type_name(t->type),
+                    (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2], (long long) t->ne[3],
+                    t->nb[0], t->nb[1], t->nb[2], t->nb[3],
+                    (void*) t->view_src, (size_t) t->view_offs, t->data,
+                    bufname, t->flags, (int) t->op);
+        };
+        dump("pool gate", pg);
+        dump("vani gate", vg);
+    }
+
+    // Cache packed CPU expert data refs for dynamic restage.
+    g_layer_data.clear();
+    g_layer_data.reserve(n_layer);
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & ly = model.layers[il];
+        g_layer_data.push_back({
+            ggml_get_data(ly.ffn_gate_exps),
+            ggml_get_data(ly.ffn_up_exps),
+            ggml_get_data(ly.ffn_down_exps),
+        });
+    }
+
+    slot_pool::set_active(pool.get());
+    g_pool = std::move(pool);
+    fprintf(stderr, "[MOE_B1] prestage of %s experts for %lld layers — done\n",
+            use_matrix ? "matrix-top-K'" : "first-K'",
+            (long long) n_layer);
+
+#ifdef MOE_SCHEDULER_AVAILABLE
+    if (!g_rust_scheduler) {
+        g_rust_scheduler = moe_scheduler_new(
+            (uint16_t) n_layer, (uint16_t) n_expert,
+            k_prime * (uint32_t) n_layer,
+            k_prime);
+        if (matrix_path && *matrix_path) {
+            moe_scheduler_load_matrix(g_rust_scheduler, matrix_path);
+        }
+        g_token_counter = 0;
+        fprintf(stderr, "[MOE_B1] Rust scheduler initialized (K'=%u)\n", k_prime);
+    }
+#endif
+}
+
+// Slot-pool variant of the qwen3moe MoE FFN block. 1:1 mirror of vanilla
+// build_moe_ffn (LLM_FFN_SILU + norm_w=true + SOFTMAX gating), with only
+// the mul_mat_id src0 swapped to slot pool tensors and ids LUT-remapped.
+ggml_tensor * build_moe_ffn_b1(struct ggml_context * ctx0,
+                               ggml_cgraph * gf,
+                               slot_pool * pool,
+                               int il,
+                               int64_t n_expert, int64_t n_expert_used,
+                               float w_scale,
+                               ggml_tensor * cur,
+                               ggml_tensor * gate_inp /* [n_embd, n_expert] */,
+                               ggml_tensor * vanilla_gate_exps,
+                               ggml_tensor * vanilla_up_exps,
+                               ggml_tensor * vanilla_down_exps) {
+    const int64_t n_embd   = cur->ne[0];
+    const int64_t n_tokens = cur->ne[1];
+
+    if (il == 0) {
+        fprintf(stderr, "[B1-BUILD L0] n_expert=%lld n_expert_used=%lld n_tokens=%lld n_embd=%lld\n",
+                (long long)n_expert, (long long)n_expert_used,
+                (long long)n_tokens, (long long)n_embd);
+        fprintf(stderr, "[B1-BUILD L0] pool_gate data=%p buf=%s  vanilla_gate data=%p buf=%s\n",
+                (void*)pool->gate(0)->data, pool->gate(0)->buffer ? ggml_backend_buffer_name(pool->gate(0)->buffer) : "NULL",
+                (void*)vanilla_gate_exps->data, vanilla_gate_exps->buffer ? ggml_backend_buffer_name(vanilla_gate_exps->buffer) : "NULL");
+    }
+
+    // Diagnostic: MOE_B1_NULL=1 returns zero (skips all MoE compute).
+    // Output should be "different garbage", not deterministic token 30 — that
+    // tells us bug is in mul_mat_id graph, not in plugin's outer machinery.
+    if (getenv("MOE_B1_NULL")) {
+        ggml_tensor * z = ggml_scale(ctx0, cur, 0.0f);
+        ggml_build_forward_expand(gf, z);
+        return z;
+    }
+
+    // Routing
+    ggml_tensor * logits = ggml_mul_mat(ctx0, gate_inp, cur);
+    ggml_tensor * probs  = ggml_soft_max(ctx0, logits);
+
+    ggml_tensor * selected_experts = ggml_argsort_top_k(ctx0, probs, n_expert_used);
+
+#ifdef MOE_SCHEDULER_AVAILABLE
+    // Wire scheduler observation: feed selected_experts to Rust scheduler at compute time.
+    // Scheduler returns prefetch commands queued in g_pending_cmds, processed at next graph build.
+    // Without this hook the scheduler never sees actual router output → static prestage only.
+    if (g_rust_scheduler) {
+        ggml_tensor * obs_cont = ggml_cont(ctx0, selected_experts);
+        ggml_tensor * obs = ggml_map_custom1(ctx0, obs_cont,
+            observe_selected_experts_cb, 1, (void *)(uintptr_t)il);
+        ggml_build_forward_expand(gf, obs);
+    }
+#endif
+
+    // Weights — exact vanilla order
+    probs = ggml_reshape_3d(ctx0, probs, 1, n_expert, n_tokens);
+    ggml_tensor * weights = ggml_get_rows(ctx0, probs, selected_experts);
+    weights = ggml_reshape_2d(ctx0, weights, n_expert_used, n_tokens);
+    ggml_tensor * weights_sum = ggml_sum_rows(ctx0, weights);
+    weights_sum = ggml_clamp(ctx0, weights_sum, 6.103515625e-5f, INFINITY);
+    weights = ggml_div(ctx0, weights, weights_sum);
+    weights = ggml_reshape_3d(ctx0, weights, 1, n_expert_used, n_tokens);
+    if (w_scale != 0.0f && w_scale != 1.0f) {
+        weights = ggml_scale(ctx0, weights, w_scale);
+    }
+    ggml_build_forward_expand(gf, weights);
+
+    // LUT remap: only difference from vanilla — selected_experts (logical id)
+    // → remapped (slot id) for use against slot pool tensors with K' < n_expert.
+    // selected_experts is a NON-CONTIGUOUS view (argsort_top_k returns a view
+    // with nb[1]=4*n_expert, not 4*K). Must ggml_cont before view_1d, otherwise
+    // view_1d reads strided memory linearly = garbage indices.
+    ggml_tensor * remapped;
+    if (getenv("MOE_SKIP_LUT")) {
+        // DIAG-28: bypass LUT entirely, use selected_experts directly.
+        // Only valid when K'=n_expert (identity mapping). Tests whether the LUT
+        // remap pipeline itself is the source of the bug.
+        remapped = selected_experts;
+    } else {
+        ggml_tensor * lut = pool->lut_gpu((uint32_t) il);
+        // DIAG-29: cont lut into graph context (compute buffer) to test if
+        // ggml_get_rows on a tensor in pool's separate vk_buffer is broken.
+        // FORCE_CONT_ALL handles src_gate/up/down but not lut.
+        if (getenv("MOE_CONT_LUT")) {
+            lut = ggml_cont(ctx0, lut);
+        }
+        ggml_tensor * sel_cont = ggml_cont(ctx0, selected_experts);
+        ggml_tensor * sel_flat = ggml_view_1d(ctx0, sel_cont, n_expert_used * n_tokens, 0);
+        remapped = ggml_get_rows(ctx0, lut, sel_flat);
+        remapped = ggml_reshape_2d(ctx0, remapped, n_expert_used, n_tokens);
+    }
+
+    if (il == 0) {
+        fprintf(stderr, "[B1-BUILD L0] selected_experts ne={%lld,%lld} nb={%zu,%zu}\n",
+                (long long)selected_experts->ne[0], (long long)selected_experts->ne[1],
+                selected_experts->nb[0], selected_experts->nb[1]);
+        fprintf(stderr, "[B1-BUILD L0] remapped ne={%lld,%lld} nb={%zu,%zu}\n",
+                (long long)remapped->ne[0], (long long)remapped->ne[1],
+                remapped->nb[0], remapped->nb[1]);
+    }
+
+    // DIAG-14: force remapped contiguous before mul_mat_id consumes it.
+    // diag-12 standalone (fresh contiguous I32 ids) PASSED; the only meaningful
+    // difference vs diag-9 / diag-2 (which fail with '?') is that ids here come
+    // from get_rows + reshape_2d. Their values are correct (verified by
+    // MOE_DUMP_IDS) but the tensor's nb/stride after this op chain may not match
+    // what mul_mat_id expects. ggml_cont forces a fresh contiguous copy.
+    // Set MOE_IDS_CONT=1 to enable; default off to keep prior behavior.
+    if (getenv("MOE_IDS_CONT")) {
+        remapped = ggml_cont(ctx0, remapped);
+    }
+
+    // Diagnostic: at layer 0, dump remapped + selected_experts actual values from GPU.
+    if (il == 0 && getenv("MOE_DUMP_IDS")) {
+        auto dump_ids = [](ggml_tensor *, const ggml_tensor * t, int /*ith*/, int /*nth*/, void * userdata) {
+            const char * tag = (const char *) userdata;
+            const int32_t * d = (const int32_t *) t->data;
+            fprintf(stderr, "[ids %s] ne={%lld,%lld} nb={%zu,%zu} vals: ",
+                    tag, (long long) t->ne[0], (long long) t->ne[1], t->nb[0], t->nb[1]);
+            const int n = (int) std::min<int64_t>(t->ne[0] * t->ne[1], 16);
+            for (int i = 0; i < n; ++i) fprintf(stderr, "%d ", d[i]);
+            fprintf(stderr, "\n");
+        };
+        ggml_tensor * sel_dump = ggml_map_custom1(ctx0, ggml_cont(ctx0, selected_experts),
+            dump_ids, 1, (void *) "sel");
+        ggml_tensor * rem_dump = ggml_map_custom1(ctx0, remapped,
+            dump_ids, 1, (void *) "rem");
+        ggml_build_forward_expand(gf, sel_dump);
+        ggml_build_forward_expand(gf, rem_dump);
+    }
+
+    cur = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+
+    // DIAG-15: force cur and src_*/down into ctx0 via ggml_cont before mul_mat_id.
+    // standalone test-mmid-ne2 (fresh tensors, single ctx) PASSES; pipeline FAILS.
+    // The slot pool tensors live in pool's own ggml_context; cur is a reshape view
+    // of attention output. Either could be confusing ggml-sched when the op falls
+    // back to CPU. Forcing ggml_cont copies them into ctx0 as fresh contiguous
+    // tensors. Set MOE_FORCE_CONT_ALL=1 to enable.
+    const bool force_cont_all = getenv("MOE_FORCE_CONT_ALL") != nullptr;
+    if (force_cont_all) {
+        cur = ggml_cont(ctx0, cur);
+    }
+
+    // Diagnostic: MOE_VANILLA_SRC0=1 uses vanilla expert tensors but LUT-remapped ids.
+    // Output should be coherent (only experts 0..K'-1 used, others fall to slot 0,
+    // which in vanilla = expert 0). If still '?' → bug is in LUT remapped ids.
+    const bool use_vanilla_src = getenv("MOE_VANILLA_SRC0") != nullptr;
+    // MOE_VANILLA_VIEW=1: take a 3D view of the first K' experts of vanilla tensor.
+    // ne[2]=K' but data is from CPU_Mapped (mmap) buffer. Tests if ne[2]=K' itself
+    // is the trigger, independent of which buffer the data lives in.
+    const bool use_vanilla_view = getenv("MOE_VANILLA_VIEW") != nullptr;
+    // MOE_FAKE_NE2=1: extend pool tensor's ne[2] to n_expert via view (OOB but
+    // never accessed because LUT ids in [0, K')). Tests if mul_mat_id silently
+    // miscomputes when src0->ne[2] = K' < n_expert.
+    const bool use_fake_ne2 = getenv("MOE_FAKE_NE2") != nullptr;
+    ggml_tensor * src_gate = pool->gate((uint32_t) il);
+    ggml_tensor * src_up   = pool->up  ((uint32_t) il);
+    ggml_tensor * src_down = pool->down((uint32_t) il);
+    if (use_vanilla_src) {
+        src_gate = vanilla_gate_exps;
+        src_up   = vanilla_up_exps;
+        src_down = vanilla_down_exps;
+    } else if (use_vanilla_view) {
+        const uint32_t kp = pool->get_config().k_prime;
+        src_gate = ggml_view_3d(ctx0, vanilla_gate_exps,
+            vanilla_gate_exps->ne[0], vanilla_gate_exps->ne[1], kp,
+            vanilla_gate_exps->nb[1], vanilla_gate_exps->nb[2], 0);
+        src_up = ggml_view_3d(ctx0, vanilla_up_exps,
+            vanilla_up_exps->ne[0], vanilla_up_exps->ne[1], kp,
+            vanilla_up_exps->nb[1], vanilla_up_exps->nb[2], 0);
+        src_down = ggml_view_3d(ctx0, vanilla_down_exps,
+            vanilla_down_exps->ne[0], vanilla_down_exps->ne[1], kp,
+            vanilla_down_exps->nb[1], vanilla_down_exps->nb[2], 0);
+    } else if (use_fake_ne2) {
+        ggml_tensor * pg = pool->gate((uint32_t) il);
+        ggml_tensor * pu = pool->up  ((uint32_t) il);
+        ggml_tensor * pd = pool->down((uint32_t) il);
+        // Identity view first (passes alloc-time bounds check), then mutate ne[2].
+        // LUT ids in [0, K') so kernel never accesses past underlying buffer.
+        src_gate = ggml_view_3d(ctx0, pg, pg->ne[0], pg->ne[1], pg->ne[2], pg->nb[1], pg->nb[2], 0);
+        src_up   = ggml_view_3d(ctx0, pu, pu->ne[0], pu->ne[1], pu->ne[2], pu->nb[1], pu->nb[2], 0);
+        src_down = ggml_view_3d(ctx0, pd, pd->ne[0], pd->ne[1], pd->ne[2], pd->nb[1], pd->nb[2], 0);
+        src_gate->ne[2] = n_expert;
+        src_up  ->ne[2] = n_expert;
+        src_down->ne[2] = n_expert;
+    }
+
+    if (force_cont_all) {
+        src_gate = ggml_cont(ctx0, src_gate);
+        src_up   = ggml_cont(ctx0, src_up);
+        src_down = ggml_cont(ctx0, src_down);
+    }
+
+    // DIAG-16: dump intermediate tensor values at layer 0 to find divergence point.
+    // Set MOE_DUMP_TENSORS=1, run twice (normal B1 vs MOE_VANILLA_SRC0=1), diff.
+    auto dump_cb_floats = [](ggml_tensor *, const ggml_tensor * t,
+                             int ith, int /*nth*/, void * userdata) {
+        if (ith != 0) return;
+        const char * tag = (const char *) userdata;
+        const float * d = (const float *) t->data;
+        const int n = (int) std::min<int64_t>(ggml_nelements(t), 8);
+        char buf[512];
+        int off = snprintf(buf, sizeof(buf),
+            "[DUMP %s] ne={%lld,%lld,%lld} type=%s nb={%zu,%zu,%zu} v:",
+            tag, (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2],
+            ggml_type_name(t->type), t->nb[0], t->nb[1], t->nb[2]);
+        for (int i = 0; i < n && off < (int)sizeof(buf) - 16; ++i) {
+            off += snprintf(buf + off, sizeof(buf) - off, " %.4g", d[i]);
+        }
+        if (off < (int)sizeof(buf) - 1) buf[off++] = '\n';
+        fwrite(buf, 1, off, stderr);
+        fflush(stderr);
+    };
+    auto add_dump = [&](ggml_tensor * t, const char * tag) {
+        if ((il != 0 && il != 23 && il != 47) || !getenv("MOE_DUMP_TENSORS")) return;
+        ggml_tensor * c = ggml_cont(ctx0, t);
+        char tagbuf[64];
+        snprintf(tagbuf, sizeof(tagbuf), "L%d_%s", il, tag + 3);  // skip "L0_"
+        ggml_tensor * m = ggml_map_custom1(ctx0, c, dump_cb_floats, 1, (void *) strdup(tagbuf));
+        ggml_build_forward_expand(gf, m);
+    };
+
+    add_dump(cur, "L0_cur_in");
+
+    // DIAG-19: dump first 16 bytes of src_gate at COMPUTE time. Should match
+    // stage-dump from stderr (e.g. slot 0 was: ab 06 1c 13 ff ab b1 eb ...).
+    // If different => slot pool buffer got corrupted between stage and compute.
+    if (il == 0 && getenv("MOE_DUMP_SRC_BYTES")) {
+        auto byte_cb = [](ggml_tensor *, const ggml_tensor * t,
+                          int ith, int /*nth*/, void * userdata) {
+            if (ith != 0) return;
+            const char * tag = (const char *) userdata;
+            const uint8_t * base = (const uint8_t *) t->data;
+            const size_t per_expert = (size_t) t->nb[2];
+            char buf[1024];
+            int off = snprintf(buf, sizeof(buf),
+                "[BYTES %s] data=%p ne[2]=%lld nb[2]=%zu (per_expert)\n",
+                tag, (void *) t->data, (long long) t->ne[2], per_expert);
+            fwrite(buf, 1, off, stderr);
+            const int slots[] = {0, 1, 5, 10, 20, 39};
+            for (int sidx = 0; sidx < (int)(sizeof(slots)/sizeof(slots[0])); ++sidx) {
+                int s = slots[sidx];
+                if (s >= t->ne[2]) continue;
+                const uint8_t * d = base + (size_t) s * per_expert;
+                off = snprintf(buf, sizeof(buf), "  slot %2d:", s);
+                for (int i = 0; i < 16 && off < (int)sizeof(buf) - 6; ++i) {
+                    off += snprintf(buf + off, sizeof(buf) - off, " %02x", d[i]);
+                }
+                buf[off++] = '\n';
+                fwrite(buf, 1, off, stderr);
+            }
+            fflush(stderr);
+        };
+        // map_custom1 takes input tensor and produces output. The cb receives
+        // input tensor `a`. We use a no-op shape (just read first bytes).
+        ggml_tensor * sg_dump = ggml_map_custom1(ctx0, src_gate, byte_cb, 1, (void *) "L0_src_gate");
+        ggml_build_forward_expand(gf, sg_dump);
+    }
+
+    // DIAG-25: ggml_dup slot pool tensors into compute-buffer-resident copies.
+    // If dup'd copies produce correct output but originals don't, the bug is
+    // in how the Vulkan backend handles the slot pool's VkBuffer (separate from
+    // the model/compute buffers).
+    if (getenv("MOE_DUP_SRC")) {
+        src_gate = ggml_dup(ctx0, src_gate);
+        src_up   = ggml_dup(ctx0, src_up);
+        src_down = ggml_dup(ctx0, src_down);
+    }
+
+    // DIAG-27: run BOTH pool and vanilla mul_mat_id at layer 0, compare outputs.
+    // If outputs differ despite identical data (DIAG-26 verified), the bug is in
+    // backend dispatch / buffer handling, not in the data.
+    if (il == 0 && getenv("MOE_CMP_OUTPUT")) {
+        // vanilla mul_mat_id: same cur, same ids (selected_experts, NOT remapped)
+        ggml_tensor * vanilla_up   = ggml_mul_mat_id(ctx0, vanilla_up_exps,   cur, selected_experts);
+        ggml_tensor * vanilla_gate = ggml_mul_mat_id(ctx0, vanilla_gate_exps, cur, selected_experts);
+        // pool mul_mat_id: pool src, remapped ids
+        ggml_tensor * pool_up   = ggml_mul_mat_id(ctx0, src_up,   cur, remapped);
+        ggml_tensor * pool_gate = ggml_mul_mat_id(ctx0, src_gate, cur, remapped);
+
+        auto outcmp_cb = [](ggml_tensor *, const ggml_tensor * a, const ggml_tensor * b,
+                            int ith, int /*nth*/, void * userdata) {
+            if (ith != 0) return;
+            const char * tag = (const char *) userdata;
+            const float * da = (const float *) a->data;
+            const float * db = (const float *) b->data;
+            const size_t n = (size_t) std::min(ggml_nelements(a), ggml_nelements(b));
+            int diffs = 0; float maxd = 0; int first = -1;
+            for (size_t i = 0; i < n; ++i) {
+                float d = std::fabs(da[i] - db[i]);
+                if (d > 1e-6f) {
+                    if (first < 0) first = (int)i;
+                    diffs++;
+                    if (d > maxd) maxd = d;
+                }
+            }
+            fprintf(stderr, "[CMP-OUT %s] n=%zu diffs=%d(%.1f%%) maxd=%g",
+                    tag, n, diffs, 100.0*diffs/n, maxd);
+            if (first >= 0) {
+                fprintf(stderr, " first@%d pool=%g vani=%g", first, da[first], db[first]);
+            }
+            fprintf(stderr, "\n");
+        };
+        ggml_tensor * cmp_up = ggml_map_custom2(ctx0,
+            ggml_cont(ctx0, pool_up), ggml_cont(ctx0, vanilla_up),
+            outcmp_cb, 1, (void*)"up");
+        ggml_tensor * cmp_gate = ggml_map_custom2(ctx0,
+            ggml_cont(ctx0, pool_gate), ggml_cont(ctx0, vanilla_gate),
+            outcmp_cb, 1, (void*)"gate");
+        ggml_build_forward_expand(gf, cmp_up);
+        ggml_build_forward_expand(gf, cmp_gate);
+    }
+
+    // DIAG-26: at compute time, compare pool gate/up/down data vs vanilla byte-by-byte.
+    if (il == 0 && getenv("MOE_CMP_DATA")) {
+        auto cmp_cb = [](ggml_tensor *, const ggml_tensor * a, const ggml_tensor * b,
+                         int ith, int /*nth*/, void * userdata) {
+            if (ith != 0) return;
+            const char * tag = (const char *)userdata;
+            const uint8_t * pa = (const uint8_t *) a->data;
+            const uint8_t * pb = (const uint8_t *) b->data;
+            const size_t per_exp_a = (size_t) a->nb[2];
+            const size_t per_exp_b = (size_t) b->nb[2];
+            const int n_exp = (int) std::min(a->ne[2], b->ne[2]);
+            fprintf(stderr, "[CMP L0 %s] a: ne2=%lld nb2=%zu type=%s  b: ne2=%lld nb2=%zu type=%s\n",
+                    tag, (long long)a->ne[2], per_exp_a, ggml_type_name(a->type),
+                    (long long)b->ne[2], per_exp_b, ggml_type_name(b->type));
+            int mismatches = 0;
+            for (int e = 0; e < std::min(n_exp, 8); ++e) {
+                const uint8_t * da = pa + (size_t)e * per_exp_a;
+                const uint8_t * db = pb + (size_t)e * per_exp_b;
+                const size_t cmp_len = std::min(per_exp_a, per_exp_b);
+                bool match = (std::memcmp(da, db, cmp_len) == 0);
+                if (!match) {
+                    size_t first = 0;
+                    while (first < cmp_len && da[first] == db[first]) ++first;
+                    fprintf(stderr, "  expert %d: MISMATCH first@%zu pool=%02x vani=%02x\n",
+                            e, first, da[first], db[first]);
+                    mismatches++;
+                } else {
+                    fprintf(stderr, "  expert %d: OK (%zu bytes)\n", e, cmp_len);
+                }
+            }
+            fprintf(stderr, "[CMP L0 %s] %d/%d MISMATCH\n", tag, mismatches, std::min(n_exp, 8));
+        };
+        // gate
+        ggml_tensor * cmp_g = ggml_map_custom2(ctx0,
+            ggml_cont(ctx0, src_gate), ggml_cont(ctx0, vanilla_gate_exps),
+            cmp_cb, 1, (void*)"gate");
+        // up
+        ggml_tensor * cmp_u = ggml_map_custom2(ctx0,
+            ggml_cont(ctx0, src_up), ggml_cont(ctx0, vanilla_up_exps),
+            cmp_cb, 1, (void*)"up");
+        // down
+        ggml_tensor * cmp_d = ggml_map_custom2(ctx0,
+            ggml_cont(ctx0, src_down), ggml_cont(ctx0, vanilla_down_exps),
+            cmp_cb, 1, (void*)"down");
+        ggml_build_forward_expand(gf, cmp_g);
+        ggml_build_forward_expand(gf, cmp_u);
+        ggml_build_forward_expand(gf, cmp_d);
+    }
+
+    ggml_tensor * up = ggml_mul_mat_id(ctx0, src_up, cur, remapped);
+    ggml_format_name(up, "B1_mmid_up_l%d", il);
+    add_dump(up, "L0_up_out");
+    cur = ggml_mul_mat_id(ctx0, src_gate, cur, remapped);
+    ggml_format_name(cur, "B1_mmid_gate_l%d", il);
+    add_dump(cur, "L0_gate_out");
+    cur = ggml_swiglu_split(ctx0, cur, up);
+    add_dump(cur, "L0_swiglu");
+
+    ggml_tensor * experts = ggml_mul_mat_id(ctx0, src_down, cur, remapped);
+    ggml_format_name(experts, "B1_mmid_down_l%d", il);
+    add_dump(experts, "L0_experts");
+    experts = ggml_mul(ctx0, experts, weights);
+    add_dump(experts, "L0_weighted");
+    ggml_build_forward_expand(gf, experts);
+
+    ggml_tensor * cur_experts[LLAMA_MAX_EXPERTS] = { nullptr };
+    for (int64_t k = 0; k < n_expert_used; ++k) {
+        cur_experts[k] = ggml_view_2d(ctx0, experts, n_embd, n_tokens,
+                                      experts->nb[2], k * experts->nb[1]);
+        ggml_build_forward_expand(gf, cur_experts[k]);
+    }
+    ggml_tensor * moe_out = cur_experts[0];
+    for (int64_t k = 1; k < n_expert_used; ++k) {
+        moe_out = ggml_add(ctx0, moe_out, cur_experts[k]);
+        ggml_build_forward_expand(gf, moe_out);
+    }
+    if (n_expert_used == 1) {
+        moe_out = ggml_cont(ctx0, moe_out);
+    }
+    return moe_out;
+}
+
+// D1: per-expert MUL_MAT path. Bypasses ggml_mul_mat_id (which falls back to
+// CPU on RDNA1 for Q4_K because supports_op() returns false — the kernel
+// needs row_ids+tile in 32KB shared memory, and Q4_K + n_ff_exp=768 doesn't
+// fit). Plain ggml_mul_mat has its own kernel without that constraint.
+//
+// Trade-off: K=8 separate matmul kernel launches per (gate/up/down) per
+// layer per token batch instead of 1 batched op. Launch overhead is
+// real (~10-30us each on Vulkan) but the alternative is CPU fallback,
+// which is much worse for decode (60ms+).
+ggml_tensor * build_moe_ffn_d1(struct ggml_context * ctx0,
+                               ggml_cgraph * gf,
+                               slot_pool * pool,
+                               int il,
+                               int64_t n_expert, int64_t n_expert_used,
+                               float w_scale,
+                               ggml_tensor * cur,
+                               ggml_tensor * gate_inp /* [n_embd, n_expert] */) {
+    const int64_t n_embd   = cur->ne[0];
+    const int64_t n_tokens = cur->ne[1];
+    const int64_t n_ff_exp = pool->get_config().n_ff_exp;
+    const int64_t K        = n_expert_used;
+
+    // === Routing (identical to B1) ===
+    ggml_tensor * logits = ggml_mul_mat(ctx0, gate_inp, cur);
+    ggml_tensor * probs  = ggml_soft_max(ctx0, logits);
+    ggml_tensor * selected_experts = ggml_argsort_top_k(ctx0, probs, K);
+
+    ggml_tensor * probs_3d = ggml_reshape_3d(ctx0, probs, 1, n_expert, n_tokens);
+    ggml_tensor * weights  = ggml_get_rows(ctx0, probs_3d, selected_experts);
+    weights = ggml_reshape_2d(ctx0, weights, K, n_tokens);
+    {
+        ggml_tensor * sum = ggml_sum_rows(ctx0, weights);
+        sum = ggml_clamp(ctx0, sum, 6.103515625e-5f, INFINITY);
+        weights = ggml_div(ctx0, weights, sum);
+    }
+    if (w_scale != 0.0f && w_scale != 1.0f) weights = ggml_scale(ctx0, weights, w_scale);
+    // weights shape: [K, n_tokens]
+
+    // LUT remap: logical expert id → slot id (in pool VRAM)
+    // selected_experts is a non-contiguous view from argsort_top_k (nb[1] = 4*n_expert,
+    // not 4*K). Must ggml_cont before view_1d, otherwise view reads strided memory linearly
+    // and produces garbage indices. Mirror of B1 path's fix.
+    ggml_tensor * lut = pool->lut_gpu((uint32_t) il);
+    ggml_tensor * sel_cont = ggml_cont(ctx0, selected_experts);
+    ggml_tensor * sel_flat = ggml_view_1d(ctx0, sel_cont,
+                                          K * n_tokens, 0);
+    ggml_tensor * remapped_flat = ggml_get_rows(ctx0, lut, sel_flat);
+    ggml_tensor * remapped = ggml_reshape_2d(ctx0, remapped_flat, K, n_tokens);
+
+    // Permute remapped & weights from [K, T] to [T, K] (contiguous) so we
+    // can address the k-th column as a 1D contiguous slice of length T.
+    ggml_tensor * remapped_TK = ggml_cont(ctx0,
+        ggml_permute(ctx0, remapped, 1, 0, 2, 3));
+    ggml_tensor * weights_TK = ggml_cont(ctx0,
+        ggml_permute(ctx0, weights, 1, 0, 2, 3));
+
+    // Expand cur to [n_embd, 1, n_tokens] for batched matmul against
+    // gate/up weight slabs (which become [n_embd, n_ff_exp, n_tokens]
+    // after get_rows over the slot axis).
+    ggml_tensor * cur_3d = ggml_reshape_3d(ctx0, cur, n_embd, 1, n_tokens);
+
+    ggml_tensor * accum = nullptr;
+
+    // Helpers: view each pool tensor as 2D [slab, K'] so ggml_get_rows can pick
+    // along ne[1]=K' (the slot axis). The data layout is contiguous slab-after-
+    // slab, so a 2D view is just a reinterpretation.
+    const int64_t gate_slab = n_embd   * n_ff_exp;     // gate/up slab size in elements
+    const int64_t down_slab = n_ff_exp * n_embd;       // down slab size (same number, different reshape)
+    ggml_tensor * gate_pool_2d = ggml_view_2d(ctx0, pool->gate((uint32_t) il),
+        gate_slab, pool->get_config().k_prime,
+        pool->gate((uint32_t) il)->nb[2], 0);
+    ggml_tensor * up_pool_2d = ggml_view_2d(ctx0, pool->up((uint32_t) il),
+        gate_slab, pool->get_config().k_prime,
+        pool->up((uint32_t) il)->nb[2], 0);
+    ggml_tensor * down_pool_2d = ggml_view_2d(ctx0, pool->down((uint32_t) il),
+        down_slab, pool->get_config().k_prime,
+        pool->down((uint32_t) il)->nb[2], 0);
+
+    for (int64_t k = 0; k < K; ++k) {
+        // Slot indices for this k position across all T tokens
+        ggml_tensor * slot_idx_k = ggml_view_1d(ctx0, remapped_TK,
+            n_tokens, k * n_tokens * (int64_t) sizeof(int32_t));
+
+        // Pull weight slabs by slot index. get_rows on 2D source picks along ne[1].
+        ggml_tensor * w_gate_flat = ggml_get_rows(ctx0, gate_pool_2d, slot_idx_k);
+        ggml_tensor * w_up_flat   = ggml_get_rows(ctx0, up_pool_2d,   slot_idx_k);
+        ggml_tensor * w_down_flat = ggml_get_rows(ctx0, down_pool_2d, slot_idx_k);
+        // Each shape: [slab, n_tokens]. Reshape back to 3D for matmul.
+        ggml_tensor * w_gate = ggml_reshape_3d(ctx0, w_gate_flat, n_embd,   n_ff_exp, n_tokens);
+        ggml_tensor * w_up   = ggml_reshape_3d(ctx0, w_up_flat,   n_embd,   n_ff_exp, n_tokens);
+        ggml_tensor * w_down = ggml_reshape_3d(ctx0, w_down_flat, n_ff_exp, n_embd,   n_tokens);
+
+        // Plain MUL_MAT (no LDS issue like MUL_MAT_ID has on RDNA1).
+        ggml_tensor * gate_out = ggml_mul_mat(ctx0, w_gate, cur_3d);  // [1, n_ff_exp, T]
+        ggml_tensor * up_out   = ggml_mul_mat(ctx0, w_up,   cur_3d);  // [1, n_ff_exp, T]
+
+        // SwiGLU
+        ggml_tensor * silu = ggml_silu(ctx0, gate_out);
+        ggml_tensor * h    = ggml_mul (ctx0, silu, up_out);  // [1, n_ff_exp, T]
+
+        // Down: w_down [n_ff_exp, n_embd, T] @ h [n_ff_exp, 1, T] → [1, n_embd, T]
+        ggml_tensor * h_in = ggml_reshape_3d(ctx0, h, n_ff_exp, 1, n_tokens);
+        ggml_tensor * out_k = ggml_mul_mat(ctx0, w_down, h_in);
+
+        // Multiply by router weight w[k, t] (broadcast over n_embd)
+        ggml_tensor * w_scalar = ggml_view_1d(ctx0, weights_TK,
+            n_tokens, k * n_tokens * (int64_t) sizeof(float));
+        ggml_tensor * w_bcast = ggml_reshape_3d(ctx0, w_scalar, 1, 1, n_tokens);
+        out_k = ggml_mul(ctx0, out_k, w_bcast);  // [1, n_embd, T]
+
+        accum = accum ? ggml_add(ctx0, accum, out_k) : out_k;
+    }
+
+    // [1, n_embd, T] → [n_embd, T]
+    ggml_tensor * res = ggml_reshape_2d(ctx0, accum, n_embd, n_tokens);
+    return res;
+}
