+std::unique_ptr<llama_neural_bus_intelligence_router>
+llama_neural_bus_intelligence_router::load_f32_3way(
+        const std::filesystem::path & directory,
+        ggml_backend_buffer_type_t buft,
+        int64_t n_embd,
+        const std::string & expected_manifest_sha256) {
+    if (!buft || n_embd <= 0) {
+        return nullptr;
+    }
+    try {
+        validate_intelligence_router_manifest(
+            directory, n_embd, expected_manifest_sha256);
+    } catch (const std::exception & error) {
+        LLAMA_LOG_ERROR("ColorLM Intelligence Router rejected: %s (%s)\n",
+            directory.string().c_str(), error.what());
+        return nullptr;
+    }
+
+    auto router = std::unique_ptr<llama_neural_bus_intelligence_router>(
+        new llama_neural_bus_intelligence_router());
+    ggml_init_params params = {
+        /*.mem_size   =*/ 2 * ggml_tensor_overhead() + 1024,
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    router->ctx_ = ggml_init(params);
+    if (!router->ctx_) {
+        return nullptr;
+    }
+
+    router->weight_ = ggml_new_tensor_2d(router->ctx_, GGML_TYPE_F32, n_embd, 3);
+    router->bias_ = ggml_new_tensor_1d(router->ctx_, GGML_TYPE_F32, 3);
+    ggml_set_name(router->weight_, "neural_bus.intelligence.weight");
+    ggml_set_name(router->bias_, "neural_bus.intelligence.bias");
+
+    router->buffer_ = ggml_backend_alloc_ctx_tensors_from_buft(router->ctx_, buft);
+    if (!router->buffer_) {
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(router->buffer_, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    if (!load_tensor_file(directory / "weight.f32", router->weight_) ||
+        !load_tensor_file(directory / "bias.f32", router->bias_)) {
+        return nullptr;
+    }
+    return router;
+}
