+std::unique_ptr<server_res_generator> server_routes::handle_colorlm_memory(
+        const server_http_req & req, int id_slot, bool clear) {
+    auto res = create_response();
+    float rate = 0.25f;
+    if (!clear) {
+        const json request_data = req.body.empty() ? json::object() : json::parse(req.body);
+        rate = request_data.value("rate", rate);
+        if (!(rate > 0.0f && rate <= 1.0f)) {
+            res->error(format_error_response("ColorLM consolidation rate must be in (0, 1]", ERROR_TYPE_INVALID_REQUEST));
+            return res;
+        }
+    }
+
+    auto & rd = res->rd;
+    {
+        server_task task(clear ? SERVER_TASK_TYPE_COLORLM_SEMANTIC_CLEAR : SERVER_TASK_TYPE_COLORLM_CONSOLIDATE);
+        task.id = rd.get_new_id();
+        task.slot_action.id_slot = id_slot;
+        task.slot_action.rate = rate;
+        rd.post_task(std::move(task));
+    }
+
+    auto result = rd.next(req.should_stop);
+    if (!result) {
+        GGML_ASSERT(req.should_stop());
+        return res;
+    }
+    if (result->is_error()) {
+        res->error(result->to_json());
+        return res;
+    }
+
+    GGML_ASSERT(dynamic_cast<server_task_result_colorlm_memory *>(result.get()) != nullptr);
+    res->ok(result->to_json());
+    return res;
+}
