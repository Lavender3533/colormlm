+}
+
+ggml_tensor * llama_neural_bus_k3_capsule::build_expert_latent(
+        ggml_context * ctx, ggml_tensor * latent) const {
+    constexpr float situ_beta = 4.0f;
+    constexpr float situ_linear_beta = 25.0f;
+
+    const bool decode =
+        latent->ne[1] == 1 && gate_decode_ && up_decode_ && down_decode_;
+    ggml_tensor * gate = ggml_mul_mat(ctx, decode ? gate_decode_ : gate_, latent);
+    ggml_tensor * up = ggml_mul_mat(ctx, decode ? up_decode_ : up_, latent);
+
+    // Exact K3 SiTU, not SwiGLU:
+    // 4*tanh(gate/4)*sigmoid(gate) * 25*tanh(up/25).
+    ggml_tensor * situ_gate = ggml_scale(
+        ctx, ggml_tanh(ctx, ggml_scale(ctx, gate, 1.0f / situ_beta)), situ_beta);
+    situ_gate = ggml_mul(ctx, situ_gate, ggml_sigmoid(ctx, gate));
+    ggml_tensor * situ_up = ggml_scale(
+        ctx, ggml_tanh(ctx, ggml_scale(ctx, up, 1.0f / situ_linear_beta)),
+        situ_linear_beta);
+    ggml_tensor * hidden = ggml_mul(ctx, situ_gate, situ_up);
+
+    latent = ggml_mul_mat(ctx, decode ? down_decode_ : down_, hidden);
+    latent = ggml_rms_norm(ctx, latent, rms_norm_eps_);
+    latent = ggml_mul(ctx, latent, ggml_cast(ctx, norm_, GGML_TYPE_F32));
+    return latent;
+}
+
+ggml_tensor * llama_neural_bus_k3_capsule::build_output_delta(
+        ggml_context * ctx, ggml_tensor * latent) const {
+    return ggml_mul_mat(ctx, b_out_, latent);
+}
+
+ggml_tensor * llama_neural_bus_k3_capsule::build_router_score(
+        ggml_context * ctx, ggml_tensor * input) const {
+    return router_ ? ggml_mul_mat(ctx, router_, input) : nullptr;
+}
+
+bool llama_neural_bus_k3_capsule::has_router() const {
+    return router_ != nullptr;
+}
+
+bool llama_neural_bus_k3_capsule::shares_transport_with(
+        const llama_neural_bus_k3_capsule & other) const {
+    return !transport_fingerprint_.empty() &&
+        transport_fingerprint_ == other.transport_fingerprint_;
+}
+
+float llama_neural_bus_k3_capsule::router_l2_norm() const {
+    return router_l2_norm_;
+}
+
+size_t llama_neural_bus_k3_capsule::weight_bytes() const {
+    return ggml_nbytes(b_in_) + ggml_nbytes(gate_) + ggml_nbytes(up_) +
+        ggml_nbytes(down_) + ggml_nbytes(norm_) + ggml_nbytes(b_out_) +
+        (gate_decode_ ? ggml_nbytes(gate_decode_) + ggml_nbytes(up_decode_) +
+                        ggml_nbytes(down_decode_) : 0) +
+        (router_ ? ggml_nbytes(router_) : 0);
+}
+
+const char * llama_neural_bus_k3_capsule::buffer_name() const {
+    return buffer_ ? ggml_backend_buffer_name(buffer_) : "none";
+}
+
+int llama_neural_bus_k3_capsule::source_layer() const {
+    return source_layer_;
+}
+
+int llama_neural_bus_k3_capsule::source_expert() const {
+    return source_expert_;
+}
