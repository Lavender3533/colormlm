+static const std::vector<q35_k3_macro_runtime> * q35_try_init_k3_macros(
+        const llama_model & model,
+        const q35_k3_macro_config & config) {
+    if (config.sites.empty()) {
+        return nullptr;
+    }
+
+    std::lock_guard<std::mutex> lock(g_q35_k3_macro_mutex);
+    if (g_q35_k3_macro_model != &model) {
+        g_q35_k3_macros.clear();
+        g_q35_k3_macro_model = &model;
+        g_q35_k3_macro_trace_count.store(0);
+        g_q35_k3_route_trace_count.store(0);
+    }
+    if (!g_q35_k3_macros.empty()) {
+        return &g_q35_k3_macros;
+    }
+
+    constexpr int64_t k3_latent_width = 3584;
+    constexpr int64_t k3_intermediate_width = 3072;
+    double total_mib = 0.0;
+    for (const auto & site : config.sites) {
+        ggml_backend_buffer_type_t buft = q35_pick_gpu_buft(model);
+        if (!buft) {
+            buft = model.select_buft(site.site);
+        }
+        q35_k3_macro_runtime runtime;
+        runtime.config = site;
+        for (const auto & candidate_config : site.candidates) {
+            q35_k3_macro_runtime::candidate_runtime candidate;
+            candidate.config = candidate_config;
+            candidate.capsule = llama_neural_bus_k3_capsule::load_situ(
+                candidate_config.capsule, buft, model.hparams.n_embd,
+                k3_latent_width, k3_intermediate_width,
+                candidate_config.manifest_sha256);
+            if (!candidate.capsule ||
+                (site.candidates.size() > 1 && !candidate.capsule->has_router())) {
+                g_q35_k3_macros.clear();
+                throw std::runtime_error(
+                    "ColorLM K3 candidate failed validation, routing contract, or GPU allocation");
+            }
+            total_mib += candidate.capsule->weight_bytes() / (1024.0 * 1024.0);
+            LLAMA_LOG_INFO(
+                "ColorLM K3 candidate: ColorLM L%d <- K3 L%d/E%d, alpha=%.4f, "
+                "target=%.4f, gain=%.5f, router=%s, %.2f MiB on %s\n",
+                site.site, candidate.capsule->source_layer(), candidate.capsule->source_expert(),
+                site.alpha, site.target_ratio, candidate.config.transport_gain,
+                candidate.capsule->has_router() ? "cosine" : "none",
+                candidate.capsule->weight_bytes() / (1024.0 * 1024.0),
+                candidate.capsule->buffer_name());
+            runtime.candidates.push_back(std::move(candidate));
+        }
+        LLAMA_LOG_INFO(
+            "ColorLM K3 site: L%d candidates=%zu, temperature=%.4f, no_op_bias=%.4f\n",
+            site.site, runtime.candidates.size(), site.temperature, site.no_op_bias);
+        g_q35_k3_macros.push_back(std::move(runtime));
+    }
+
+    LLAMA_LOG_INFO(
+        "ColorLM K3 Neural Bus: %.2f MiB, sites=%zu, "
+        "path=2048->3584->3072->3584->2048, activation=SiTU\n",
+        total_mib, g_q35_k3_macros.size());
+    return &g_q35_k3_macros;
+}
+
+static q35_intelligence_config q35_read_intelligence_config(
+        const llama_model & model,
+        const q35_neural_bus_config & neural_bus,
+        const q35_k3_macro_config & k3_macros) {
+    q35_intelligence_config config;
+    if (model.arch != LLM_ARCH_COLORLMV4 ||
+        neural_bus.alpha <= 0.0f || k3_macros.sites.empty()) {
+        return config;
+    }
+
+    const char * raw_plan = std::getenv("COLORLM_NEURAL_BUS_INTELLIGENCE_PLAN");
+    if (!raw_plan || raw_plan[0] == '\0') {
+        return config;
+    }
+    std::filesystem::path plan_path(raw_plan);
+    if (plan_path.is_relative()) {
+        plan_path = std::filesystem::absolute(plan_path);
+    }
+    std::ifstream plan_stream(plan_path);
+    if (!plan_stream) {
+        throw std::runtime_error("ColorLM Intelligence Router plan cannot be opened");
+    }
+    const nlohmann::json plan = nlohmann::json::parse(plan_stream);
+    if (plan.at("format").get<std::string>() !=
+            "colorlm-intelligence-site-plan-v1" ||
+        plan.value("status", std::string{}) != "candidate" ||
+        plan.at("input_width").get<int64_t>() != model.hparams.n_embd ||
+        plan.at("routes").get<std::vector<std::string>>() !=
+            std::vector<std::string>{"no_op", "coder", "k3"}) {
+        throw std::runtime_error("unsupported ColorLM Intelligence Router plan");
+    }
+    const auto & sites = plan.at("sites");
+    if (!sites.is_array() || sites.empty()) {
+        throw std::runtime_error("ColorLM Intelligence Router plan has no sites");
+    }
+
+    for (const auto & record : sites) {
+        q35_intelligence_config::site_config site;
+        site.site = record.at("site").get<int>();
+        site.temperature = record.value("temperature", 1.0f);
+        site.router = record.at("router").get<std::string>();
+        site.manifest_sha256 = record.at("manifest_sha256").get<std::string>();
+        if (site.router.is_relative()) {
+            site.router = plan_path.parent_path() / site.router;
+        }
+        site.router = std::filesystem::weakly_canonical(site.router);
+
+        const bool coder_available = neural_bus.enabled_at(site.site);
+        const bool k3_available = std::find_if(
+            k3_macros.sites.begin(), k3_macros.sites.end(), [&](const auto & entry) {
+                return entry.site == site.site && entry.alpha > 0.0f;
+            }) != k3_macros.sites.end();
+        if (site.site < 0 || site.site >= (int) model.hparams.n_layer ||
+            site.temperature < 0.01f || site.temperature > 4.0f ||
+            site.manifest_sha256.size() != 64 ||
+            !coder_available || !k3_available) {
+            throw std::runtime_error("invalid ColorLM Intelligence Router site");
+        }
+        if (std::find_if(config.sites.begin(), config.sites.end(), [&](const auto & existing) {
+                return existing.site == site.site;
+            }) != config.sites.end()) {
+            throw std::runtime_error("duplicate ColorLM Intelligence Router site");
+        }
+        config.sites.push_back(std::move(site));
+    }
+    std::sort(config.sites.begin(), config.sites.end(), [](const auto & a, const auto & b) {
+        return a.site < b.site;
+    });
+    return config;
+}
+
+static const std::vector<q35_intelligence_runtime> * q35_try_init_intelligence_routers(
+        const llama_model & model,
+        const q35_intelligence_config & config) {
+    if (config.sites.empty()) {
+        return nullptr;
+    }
+
+    std::lock_guard<std::mutex> lock(g_q35_intelligence_mutex);
+    if (g_q35_intelligence_model != &model) {
+        g_q35_intelligence_routers.clear();
+        g_q35_intelligence_model = &model;
+        g_q35_intelligence_trace_count.store(0);
+    }
+    if (!g_q35_intelligence_routers.empty()) {
+        return &g_q35_intelligence_routers;
+    }
+
+    double total_kib = 0.0;
+    for (const auto & site : config.sites) {
+        ggml_backend_buffer_type_t buft = q35_pick_gpu_buft(model);
+        if (!buft) {
+            buft = model.select_buft(site.site);
+        }
+        q35_intelligence_runtime runtime;
+        runtime.config = site;
+        runtime.router = llama_neural_bus_intelligence_router::load_f32_3way(
+            site.router, buft, model.hparams.n_embd, site.manifest_sha256);
+        if (!runtime.router) {
+            g_q35_intelligence_routers.clear();
+            throw std::runtime_error(
+                "ColorLM Intelligence Router failed validation or GPU allocation");
+        }
+        total_kib += runtime.router->weight_bytes() / 1024.0;
+        LLAMA_LOG_INFO(
+            "ColorLM Intelligence Router: L%d routes=no_op,coder,k3, "
+            "temperature=%.4f, %.2f KiB on %s\n",
+            site.site, site.temperature, runtime.router->weight_bytes() / 1024.0,
+            runtime.router->buffer_name());
+        g_q35_intelligence_routers.push_back(std::move(runtime));
+    }
+    LLAMA_LOG_INFO(
+        "ColorLM Intelligence Router: %.2f KiB, sites=%zu\n",
+        total_kib, g_q35_intelligence_routers.size());
+    return &g_q35_intelligence_routers;
+}
