+std::unique_ptr<llama_neural_bus_k3_capsule> llama_neural_bus_k3_capsule::load_situ(
+        const std::filesystem::path & directory,
+        ggml_backend_buffer_type_t buft,
+        int64_t n_embd,
+        int64_t n_latent,
+        int64_t n_ff,
+        const std::string & expected_manifest_sha256) {
+    if (!buft || n_embd <= 0 || n_latent <= 0 || n_ff <= 0) {
+        return nullptr;
+    }
+
+    k3_manifest_info manifest;
+    try {
+        manifest = validate_k3_manifest(
+            directory, n_embd, n_latent, n_ff, expected_manifest_sha256);
+    } catch (const std::exception & error) {
+        LLAMA_LOG_ERROR("ColorLM K3 capsule rejected: %s (%s)\n",
+            directory.string().c_str(), error.what());
+        return nullptr;
+    }
+
+    auto capsule = std::unique_ptr<llama_neural_bus_k3_capsule>(
+        new llama_neural_bus_k3_capsule());
+    capsule->source_layer_ = manifest.layer;
+    capsule->source_expert_ = manifest.expert;
+    capsule->rms_norm_eps_ = manifest.rms_norm_eps;
+    capsule->router_l2_norm_ = manifest.router_l2_norm;
+    capsule->transport_fingerprint_ = std::move(manifest.transport_fingerprint);
+    ggml_init_params params = {
+        /*.mem_size   =*/ ((manifest.has_router ? 7 : 6) +
+                           (manifest.hybrid_decode ? 3 : 0)) * ggml_tensor_overhead() + 1024,
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    capsule->ctx_ = ggml_init(params);
+    if (!capsule->ctx_) {
+        return nullptr;
+    }
+
+    // ggml stores the input dimension in ne[0], matching a row-major
+    // PyTorch [out, in] F16 file without a transpose or repack.
+    capsule->b_in_  = ggml_new_tensor_2d(capsule->ctx_, GGML_TYPE_F16, n_embd,   n_latent);
+    capsule->gate_  = ggml_new_tensor_2d(capsule->ctx_, manifest.expert_type, n_latent, n_ff);
+    capsule->up_    = ggml_new_tensor_2d(capsule->ctx_, manifest.expert_type, n_latent, n_ff);
+    capsule->down_  = ggml_new_tensor_2d(capsule->ctx_, manifest.expert_type, n_ff,     n_latent);
+    if (manifest.hybrid_decode) {
+        capsule->gate_decode_ = ggml_new_tensor_2d(
+            capsule->ctx_, manifest.decode_expert_type, n_latent, n_ff);
+        capsule->up_decode_ = ggml_new_tensor_2d(
+            capsule->ctx_, manifest.decode_expert_type, n_latent, n_ff);
+        capsule->down_decode_ = ggml_new_tensor_2d(
+            capsule->ctx_, manifest.decode_expert_type, n_ff, n_latent);
+    }
+    capsule->norm_  = ggml_new_tensor_1d(capsule->ctx_, GGML_TYPE_F16, n_latent);
+    capsule->b_out_ = ggml_new_tensor_2d(capsule->ctx_, GGML_TYPE_F16, n_latent, n_embd);
+    if (manifest.has_router) {
+        capsule->router_ = ggml_new_tensor_2d(capsule->ctx_, GGML_TYPE_F32, n_embd, 1);
+    }
+    ggml_set_name(capsule->b_in_,  "neural_bus.k3.b_in");
+    ggml_set_name(capsule->gate_,  "neural_bus.k3.gate");
+    ggml_set_name(capsule->up_,    "neural_bus.k3.up");
+    ggml_set_name(capsule->down_,  "neural_bus.k3.down");
+    if (capsule->gate_decode_) {
+        ggml_set_name(capsule->gate_decode_, "neural_bus.k3.gate_decode");
+        ggml_set_name(capsule->up_decode_, "neural_bus.k3.up_decode");
+        ggml_set_name(capsule->down_decode_, "neural_bus.k3.down_decode");
+    }
+    ggml_set_name(capsule->norm_,  "neural_bus.k3.norm");
+    ggml_set_name(capsule->b_out_, "neural_bus.k3.b_out");
+    if (capsule->router_) {
+        ggml_set_name(capsule->router_, "neural_bus.k3.router");
+    }
+
+    capsule->buffer_ = ggml_backend_alloc_ctx_tensors_from_buft(capsule->ctx_, buft);
+    if (!capsule->buffer_) {
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(capsule->buffer_, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    const std::string gate_file = "gate." + manifest.expert_suffix;
+    const std::string up_file = "up." + manifest.expert_suffix;
+    const std::string down_file = "down." + manifest.expert_suffix;
+    const std::string gate_decode_file = "gate_decode." + manifest.decode_expert_suffix;
+    const std::string up_decode_file = "up_decode." + manifest.decode_expert_suffix;
+    const std::string down_decode_file = "down_decode." + manifest.decode_expert_suffix;
+    if (!load_tensor_file(directory / "b_in.f16", capsule->b_in_) ||
+        !load_tensor_file(directory / gate_file, capsule->gate_) ||
+        !load_tensor_file(directory / up_file, capsule->up_) ||
+        !load_tensor_file(directory / down_file, capsule->down_) ||
+        !load_tensor_file(directory / "norm.f16", capsule->norm_) ||
+        !load_tensor_file(directory / "b_out.f16", capsule->b_out_) ||
+        (capsule->gate_decode_ &&
+         (!load_tensor_file(directory / gate_decode_file, capsule->gate_decode_) ||
+          !load_tensor_file(directory / up_decode_file, capsule->up_decode_) ||
+          !load_tensor_file(directory / down_decode_file, capsule->down_decode_))) ||
+        (capsule->router_ && !load_tensor_file(directory / "router.f32", capsule->router_))) {
+        return nullptr;
+    }
+    return capsule;
+}
