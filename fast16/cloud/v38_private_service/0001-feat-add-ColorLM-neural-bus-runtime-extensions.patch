--- /dev/null
+++ b/tests/test-mmid-ne2.cpp
@@ -0,0 +1,210 @@
+// DIAG-12 (project-local, slot-pool diag):
+// Standalone comparison of ggml_mul_mat_id with two ne[2] sizes,
+// now testing BOTH CPU and Vulkan backends plus broadcast vs non-broadcast.
+//
+// The standard test-backend-ops uses CPU as the reference, so it
+// cannot detect a bug that affects both backends identically. This test
+// compares two runs with different ne[2] against each other:
+//
+//   A: src0 ne[2] = 128 (full),   ids in [0, 40)
+//   B: src0 ne[2] = 40  (K-prime), ids in [0, 40), data = first 40 experts of A
+//
+// Same input data, same ids, only ne[2] differs. ggml_mul_mat_id MUST return
+// identical outputs. If they differ -> mul_mat_id has an ne[2]-sensitivity bug.
+
+#include <ggml.h>
+#include <ggml-alloc.h>
+#include <ggml-backend.h>
+#include <ggml-cpp.h>
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+static int run_one_case(ggml_backend_t backend,
+                        const std::vector<uint8_t> & data_big,
+                        size_t per_expert_bytes,
+                        const std::vector<float> & b_data_big,
+                        const std::vector<float> & b_data_bcast,
+                        const std::vector<int32_t> & ids_data,
+                        int K, int M, int N, int N_USED,
+                        int N_BIG, int N_SMALL,
+                        bool broadcast)
+{
+    auto run = [&](int n_mats) -> std::vector<float> {
+        ggml_init_params ip = { /*.mem_size  =*/ 16 * 1024 * 1024,
+                                /*.mem_buffer=*/ NULL,
+                                /*.no_alloc  =*/ true };
+        ggml_context * ctx = ggml_init(ip);
+
+        ggml_tensor * src0 = ggml_new_tensor_3d(ctx, GGML_TYPE_Q4_K, K, M, n_mats);
+        ggml_tensor * b    = ggml_new_tensor_3d(ctx, GGML_TYPE_F32,  K,
+                                                broadcast ? 1 : N_USED, N);
+        ggml_tensor * ids  = ggml_new_tensor_2d(ctx, GGML_TYPE_I32,  N_USED, N);
+
+        ggml_tensor * out = ggml_mul_mat_id(ctx, src0, b, ids);
+
+        ggml_cgraph * gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, out);
+
+        ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        if (!buf) { fprintf(stderr, "FATAL alloc failed n_mats=%d\n", n_mats); std::exit(1); }
+
+        ggml_backend_tensor_set(src0, data_big.data(), 0, per_expert_bytes * n_mats);
+        const float * bsrc = broadcast ? b_data_bcast.data() : b_data_big.data();
+        const size_t  bsz  = (size_t)(broadcast ? 1 : N_USED) * K * N * sizeof(float);
+        ggml_backend_tensor_set(b,   bsrc,            0, bsz);
+        ggml_backend_tensor_set(ids, ids_data.data(), 0, ids_data.size() * sizeof(int32_t));
+
+        ggml_backend_graph_compute(backend, gf);
+
+        std::vector<float> result(ggml_nelements(out));
+        ggml_backend_tensor_get(out, result.data(), 0, result.size() * sizeof(float));
+
+        ggml_backend_buffer_free(buf);
+        ggml_free(ctx);
+        return result;
+    };
+
+    auto out_big   = run(N_BIG);
+    auto out_small = run(N_SMALL);
+
+    int    n_diff       = 0;
+    int    first_diff   = -1;
+    float  max_abs_diff = 0.0f;
+    double sum_sq_diff  = 0.0;
+    double sum_sq_big   = 0.0;
+    for (size_t i = 0; i < out_big.size(); ++i) {
+        const float a = out_big[i];
+        const float b = out_small[i];
+        const float d = std::fabs(a - b);
+        if (d > 0.0f) {
+            if (first_diff < 0) first_diff = (int) i;
+            n_diff++;
+            if (d > max_abs_diff) max_abs_diff = d;
+        }
+        sum_sq_diff += (double) d * d;
+        sum_sq_big  += (double) a * a;
+    }
+    const double nmse = (sum_sq_big > 0) ? sum_sq_diff / sum_sq_big : 0.0;
+
+    printf("--- b shape: %s ---\n", broadcast ? "[K, 1, N] (BROADCAST, qwen3 actual)"
+                                              : "[K, N_USED, N] (non-broadcast, upstream test)");
+    printf("Output elements:    %zu\n", out_big.size());
+    printf("Bitwise diffs:      %d (%.2f%%)\n", n_diff, 100.0 * n_diff / out_big.size());
+    printf("Max abs diff:       %g\n", max_abs_diff);
+    printf("NMSE:               %g\n", nmse);
+    if (first_diff >= 0) {
+        printf("First diff @ idx %d: ne[2]=%d -> %g, ne[2]=%d -> %g\n",
+               first_diff, N_BIG, out_big[first_diff], N_SMALL, out_small[first_diff]);
+    }
+    if (n_diff == 0) {
+        printf("PASS: bit-identical between ne[2]=%d and ne[2]=%d\n", N_BIG, N_SMALL);
+    } else {
+        printf("FAIL: outputs differ between ne[2]=%d and ne[2]=%d\n", N_BIG, N_SMALL);
+    }
+    printf("\n");
+    return n_diff == 0 ? 0 : 1;
+}
+
+static void run_on_backend(ggml_backend_t backend, const char * name,
+                           const std::vector<uint8_t> & data_big,
+                           size_t per_expert_bytes,
+                           const std::vector<float> & b_data_big,
+                           const std::vector<float> & b_data_bcast,
+                           const std::vector<int32_t> & ids_data,
+                           int K, int M, int N, int N_USED,
+                           int N_BIG, int N_SMALL)
+{
+    printf("\n======= Backend: %s =======\n", name);
+    printf("Shape: K=%d M=%d N=%d N_USED=%d type=Q4_K\n", K, M, N, N_USED);
+    printf("Comparing ne[2]=%d vs ne[2]=%d, ids in [0, %d)\n\n", N_BIG, N_SMALL, N_SMALL);
+
+    int rc1 = run_one_case(backend, data_big, per_expert_bytes,
+                           b_data_big, b_data_bcast, ids_data,
+                           K, M, N, N_USED, N_BIG, N_SMALL, /*broadcast=*/false);
+    int rc2 = run_one_case(backend, data_big, per_expert_bytes,
+                           b_data_big, b_data_bcast, ids_data,
+                           K, M, N, N_USED, N_BIG, N_SMALL, /*broadcast=*/true);
+
+    if (rc1 == 0 && rc2 == 0) {
+        printf("[%s] VERDICT: both shapes PASS\n", name);
+    } else if (rc2 != 0 && rc1 == 0) {
+        printf("[%s] VERDICT: ***BROADCAST FAILS***, non-broadcast OK\n", name);
+        printf("  -> mul_mat_id has a bug specifically for b=[K,1,N] on this backend.\n");
+    } else if (rc1 != 0 && rc2 == 0) {
+        printf("[%s] VERDICT: non-broadcast fails, broadcast OK\n", name);
+    } else {
+        printf("[%s] VERDICT: both cases FAIL\n", name);
+    }
+}
+
+int main() {
+    const int K       = 2048;
+    const int M       = 768;
+    const int N       = 1;
+    const int N_USED  = 8;
+    const int N_BIG   = 128;
+    const int N_SMALL = 40;
+
+    const size_t per_expert_bytes = ggml_row_size(GGML_TYPE_Q4_K, K) * M;
+    std::vector<uint8_t> data_big(per_expert_bytes * N_BIG);
+
+    std::mt19937 rng(42);
+    auto frand = [&]() { return (float)((int32_t)(rng() % 2000) - 1000) / 1000.0f; };
+
+    std::vector<float> raw_f32((size_t) K * M);
+    for (int e = 0; e < N_BIG; ++e) {
+        for (auto & v : raw_f32) v = frand();
+        ggml_quantize_chunk(GGML_TYPE_Q4_K, raw_f32.data(),
+                            data_big.data() + (size_t) e * per_expert_bytes,
+                            0, M, K, NULL);
+    }
+
+    std::vector<float> b_data_big  ((size_t) K * N_USED * N);
+    std::vector<float> b_data_bcast((size_t) K * 1      * N);
+    for (auto & v : b_data_big)   v = frand();
+    for (auto & v : b_data_bcast) v = frand();
+
+    std::vector<int32_t> ids_data((size_t) N_USED * N);
+    for (int i = 0; i < N_USED * N; ++i) ids_data[i] = i % N_SMALL;
+
+    // Test on CPU
+    ggml_backend_t cpu_backend = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, NULL);
+    if (cpu_backend) {
+        run_on_backend(cpu_backend, "CPU", data_big, per_expert_bytes,
+                       b_data_big, b_data_bcast, ids_data,
+                       K, M, N, N_USED, N_BIG, N_SMALL);
+        ggml_backend_free(cpu_backend);
+    }
+
+    // Test on Vulkan with multiple N values
+    ggml_backend_t gpu_backend = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_GPU, NULL);
+
+    // Test multiple N values - pipeline uses N=9+ for prompt processing
+    for (int test_N : {1, 2, 9, 16}) {
+        printf("\n===== Testing N=%d (tokens) =====\n", test_N);
+
+        std::vector<float> b_big_N  ((size_t) K * N_USED * test_N);
+        std::vector<float> b_bcast_N((size_t) K * 1      * test_N);
+        for (auto & v : b_big_N)   v = frand();
+        for (auto & v : b_bcast_N) v = frand();
+
+        std::vector<int32_t> ids_N((size_t) N_USED * test_N);
+        for (int i = 0; i < N_USED * test_N; ++i) ids_N[i] = i % N_SMALL;
+
+        if (gpu_backend) {
+            run_on_backend(gpu_backend, ggml_backend_name(gpu_backend),
+                           data_big, per_expert_bytes,
+                           b_big_N, b_bcast_N, ids_N,
+                           K, M, test_N, N_USED, N_BIG, N_SMALL);
+        }
+    }
+
+    if (gpu_backend) ggml_backend_free(gpu_backend);
+
+    return 0;
+}
