+llama_neural_bus_k3_capsule::~llama_neural_bus_k3_capsule() {
+    if (buffer_) {
+        ggml_backend_buffer_free(buffer_);
+    }
+    if (ctx_) {
+        ggml_free(ctx_);
+    }
+}
