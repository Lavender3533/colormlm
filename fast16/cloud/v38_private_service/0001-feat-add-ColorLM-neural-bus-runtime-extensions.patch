diff --git a/src/llama-neural-bus.cpp b/src/llama-neural-bus.cpp
new file mode 100644
index 0000000..b121823
--- /dev/null
+++ b/src/llama-neural-bus.cpp
@@ -0,0 +1,808 @@
+#include "llama-neural-bus.h"
+
+#include "ggml-alloc.h"
+#include "llama-impl.h"
+#include "../vendor/nlohmann/json.hpp"
+
+extern "C" {
+#include "sha256.h"
+}
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cmath>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+static bool load_tensor_file(const std::filesystem::path & path, ggml_tensor * tensor) {
+    std::error_code error;
+    const uintmax_t file_size = std::filesystem::file_size(path, error);
+    if (error || file_size != ggml_nbytes(tensor)) {
+        return false;
+    }
+
+    std::vector<uint8_t> bytes((size_t) file_size);
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream.read((char *) bytes.data(), (std::streamsize) bytes.size())) {
+        return false;
+    }
+    ggml_backend_tensor_set(tensor, bytes.data(), 0, bytes.size());
+    return true;
+}
+
+static std::string sha256_file(const std::filesystem::path & path) {
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) {
+        throw std::runtime_error("cannot open tensor for SHA-256: " + path.string());
+    }
+
+    sha256_t context;
+    sha256_init(&context);
+    std::vector<unsigned char> buffer(1024 * 1024);
+    while (stream) {
+        stream.read(reinterpret_cast<char *>(buffer.data()), (std::streamsize) buffer.size());
+        const std::streamsize count = stream.gcount();
+        if (count > 0) {
+            sha256_update(&context, buffer.data(), (size_t) count);
+        }
+    }
+    if (!stream.eof()) {
+        throw std::runtime_error("failed while hashing tensor: " + path.string());
+    }
+
+    std::array<unsigned char, SHA256_DIGEST_SIZE> digest {};
+    sha256_final(&context, digest.data());
+    std::ostringstream encoded;
+    encoded << std::hex << std::setfill('0');
+    for (unsigned char value : digest) {
+        encoded << std::setw(2) << (unsigned int) value;
+    }
+    return encoded.str();
+}
+
+static bool is_sha256(const std::string & value) {
+    return value.size() == SHA256_DIGEST_SIZE * 2 &&
+        std::all_of(value.begin(), value.end(), [](unsigned char c) {
+            return std::isxdigit(c) != 0;
+        });
+}
+
+struct q4_manifest_info {
+    bool has_router = false;
+};
+
+static q4_manifest_info validate_q4_manifest(
+        const std::filesystem::path & directory,
+        int64_t n_embd,
+        int64_t n_ff) {
+    const std::filesystem::path manifest_path = directory / "capsule.json";
+    std::ifstream stream(manifest_path);
+    if (!stream) {
+        throw std::runtime_error("Q4 capsule requires capsule.json");
+    }
+
+    const nlohmann::json manifest = nlohmann::json::parse(stream);
+    const std::string format = manifest.at("format").get<std::string>();
+    const bool has_router = format == "colorlm-neural-bus-capsule-v2";
+    if ((!has_router && format != "colorlm-neural-bus-capsule-v1") ||
+        manifest.at("dtype").get<std::string>() != "Q4_0") {
+        throw std::runtime_error("unsupported Q4 capsule contract");
+    }
+    if (manifest.at("input_width").get<int64_t>() != n_embd ||
+        manifest.at("intermediate_width").get<int64_t>() != n_ff ||
+        manifest.at("output_width").get<int64_t>() != n_embd) {
+        throw std::runtime_error("Q4 capsule dimension mismatch");
+    }
+    if ((!has_router && manifest.at("activation").get<std::string>() != "SwiGLU") ||
+        (has_router && manifest.contains("activation") &&
+         manifest.at("activation").get<std::string>() != "SwiGLU")) {
+        throw std::runtime_error("Q4 capsule activation mismatch");
+    }
+
+    struct expected_file {
+        const char * key;
+        const char * file;
+        std::vector<int64_t> shape;
+        uintmax_t bytes;
+    };
+    const std::array<expected_file, 3> expected = {{
+        {"gate", "gate.q4_0", {n_embd, n_ff},
+            (uintmax_t) ggml_row_size(GGML_TYPE_Q4_0, n_embd) * n_ff},
+        {"up", "up.q4_0", {n_embd, n_ff},
+            (uintmax_t) ggml_row_size(GGML_TYPE_Q4_0, n_embd) * n_ff},
+        {"down", "down.q4_0", {n_ff, n_embd},
+            (uintmax_t) ggml_row_size(GGML_TYPE_Q4_0, n_ff) * n_embd},
+    }};
+
+    const auto & tensors = manifest.at("tensors");
+    if (!tensors.is_object() || tensors.size() != expected.size()) {
+        throw std::runtime_error("Q4 capsule must contain exactly three tensors");
+    }
+    for (const auto & item : expected) {
+        const auto & record = tensors.at(item.key);
+        const std::string file = record.at("file").get<std::string>();
+        const std::string digest = record.at("sha256").get<std::string>();
+        if (file != item.file ||
+            record.at("bytes").get<uintmax_t>() != item.bytes ||
+            !is_sha256(digest)) {
+            throw std::runtime_error(std::string("invalid Q4 tensor record: ") + item.key);
+        }
+        if (!has_router &&
+            record.at("ggml_shape").get<std::vector<int64_t>>() != item.shape) {
+            throw std::runtime_error(std::string("Q4 tensor shape mismatch: ") + item.key);
+        }
+
+        const std::filesystem::path tensor_path = directory / file;
+        std::error_code error;
+        if (std::filesystem::file_size(tensor_path, error) != item.bytes || error) {
+            throw std::runtime_error(std::string("Q4 tensor size mismatch: ") + item.key);
+        }
+        if (sha256_file(tensor_path) != digest) {
+            throw std::runtime_error(std::string("Q4 tensor SHA-256 mismatch: ") + item.key);
+        }
+    }
+
+    if (has_router) {
+        const auto & router = manifest.at("router");
+        const std::string file = router.at("file").get<std::string>();
+        const std::string digest = router.at("sha256").get<std::string>();
+        const uintmax_t bytes = (uintmax_t) n_embd * sizeof(float);
+        if (file != "router.f32" ||
+            router.at("dtype").get<std::string>() != "F32" ||
+            router.at("shape").get<std::vector<int64_t>>() !=
+                std::vector<int64_t>{n_embd, 1} ||
+            router.at("bytes").get<uintmax_t>() != bytes ||
+            !is_sha256(digest)) {
+            throw std::runtime_error("invalid Q4 router record");
+        }
+
+        const std::filesystem::path router_path = directory / file;
+        std::error_code error;
+        if (std::filesystem::file_size(router_path, error) != bytes || error ||
+            sha256_file(router_path) != digest) {
+            throw std::runtime_error("Q4 router validation failed");
+        }
+    }
+
+    return {has_router};
+}
+
+static void validate_intelligence_router_manifest(
+        const std::filesystem::path & directory,
+        int64_t n_embd,
+        const std::string & expected_manifest_sha256) {
+    const std::filesystem::path manifest_path = directory / "router.json";
+    if (!is_sha256(expected_manifest_sha256) ||
+        sha256_file(manifest_path) != expected_manifest_sha256) {
+        throw std::runtime_error("Intelligence Router manifest SHA-256 mismatch");
+    }
+
+    std::ifstream stream(manifest_path);
+    if (!stream) {
+        throw std::runtime_error("Intelligence Router requires router.json");
+    }
+    const nlohmann::json manifest = nlohmann::json::parse(stream);
+    if (manifest.at("format").get<std::string>() != "colorlm-intelligence-router-v1" ||
+        manifest.at("runtime_layout").get<std::string>() !=
+            "two-headerless-f32-le-row-major-v1" ||
+        manifest.at("input_width").get<int64_t>() != n_embd ||
+        manifest.at("route_count").get<int64_t>() != 3 ||
+        manifest.at("routes").get<std::vector<std::string>>() !=
+            std::vector<std::string>{"no_op", "coder", "k3"}) {
+        throw std::runtime_error("unsupported Intelligence Router contract");
+    }
+
+    struct expected_file {
+        const char * key;
+        const char * file;
+        std::vector<int64_t> shape;
+        uintmax_t bytes;
+    };
+    const std::array<expected_file, 2> expected = {{
+        {"weight", "weight.f32", {n_embd, 3},
+            (uintmax_t) n_embd * 3 * sizeof(float)},
+        {"bias", "bias.f32", {3}, 3 * sizeof(float)},
+    }};
+    const auto & tensors = manifest.at("tensors");
+    if (!tensors.is_object() || tensors.size() != expected.size()) {
+        throw std::runtime_error("Intelligence Router must contain exactly two tensors");
+    }
+    for (const auto & item : expected) {
+        const auto & record = tensors.at(item.key);
+        const std::string file = record.at("file").get<std::string>();
+        const std::string digest = record.at("sha256").get<std::string>();
+        if (file != item.file ||
+            record.at("dtype").get<std::string>() != "float32-le" ||
+            record.at("ggml_shape").get<std::vector<int64_t>>() != item.shape ||
+            record.at("bytes").get<uintmax_t>() != item.bytes ||
+            !is_sha256(digest)) {
+            throw std::runtime_error(
+                std::string("invalid Intelligence Router tensor record: ") + item.key);
+        }
+        const std::filesystem::path tensor_path = directory / file;
+        std::error_code error;
+        if (std::filesystem::file_size(tensor_path, error) != item.bytes || error) {
+            throw std::runtime_error(
+                std::string("Intelligence Router tensor size mismatch: ") + item.key);
+        }
+        if (sha256_file(tensor_path) != digest) {
+            throw std::runtime_error(
+                std::string("Intelligence Router tensor SHA-256 mismatch: ") + item.key);
+        }
+    }
+}
+
+struct k3_manifest_info {
+    int layer = -1;
+    int expert = -1;
+    float rms_norm_eps = 1e-5f;
+    bool has_router = false;
+    float router_l2_norm = 0.0f;
+    std::string transport_fingerprint;
+    ggml_type expert_type = GGML_TYPE_F16;
+    std::string expert_suffix = "f16";
+    ggml_type decode_expert_type = GGML_TYPE_F16;
+    std::string decode_expert_suffix = "f16";
+    bool hybrid_decode = false;
+};
+
+static k3_manifest_info validate_k3_manifest(
+        const std::filesystem::path & directory,
+        int64_t n_embd,
+        int64_t n_latent,
+        int64_t n_ff,
+        const std::string & expected_manifest_sha256) {
+    const std::filesystem::path manifest_path = directory / "capsule.json";
+    if (!expected_manifest_sha256.empty()) {
+        if (!is_sha256(expected_manifest_sha256) ||
+            sha256_file(manifest_path) != expected_manifest_sha256) {
+            throw std::runtime_error("K3 capsule manifest SHA-256 mismatch");
+        }
+    }
+
+    std::ifstream stream(manifest_path);
+    if (!stream) {
+        throw std::runtime_error("K3 capsule requires capsule.json");
+    }
+    const nlohmann::json manifest = nlohmann::json::parse(stream);
+    const std::string format = manifest.at("format").get<std::string>();
+    const bool expert_quantized = format == "colorlm-kimi-k3-latent-macro-capsule-v3";
+    const bool hybrid_decode = format == "colorlm-kimi-k3-latent-macro-capsule-v4";
+    const bool has_router =
+        format == "colorlm-kimi-k3-latent-macro-capsule-v2" ||
+        expert_quantized || hybrid_decode;
+    ggml_type expert_type = GGML_TYPE_F16;
+    std::string expert_dtype = "float16-le";
+    std::string expert_suffix = "f16";
+    if (expert_quantized) {
+        const std::string quantization = manifest.value(
+            "expert_quantization", std::string("Q4_0"));
+        if (quantization == "Q4_0") {
+            expert_type = GGML_TYPE_Q4_0;
+            expert_suffix = "q4_0";
+        } else if (quantization == "Q5_0") {
+            expert_type = GGML_TYPE_Q5_0;
+            expert_suffix = "q5_0";
+        } else if (quantization == "Q8_0") {
+            expert_type = GGML_TYPE_Q8_0;
+            expert_suffix = "q8_0";
+        } else if (quantization == "MXFP4") {
+            expert_type = GGML_TYPE_MXFP4;
+            expert_suffix = "mxfp4";
+        } else {
+            throw std::runtime_error("unsupported K3 expert quantization");
+        }
+        expert_dtype = quantization;
+    }
+    ggml_type decode_expert_type = GGML_TYPE_F16;
+    std::string decode_expert_dtype = "float16-le";
+    std::string decode_expert_suffix = "f16";
+    if (hybrid_decode) {
+        if (manifest.at("decode_expert_quantization").get<std::string>() != "MXFP4" ||
+            manifest.value("precision_policy", std::string{}) !=
+                "prefill_f16_decode_mxfp4") {
+            throw std::runtime_error("unsupported K3 hybrid precision policy");
+        }
+        decode_expert_type = GGML_TYPE_MXFP4;
+        decode_expert_dtype = "MXFP4";
+        decode_expert_suffix = "mxfp4";
+    }
+    const std::string runtime_layout = manifest.at("runtime_layout").get<std::string>();
+    const bool valid_layout = hybrid_decode
+        ? runtime_layout == "six-f16-three-mxfp4-decode-headerless-row-major-v1"
+        : expert_quantized
+            ? runtime_layout == "three-f16-three-quantized-headerless-row-major-v1" ||
+              (expert_type == GGML_TYPE_Q4_0 &&
+               runtime_layout == "three-f16-three-q4_0-headerless-row-major-v1")
+            : runtime_layout == "six-headerless-f16-le-row-major-v1";
+    if ((!has_router && format != "colorlm-kimi-k3-latent-macro-capsule-v1") ||
+        !valid_layout ||
+        manifest.at("repo").get<std::string>() != "moonshotai/Kimi-K3") {
+        throw std::runtime_error("unsupported K3 capsule contract");
+    }
+
+    const auto & dimensions = manifest.at("dimensions");
+    if (dimensions.at("colorlm").get<int64_t>() != n_embd ||
+        dimensions.at("latent").get<int64_t>() != n_latent ||
+        dimensions.at("intermediate").get<int64_t>() != n_ff) {
+        throw std::runtime_error("K3 capsule dimension mismatch");
+    }
+    const auto & activation = manifest.at("activation");
+    if (activation.at("name").get<std::string>() != "situ" ||
+        std::fabs(activation.at("beta").get<float>() - 4.0f) > 1e-6f ||
+        std::fabs(activation.at("linear_beta").get<float>() - 25.0f) > 1e-6f) {
+        throw std::runtime_error("K3 capsule activation mismatch");
+    }
+
+    struct expected_file {
+        const char * key;
+        std::string file;
+        std::string dtype;
+        std::vector<int64_t> shape;
+        uintmax_t bytes;
+    };
+    const uintmax_t gate_bytes = expert_quantized
+        ? (uintmax_t) ggml_row_size(expert_type, n_latent) * n_ff
+        : (uintmax_t) n_ff * n_latent * 2;
+    const uintmax_t down_bytes = expert_quantized
+        ? (uintmax_t) ggml_row_size(expert_type, n_ff) * n_latent
+        : (uintmax_t) n_latent * n_ff * 2;
+    std::vector<expected_file> expected = {
+        {"b_in",  "b_in.f16", "float16-le", {n_latent, n_embd}, (uintmax_t) n_latent * n_embd * 2},
+        {"gate",  "gate." + expert_suffix, expert_dtype, {n_ff, n_latent}, gate_bytes},
+        {"up",    "up." + expert_suffix, expert_dtype, {n_ff, n_latent}, gate_bytes},
+        {"down",  "down." + expert_suffix, expert_dtype, {n_latent, n_ff}, down_bytes},
+        {"norm",  "norm.f16", "float16-le", {n_latent}, (uintmax_t) n_latent * 2},
+        {"b_out", "b_out.f16", "float16-le", {n_embd, n_latent}, (uintmax_t) n_embd * n_latent * 2},
+    };
+    if (hybrid_decode) {
+        expected.push_back({"gate_decode", "gate_decode." + decode_expert_suffix,
+            decode_expert_dtype, {n_ff, n_latent},
+            (uintmax_t) ggml_row_size(decode_expert_type, n_latent) * n_ff});
+        expected.push_back({"up_decode", "up_decode." + decode_expert_suffix,
+            decode_expert_dtype, {n_ff, n_latent},
+            (uintmax_t) ggml_row_size(decode_expert_type, n_latent) * n_ff});
+        expected.push_back({"down_decode", "down_decode." + decode_expert_suffix,
+            decode_expert_dtype, {n_latent, n_ff},
+            (uintmax_t) ggml_row_size(decode_expert_type, n_ff) * n_latent});
+    }
+
+    const auto & files = manifest.at("runtime_files");
+    if (!files.is_object() || files.size() != expected.size()) {
+        throw std::runtime_error("K3 capsule runtime tensor count mismatch");
+    }
+    uintmax_t total_bytes = 0;
+    std::string transport_fingerprint;
+    for (const auto & item : expected) {
+        const auto & record = files.at(item.key);
+        const std::string file = record.at("file").get<std::string>();
+        const std::string digest = record.at("sha256").get<std::string>();
+        if (file != item.file ||
+            record.at("dtype").get<std::string>() != item.dtype ||
+            record.at("shape").get<std::vector<int64_t>>() != item.shape ||
+            record.at("bytes").get<uintmax_t>() != item.bytes ||
+            !is_sha256(digest)) {
+            throw std::runtime_error(std::string("invalid K3 tensor record: ") + item.key);
+        }
+        const std::filesystem::path tensor_path = directory / file;
+        std::error_code error;
+        if (std::filesystem::file_size(tensor_path, error) != item.bytes || error) {
+            throw std::runtime_error(std::string("K3 tensor size mismatch: ") + item.key);
+        }
+        if (sha256_file(tensor_path) != digest) {
+            throw std::runtime_error(std::string("K3 tensor SHA-256 mismatch: ") + item.key);
+        }
+        if (std::string(item.key) == "b_in" ||
+            std::string(item.key) == "norm" ||
+            std::string(item.key) == "b_out") {
+            transport_fingerprint += std::string(item.key) + ":" + digest + ";";
+        }
+        total_bytes += item.bytes;
+    }
+    if (manifest.at("runtime_total_bytes").get<uintmax_t>() != total_bytes) {
+        throw std::runtime_error("K3 capsule total byte count mismatch");
+    }
+
+    k3_manifest_info result;
+    result.layer = manifest.at("layer").get<int>();
+    result.expert = manifest.at("expert").get<int>();
+    result.rms_norm_eps = manifest.at("rms_norm_eps").get<float>();
+    result.transport_fingerprint = std::move(transport_fingerprint);
+    result.expert_type = expert_type;
+    result.expert_suffix = std::move(expert_suffix);
+    result.decode_expert_type = decode_expert_type;
+    result.decode_expert_suffix = std::move(decode_expert_suffix);
+    result.hybrid_decode = hybrid_decode;
+    if (result.layer < 0 || result.expert < 0 ||
+        std::fabs(result.rms_norm_eps - 1e-5f) > 1e-8f) {
+        throw std::runtime_error("K3 capsule source metadata mismatch");
+    }
+    if (has_router) {
+        const auto & router = manifest.at("runtime_router");
+        const std::string file = router.at("file").get<std::string>();
+        const std::string digest = router.at("sha256").get<std::string>();
+        const uintmax_t bytes = (uintmax_t) n_embd * sizeof(float);
+        const float l2_norm = router.at("l2_norm").get<float>();
+        if (file != "router.f32" ||
+            router.at("dtype").get<std::string>() != "float32-le" ||
+            router.at("shape").get<std::vector<int64_t>>() != std::vector<int64_t>{n_embd} ||
+            router.at("bytes").get<uintmax_t>() != bytes ||
+            !is_sha256(digest) || !std::isfinite(l2_norm) || l2_norm <= 1e-6f) {
+            throw std::runtime_error("invalid K3 runtime router record");
+        }
+        const std::filesystem::path router_path = directory / file;
+        std::error_code error;
+        if (std::filesystem::file_size(router_path, error) != bytes || error ||
+            sha256_file(router_path) != digest) {
+            throw std::runtime_error("K3 runtime router validation failed");
+        }
+        result.has_router = true;
+        result.router_l2_norm = l2_norm;
+    }
+    return result;
+}
