+            ffn_delta = ggml_map_custom1(
+                ctx0, ggml_cont(ctx0, ffn_delta),
+                q35_neural_island_l47_moe_dump_cb, 1,
+                (void *) (uintptr_t) 1u);
+        }
+        donor = ggml_add(ctx0, attn_residual, ffn_delta);
+        if (q35_neural_island_stage_dump_enabled()) {
+            ggml_tensor * layer_delta = ggml_sub(ctx0, donor, layer_input);
+            layer_delta = ggml_map_custom1(
+                ctx0, ggml_cont(ctx0, layer_delta),
+                q35_neural_island_stage_dump_cb, 1,
+                (void *) (uintptr_t) ((source_layer << 1) | 1u));
+            donor = ggml_add(
+                ctx0, donor, ggml_scale(ctx0, layer_delta, 0.0f));
+        }
+        const std::string layer_output_name =
+            "neural_island_layer_out_" + std::to_string(source_layer);
+        cb(donor, layer_output_name.c_str(), il);
+    }
+
+    ggml_tensor * donor_delta = ggml_sub(ctx0, donor, donor_entry);
+    ggml_tensor * target_delta = ggml_mul_mat(
+        ctx0, weight(last, "colorlm.neural_block.transport_out.weight"), donor_delta);
+    cb(target_delta, "neural_island_transport_out", il);
+    return {target_delta, donor};
+}
+
+ggml_tensor * llama_model_qwen35moe::graph::build_neural_block_delta(
+        llama_neural_block * block,
+        llm_graph_input_attn_kv * inp_attn,
+        ggml_tensor * hidden,
+        ggml_tensor * inp_pos,
+        int il) {
+    constexpr int64_t donor_hidden = 2048;
+    constexpr int64_t donor_heads = 16;
+    constexpr int64_t donor_kv_heads = 2;
+    constexpr int64_t donor_head_dim = 256;
+    constexpr int64_t donor_rotary_dim = 64;
+    constexpr float donor_rope_theta = 5000000.0f;
+
+    GGML_ASSERT(block != nullptr && inp_attn != nullptr);
+    GGML_ASSERT(hidden->ne[0] == donor_hidden);
+
+    const auto weight = [&](const char * name) {
+        ggml_tensor * result = block->tensor(name);
+        GGML_ASSERT(result != nullptr);
+        return result;
+    };
+    ggml_tensor * donor_input = ggml_mul_mat(
+        ctx0, weight("colorlm.neural_block.transport_in.weight"), hidden);
+    cb(donor_input, "neural_block_transport_in", il);
+
+    ggml_tensor * attn_input = build_norm(
+        donor_input, weight("model.layers.47.input_layernorm.weight"),
+        nullptr, LLM_NORM_RMS, il);
+    cb(attn_input, "neural_block_attn_norm", il);
+
+    ggml_tensor * q_gate = ggml_mul_mat(
+        ctx0, weight("model.layers.47.self_attn.q_proj.weight"), attn_input);
+    ggml_tensor * q = ggml_view_3d(
+        ctx0, q_gate, donor_head_dim, donor_heads, n_tokens,
+        ggml_element_size(q_gate) * donor_head_dim * 2,
+        ggml_element_size(q_gate) * donor_head_dim * 2 * donor_heads, 0);
+    ggml_tensor * output_gate = ggml_view_3d(
+        ctx0, q_gate, donor_head_dim, donor_heads, n_tokens,
+        ggml_element_size(q_gate) * donor_head_dim * 2,
+        ggml_element_size(q_gate) * donor_head_dim * 2 * donor_heads,
+        ggml_element_size(q_gate) * donor_head_dim);
+    ggml_tensor * k = ggml_mul_mat(
+        ctx0, weight("model.layers.47.self_attn.k_proj.weight"), attn_input);
+    ggml_tensor * v = ggml_mul_mat(
+        ctx0, weight("model.layers.47.self_attn.v_proj.weight"), attn_input);
+    k = ggml_reshape_3d(ctx0, k, donor_head_dim, donor_kv_heads, n_tokens);
+    v = ggml_reshape_3d(ctx0, v, donor_head_dim, donor_kv_heads, n_tokens);
+    q = build_norm(
+        q, weight("model.layers.47.self_attn.q_norm.weight"),
+        nullptr, LLM_NORM_RMS, il);
+    k = build_norm(
+        k, weight("model.layers.47.self_attn.k_norm.weight"),
+        nullptr, LLM_NORM_RMS, il);
+    // ColorLM supplies four MRoPE position tracks. The Qwen3Next donor block
+    // uses ordinary NeoX RoPE, so it consumes only the temporal track.
+    ggml_tensor * donor_pos = ggml_view_1d(ctx0, inp_pos, n_tokens, 0);
+    q = ggml_rope_ext(
+        ctx0, q, donor_pos, nullptr, donor_rotary_dim, GGML_ROPE_TYPE_NEOX,
+        n_ctx_orig, donor_rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+    k = ggml_rope_ext(
+        ctx0, k, donor_pos, nullptr, donor_rotary_dim, GGML_ROPE_TYPE_NEOX,
+        n_ctx_orig, donor_rope_theta, 1.0f, 0.0f, 1.0f, 0.0f, 0.0f);
+    cb(q, "neural_block_q", il);
+    cb(k, "neural_block_k", il);
+    cb(v, "neural_block_v", il);
+
+    // The donor block must not write into the host layer's KV slot. Doing so
+    // replaces ColorLM's cached K/V after its native attention has run, so the
+    // next token reads donor coordinates as native coordinates. Keep v16.1
+    // causal and cache-isolated by attending only inside the current ubatch.
+    // v17 will give the multi-layer donor island its own bounded KV memory.
+    ggml_tensor * mask_shape = ggml_new_tensor_2d(
+        ctx0, GGML_TYPE_F32, n_tokens, n_tokens);
+    ggml_tensor * graph_zero = ggml_scale(ctx0, ggml_sum(ctx0, q), 0.0f);
+    ggml_tensor * local_mask = ggml_repeat(
+        ctx0, graph_zero, mask_shape);
+    local_mask = ggml_diag_mask_inf(ctx0, local_mask, 0);
+    if (cparams.flash_attn) {
+        local_mask = ggml_cast(ctx0, local_mask, GGML_TYPE_F16);
+    }
+    ggml_tensor * attn_output = build_attn_mha(
+        q, k, v, nullptr, local_mask, nullptr, nullptr,
+        1.0f / std::sqrt((float) donor_head_dim), il);
+    output_gate = ggml_cont_2d(
+        ctx0, output_gate, donor_head_dim * donor_heads, n_tokens);
+    attn_output = ggml_mul(ctx0, attn_output, ggml_sigmoid(ctx0, output_gate));
+    attn_output = ggml_mul_mat(
+        ctx0, weight("model.layers.47.self_attn.o_proj.weight"), attn_output);
+    ggml_tensor * attn_residual = ggml_add(ctx0, donor_input, attn_output);
+    cb(attn_residual, "neural_block_attn_residual", il);
+
+    ggml_tensor * ffn_input = build_norm(
+        attn_residual, weight("model.layers.47.post_attention_layernorm.weight"),
+        nullptr, LLM_NORM_RMS, il);
+    ggml_tensor * moe = build_moe_ffn(
+        ffn_input,
+        weight("model.layers.47.mlp.gate.weight"),
+        block->experts_up(), block->experts_gate(), block->experts_down(),
+        nullptr, block->expert_count(), block->experts_per_token(),
+        LLM_FFN_SILU, true, 1.0f,
+        LLAMA_EXPERT_GATING_FUNC_TYPE_SOFTMAX, il);
+    ggml_tensor * shared = build_ffn(
+        ffn_input,
+        weight("model.layers.47.mlp.shared_expert.up_proj.weight"), nullptr, nullptr,
+        weight("model.layers.47.mlp.shared_expert.gate_proj.weight"), nullptr, nullptr,
+        weight("model.layers.47.mlp.shared_expert.down_proj.weight"), nullptr, nullptr,
+        nullptr, LLM_FFN_SILU, LLM_FFN_PAR, il);
+    ggml_tensor * shared_gate = ggml_sigmoid(ctx0, ggml_mul_mat(
+        ctx0, weight("model.layers.47.mlp.shared_expert_gate.weight"), ffn_input));
+    shared = ggml_mul(ctx0, shared, shared_gate);
+    ggml_tensor * donor_output = ggml_add(
+        ctx0, attn_residual, ggml_add(ctx0, moe, shared));
+    ggml_tensor * donor_delta = ggml_sub(ctx0, donor_output, donor_input);
+    ggml_tensor * target_delta = ggml_mul_mat(
+        ctx0, weight("colorlm.neural_block.transport_out.weight"), donor_delta);
+    cb(target_delta, "neural_block_transport_out", il);
+    return target_delta;
+}
