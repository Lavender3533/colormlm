diff --git a/src/llama-alloy.cpp b/src/llama-alloy.cpp
new file mode 100644
index 0000000..4eb69de
--- /dev/null
+++ b/src/llama-alloy.cpp
@@ -0,0 +1,232 @@
+#include "llama-alloy.h"
+
+#include "llama-impl.h"
+#include "llama-mmap.h"
+
+#include "ggml.h"
+#include "../vendor/nlohmann/json.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace {
+
+constexpr std::array<char, 8> ALLOY_MAGIC = {'C', 'L', 'M', 'A', 'L', 'Y', '0', '1'};
+constexpr uint32_t ALLOY_VERSION = 1;
+constexpr uint32_t ALLOY_BITS = 3;
+constexpr uint32_t ALLOY_GROUP_SIZE = 64;
+constexpr uint32_t ALLOY_BLOCK_BYTES = 26;
+constexpr size_t ALLOY_HEADER_BYTES = 72;
+constexpr size_t ALLOY_DATA_ALIGNMENT = 4096;
+
+size_t align_up(size_t value, size_t alignment) {
+    return (value + alignment - 1) / alignment * alignment;
+}
+
+template <typename T>
+T read_scalar(const uint8_t * data, size_t size, size_t & offset) {
+    if (offset + sizeof(T) > size) {
+        throw std::runtime_error("truncated Neural Alloy header");
+    }
+    T value {};
+    memcpy(&value, data + offset, sizeof(value));
+    offset += sizeof(value);
+    return value;
+}
+
+struct alloy_weight {
+    std::string name;
+    int64_t ne0 = 0;
+    int64_t ne1 = 0;
+    uint64_t logical_count = 0;
+    uint64_t group_count = 0;
+    const uint8_t * blocks = nullptr;
+    float alpha = 1.0f;
+};
+
+int8_t decode_q3(const uint8_t * block, uint32_t index) {
+    const uint32_t chunk = index / 8;
+    const uint32_t within = index % 8;
+    const uint8_t * packed = block + 2 + chunk * 3;
+    const uint32_t word = (uint32_t) packed[0] |
+        ((uint32_t) packed[1] << 8) |
+        ((uint32_t) packed[2] << 16);
+    return (int8_t) ((word >> (within * ALLOY_BITS)) & 7u) - 3;
+}
+
+void alloy_mul_mat_cpu(
+        ggml_tensor * dst,
+        int ith,
+        int nth,
+        void * userdata) {
+    const auto * weight = static_cast<const alloy_weight *>(userdata);
+    const ggml_tensor * input = dst->src[0];
+
+    GGML_ASSERT(input != nullptr);
+    GGML_ASSERT(input->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(input));
+    GGML_ASSERT(ggml_is_contiguous(dst));
+    GGML_ASSERT(input->ne[0] == weight->ne0);
+    GGML_ASSERT(dst->ne[0] == weight->ne1);
+
+    const int64_t input_size = weight->ne0;
+    const int64_t output_size = weight->ne1;
+    const int64_t columns = input->ne[1] * input->ne[2] * input->ne[3];
+    const float * input_data = static_cast<const float *>(input->data);
+    float * output_data = static_cast<float *>(dst->data);
+
+    for (int64_t job = ith; job < columns * output_size; job += nth) {
+        const int64_t column = job / output_size;
+        const int64_t output_row = job % output_size;
+        const float * x = input_data + column * input_size;
+        float sum = 0.0f;
+
+        const uint64_t row_start = (uint64_t) output_row * input_size;
+        for (int64_t input_col = 0; input_col < input_size; ++input_col) {
+            const uint64_t linear = row_start + input_col;
+            const uint64_t group = linear / ALLOY_GROUP_SIZE;
+            const uint32_t within = (uint32_t) (linear % ALLOY_GROUP_SIZE);
+            const uint8_t * block = weight->blocks + group * ALLOY_BLOCK_BYTES;
+            ggml_fp16_t scale_bits;
+            memcpy(&scale_bits, block, sizeof(scale_bits));
+            const float scale = ggml_fp16_to_fp32(scale_bits);
+            sum += scale * decode_q3(block, within) * x[input_col];
+        }
+        output_data[column * output_size + output_row] = weight->alpha * sum;
+    }
+}
+
+class alloy_registry {
+public:
+    alloy_registry() {
+        const char * path = getenv("COLORLM_ALLOY_Q3_PATH");
+        if (path == nullptr || path[0] == '\0') {
+            return;
+        }
+        const char * raw_alpha = getenv("COLORLM_ALLOY_ALPHA");
+        alpha = raw_alpha ? std::clamp((float) atof(raw_alpha), -2.0f, 2.0f) : 1.0f;
+
+        file = std::make_unique<llama_file>(path, "rb");
+        mapping = std::make_unique<llama_mmap>(file.get(), 0, false);
+        const auto * data = static_cast<const uint8_t *>(mapping->addr());
+        const size_t size = mapping->size();
+        if (size < ALLOY_HEADER_BYTES) {
+            throw std::runtime_error("Neural Alloy container is too small");
+        }
+
+        size_t offset = 0;
+        std::array<char, 8> magic {};
+        memcpy(magic.data(), data, magic.size());
+        offset += magic.size();
+        if (magic != ALLOY_MAGIC) {
+            throw std::runtime_error("invalid Neural Alloy magic");
+        }
+        const uint32_t version = read_scalar<uint32_t>(data, size, offset);
+        const uint32_t bits = read_scalar<uint32_t>(data, size, offset);
+        const uint32_t group_size = read_scalar<uint32_t>(data, size, offset);
+        const uint32_t block_bytes = read_scalar<uint32_t>(data, size, offset);
+        const uint64_t tensor_count = read_scalar<uint64_t>(data, size, offset);
+        const uint64_t manifest_bytes = read_scalar<uint64_t>(data, size, offset);
+        offset += 32; // SHA-256 is validated by the standalone verifier.
+
+        if (version != ALLOY_VERSION || bits != ALLOY_BITS ||
+            group_size != ALLOY_GROUP_SIZE || block_bytes != ALLOY_BLOCK_BYTES) {
+            throw std::runtime_error("unsupported Neural Alloy codec");
+        }
+        if (offset + manifest_bytes > size) {
+            throw std::runtime_error("truncated Neural Alloy manifest");
+        }
+        const auto manifest = nlohmann::json::parse(
+            reinterpret_cast<const char *>(data + offset),
+            reinterpret_cast<const char *>(data + offset + manifest_bytes));
+        const auto & tensors = manifest.at("tensors");
+        if (tensors.size() != tensor_count) {
+            throw std::runtime_error("Neural Alloy tensor count mismatch");
+        }
+
+        const size_t data_start = align_up(ALLOY_HEADER_BYTES + manifest_bytes, ALLOY_DATA_ALIGNMENT);
+        for (const auto & item : tensors) {
+            const auto shape = item.at("shape").get<std::vector<int64_t>>();
+            if (shape.size() != 2) {
+                continue;
+            }
+            alloy_weight weight;
+            weight.name = item.at("name").get<std::string>();
+            weight.ne0 = shape[0];
+            weight.ne1 = shape[1];
+            weight.logical_count = item.at("logical_count").get<uint64_t>();
+            weight.group_count = item.at("group_count").get<uint64_t>();
+            weight.alpha = alpha;
+            const size_t tensor_offset = item.at("offset").get<size_t>();
+            const size_t tensor_bytes = item.at("bytes").get<size_t>();
+            if (data_start + tensor_offset + tensor_bytes > size ||
+                tensor_bytes != weight.group_count * ALLOY_BLOCK_BYTES ||
+                weight.logical_count != (uint64_t) weight.ne0 * weight.ne1) {
+                throw std::runtime_error("invalid Neural Alloy tensor record: " + weight.name);
+            }
+            weight.blocks = data + data_start + tensor_offset;
+            weights.emplace(weight.name, std::move(weight));
+        }
+        LLAMA_LOG_INFO(
+            "Neural Alloy: mapped %zu 2D q3_g64 tensors from %s (alpha=%.4f)\n",
+            weights.size(), path, alpha);
+    }
+
+    const alloy_weight * find(const ggml_tensor * tensor) const {
+        if (!tensor || weights.empty()) {
+            return nullptr;
+        }
+        const auto found = weights.find(tensor->name);
+        if (found == weights.end()) {
+            return nullptr;
+        }
+        if (found->second.ne0 != tensor->ne[0] || found->second.ne1 != tensor->ne[1]) {
+            throw std::runtime_error("Neural Alloy tensor shape mismatch: " + found->second.name);
+        }
+        return &found->second;
+    }
+
+private:
+    float alpha = 1.0f;
+    std::unique_ptr<llama_file> file;
+    std::unique_ptr<llama_mmap> mapping;
+    std::unordered_map<std::string, alloy_weight> weights;
+};
+
+alloy_registry & registry() {
+    static alloy_registry instance;
+    return instance;
+}
+
+} // namespace
+
+ggml_tensor * llama_alloy_build_delta_mm(
+        ggml_context * ctx,
+        ggml_tensor  * weight,
+        ggml_tensor  * input) {
+    const alloy_weight * alloy = registry().find(weight);
+    if (alloy == nullptr || alloy->alpha == 0.0f) {
+        return nullptr;
+    }
+    ggml_tensor * contiguous = ggml_cont(ctx, input);
+    ggml_tensor * args[] = {contiguous};
+    return ggml_custom_4d(
+        ctx,
+        GGML_TYPE_F32,
+        weight->ne[1], input->ne[1], input->ne[2], input->ne[3],
+        args, 1,
+        alloy_mul_mat_cpu,
+        GGML_N_TASKS_MAX,
+        const_cast<alloy_weight *>(alloy));
+}
