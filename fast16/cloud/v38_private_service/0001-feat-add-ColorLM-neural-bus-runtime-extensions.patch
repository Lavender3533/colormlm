+llama_neural_bus_intelligence_router::~llama_neural_bus_intelligence_router() {
+    if (buffer_) {
+        ggml_backend_buffer_free(buffer_);
+    }
+    if (ctx_) {
+        ggml_free(ctx_);
+    }
+}
+
+ggml_tensor * llama_neural_bus_intelligence_router::build_logits(
+        ggml_context * ctx, ggml_tensor * input) const {
+    ggml_tensor * input_l2 = ggml_sqrt(
+        ctx, ggml_sum_rows(ctx, ggml_sqr(ctx, input)));
+    input_l2 = ggml_clamp(ctx, input_l2, 1e-8f, INFINITY);
+    ggml_tensor * normalized = ggml_div(
+        ctx, input, ggml_repeat(ctx, input_l2, input));
+    ggml_tensor * logits = ggml_mul_mat(ctx, weight_, normalized);
+    return ggml_add(ctx, logits, ggml_repeat(ctx, bias_, logits));
+}
+
+size_t llama_neural_bus_intelligence_router::weight_bytes() const {
+    return ggml_nbytes(weight_) + ggml_nbytes(bias_);
+}
