+#pragma once
+
+#include "llama-slot-pool.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+// Exact GPU cache for one Neural Island MoE layer.
+//
+// The complete expert bank remains in host-visible memory. Before the cached
+// MoE graph consumes its logical expert ids, ensure_resident() synchronously
+// uploads every miss and the matching logical-to-slot LUT. It is therefore
+// exact for a decode step whose distinct selected expert count fits in slots.
+class llama_neural_expert_cache {
+public:
+    struct config {
+        uint32_t slots = 0;
+        ggml_backend_buffer_type_t gpu_buft = nullptr;
+        int32_t source_layer = -1;
+        bool batch_upload = true;
+        uint32_t max_batch_experts = 0;
+        // 0 keeps exact LRU. A value in (0, 1] enables decayed-LFU
+        // eviction with recency as the deterministic tie-breaker.
+        float frequency_decay = 0.0f;
+    };
+
+    struct stats {
+        uint64_t steps = 0;
+        uint64_t hits = 0;
+        uint64_t misses = 0;
+        uint64_t upload_bytes = 0;
+        uint64_t upload_batches = 0;
+        uint64_t weight_upload_calls = 0;
+        uint32_t resident = 0;
+        uint32_t capacity = 0;
+        int32_t source_layer = -1;
+    };
+
+    static std::unique_ptr<llama_neural_expert_cache> create(
+        ggml_tensor * source_gate,
+        ggml_tensor * source_up,
+        ggml_tensor * source_down,
+        const config & cfg);
+
+    ~llama_neural_expert_cache();
+
+    llama_neural_expert_cache(const llama_neural_expert_cache &) = delete;
+    llama_neural_expert_cache & operator=(const llama_neural_expert_cache &) = delete;
+
+    // Makes every distinct logical expert resident, uploads the LUT, and waits
+    // for completion before returning. False means the exactness contract could
+    // not be met; callers must not execute the cached MoE branch in that case.
+    bool ensure_resident(
+        const int32_t * logical_experts,
+        size_t count,
+        stats * snapshot = nullptr);
+
+    slot_pool * pool() const;
+    uint32_t slots() const;
+    uint32_t logical_experts() const;
+    bool batch_upload_enabled() const;
+    stats get_stats() const;
+
+private:
+    llama_neural_expert_cache() = default;
+
+    ggml_tensor * source_gate_ = nullptr;
+    ggml_tensor * source_up_ = nullptr;
+    ggml_tensor * source_down_ = nullptr;
+    std::unique_ptr<slot_pool> pool_;
+    ggml_backend_t upload_backend_ = nullptr;
+    ggml_backend_buffer_t staging_buffer_ = nullptr;
+    uint8_t * staging_data_ = nullptr;
+    uint32_t staging_experts_ = 0;
+    bool batch_upload_ = true;
+    float frequency_decay_ = 0.0f;
+    std::vector<int32_t> slot_to_expert_;
+    std::vector<uint64_t> slot_last_use_;
+    std::vector<float> slot_frequency_;
+    uint64_t tick_ = 0;
+    stats stats_{};
+    mutable std::mutex mutex_;
+};
diff --git a/src/llama-neural-micro-stage.cpp b/src/llama-neural-micro-stage.cpp
new file mode 100644
index 0000000..55ac42a
--- /dev/null
+++ b/src/llama-neural-micro-stage.cpp
@@ -0,0 +1,217 @@
+#include "llama-neural-micro-stage.h"
+
+#include "llama-impl.h"
+#include "../vendor/nlohmann/json.hpp"
+
+extern "C" {
+#include "sha256.h"
+}
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cstdint>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <limits>
+#include <sstream>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+
+struct tensor_load_record {
+    ggml_tensor * tensor = nullptr;
+    uint64_t offset = 0;
+    uint64_t bytes = 0;
+    std::string sha256;
+};
+
+static std::string sha256_bytes(const uint8_t * data, size_t size) {
+    sha256_t context;
+    sha256_init(&context);
+    sha256_update(&context, data, size);
+    std::array<unsigned char, SHA256_DIGEST_SIZE> digest {};
+    sha256_final(&context, digest.data());
+    std::ostringstream encoded;
+    encoded << std::hex << std::setfill('0');
+    for (unsigned char value : digest) {
+        encoded << std::setw(2) << (unsigned int) value;
+    }
+    return encoded.str();
+}
+
+static std::string sha256_file(const std::filesystem::path & path) {
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) {
+        throw std::runtime_error("cannot open Neural Micro Stage file: " + path.string());
+    }
+    sha256_t context;
+    sha256_init(&context);
+    std::vector<unsigned char> buffer(1024 * 1024);
+    while (stream) {
+        stream.read(reinterpret_cast<char *>(buffer.data()), (std::streamsize) buffer.size());
+        const std::streamsize count = stream.gcount();
+        if (count > 0) {
+            sha256_update(&context, buffer.data(), (size_t) count);
+        }
+    }
+    if (!stream.eof()) {
+        throw std::runtime_error("failed while hashing Neural Micro Stage file");
+    }
+    std::array<unsigned char, SHA256_DIGEST_SIZE> digest {};
+    sha256_final(&context, digest.data());
+    std::ostringstream encoded;
+    encoded << std::hex << std::setfill('0');
+    for (unsigned char value : digest) {
+        encoded << std::setw(2) << (unsigned int) value;
+    }
+    return encoded.str();
+}
+
+static bool is_sha256(const std::string & value) {
+    return value.size() == SHA256_DIGEST_SIZE * 2 &&
+        std::all_of(value.begin(), value.end(), [](unsigned char c) {
+            return std::isxdigit(c) != 0;
+        });
+}
+
+} // namespace
+
+std::unique_ptr<llama_neural_micro_stage> llama_neural_micro_stage::load_linear_f16(
+        const std::filesystem::path & directory,
+        ggml_backend_buffer_type_t buft,
+        bool verify_weights_sha256) {
+    if (!buft) {
+        return nullptr;
+    }
+    std::ifstream manifest_stream(directory / "micro_stage.json");
+    if (!manifest_stream) {
+        throw std::runtime_error("Neural Micro Stage requires micro_stage.json");
+    }
+    const nlohmann::json manifest = nlohmann::json::parse(manifest_stream);
+    if (manifest.at("format").get<std::string>() !=
+            "colorlm-neural-micro-stage-runtime-v1" ||
+        !manifest.at("candidate").get<bool>() ||
+        manifest.at("runtime_layout").get<std::string>() !=
+            "single-aligned-tensor-blob-v1" ||
+        manifest.at("alignment").get<uint64_t>() != 64) {
+        throw std::runtime_error("unsupported Neural Micro Stage contract");
+    }
+    const int source_layer = manifest.at("source_layer").get<int>();
+    const int hidden_size = manifest.at("hidden_size").get<int>();
+    const int rank = manifest.at("rank").get<int>();
+    if (source_layer != 47 || hidden_size != 2048 || rank <= 0 || rank > 256) {
+        throw std::runtime_error("unsupported Neural Micro Stage dimensions");
+    }
+    const auto & records = manifest.at("tensors");
+    if (!records.is_array() || records.size() != 3 ||
+        records.size() != manifest.at("tensor_count").get<size_t>()) {
+        throw std::runtime_error("Neural Micro Stage requires exactly three tensors");
+    }
+    const auto & weights = manifest.at("weights");
+    const std::filesystem::path weights_path = directory / weights.at("file").get<std::string>();
+    const uint64_t weights_bytes = weights.at("bytes").get<uint64_t>();
+    const std::string weights_sha256 = weights.at("sha256").get<std::string>();
+    std::error_code error;
+    if (!is_sha256(weights_sha256) ||
+        std::filesystem::file_size(weights_path, error) != weights_bytes || error) {
+        throw std::runtime_error("Neural Micro Stage weights contract mismatch");
+    }
+    if (verify_weights_sha256 && sha256_file(weights_path) != weights_sha256) {
+        throw std::runtime_error("Neural Micro Stage weights SHA-256 mismatch");
+    }
+
+    auto stage = std::unique_ptr<llama_neural_micro_stage>(new llama_neural_micro_stage());
+    stage->source_layer_ = source_layer;
+    stage->hidden_size_ = hidden_size;
+    stage->rank_ = rank;
+    ggml_init_params params = {
+        /*.mem_size   =*/ (records.size() + 1) * ggml_tensor_overhead() + 64 * 1024,
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    stage->ctx_ = ggml_init(params);
+    if (!stage->ctx_) {
+        return nullptr;
+    }
+    std::vector<tensor_load_record> loads;
+    uint64_t previous_end = 0;
+    for (size_t index = 0; index < records.size(); ++index) {
+        const auto & record = records.at(index);
+        const std::string name = record.at("name").get<std::string>();
+        const std::string dtype = record.at("dtype").get<std::string>();
+        const std::string digest = record.at("sha256").get<std::string>();
+        const std::vector<int64_t> shape = record.at("ggml_shape").get<std::vector<int64_t>>();
+        const uint64_t offset = record.at("offset").get<uint64_t>();
+        const uint64_t bytes = record.at("bytes").get<uint64_t>();
+        const ggml_type type = dtype == "F16" ? GGML_TYPE_F16 :
+            (dtype == "F32" ? GGML_TYPE_F32 : GGML_TYPE_COUNT);
+        if (name.empty() || type == GGML_TYPE_COUNT || !is_sha256(digest) || shape.empty() ||
+            shape.size() > 2 || offset % 64 != 0 || offset < previous_end ||
+            bytes > weights_bytes || offset > weights_bytes - bytes) {
+            throw std::runtime_error("invalid Neural Micro Stage tensor: " + name);
+        }
+        ggml_tensor * tensor = ggml_new_tensor(
+            stage->ctx_, type, (int) shape.size(), shape.data());
+        if (ggml_nbytes(tensor) != bytes || !stage->tensors_.emplace(name, tensor).second) {
+            throw std::runtime_error("Neural Micro Stage tensor mismatch: " + name);
+        }
+        const std::string runtime_name = "neural_micro_stage." + std::to_string(index);
+        ggml_set_name(tensor, runtime_name.c_str());
+        loads.push_back({tensor, offset, bytes, digest});
+        previous_end = offset + bytes;
+    }
+    const auto require = [&](const std::string & name, ggml_type type,
+                             int64_t ne0, int64_t ne1) {
+        const auto found = stage->tensors_.find(name);
+        if (found == stage->tensors_.end() || found->second->type != type ||
+            found->second->ne[0] != ne0 || found->second->ne[1] != ne1) {
+            throw std::runtime_error("missing Neural Micro Stage tensor: " + name);
+        }
+    };
+    require("input.weight", GGML_TYPE_F16, hidden_size, rank);
+    require("output.weight", GGML_TYPE_F16, rank, hidden_size);
+    require("output.bias", GGML_TYPE_F32, hidden_size, 1);
+
+    stage->buffer_ = ggml_backend_alloc_ctx_tensors_from_buft(stage->ctx_, buft);
+    if (!stage->buffer_) {
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(stage->buffer_, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    std::ifstream blob(weights_path, std::ios::binary);
+    std::vector<uint8_t> scratch;
+    for (const auto & record : loads) {
+        scratch.resize((size_t) record.bytes);
+        blob.seekg((std::streamoff) record.offset, std::ios::beg);
+        if (!blob.read(reinterpret_cast<char *>(scratch.data()), (std::streamsize) record.bytes) ||
+            sha256_bytes(scratch.data(), scratch.size()) != record.sha256) {
+            throw std::runtime_error("failed to load Neural Micro Stage tensor");
+        }
+        ggml_backend_tensor_set(record.tensor, scratch.data(), 0, scratch.size());
+    }
+    LLAMA_LOG_INFO(
+        "ColorLM Neural Micro Stage loaded: L%d rank %d, %.3f MiB on %s\n",
+        source_layer, rank, stage->weight_bytes() / 1024.0 / 1024.0,
+        stage->buffer_name());
+    return stage;
+}
+
+llama_neural_micro_stage::~llama_neural_micro_stage() {
+    if (buffer_) ggml_backend_buffer_free(buffer_);
+    if (ctx_) ggml_free(ctx_);
+}
+
+ggml_tensor * llama_neural_micro_stage::input() const { return tensors_.at("input.weight"); }
+ggml_tensor * llama_neural_micro_stage::output() const { return tensors_.at("output.weight"); }
+ggml_tensor * llama_neural_micro_stage::bias() const { return tensors_.at("output.bias"); }
+int llama_neural_micro_stage::source_layer() const { return source_layer_; }
+int llama_neural_micro_stage::hidden_size() const { return hidden_size_; }
+int llama_neural_micro_stage::rank() const { return rank_; }
+size_t llama_neural_micro_stage::weight_bytes() const {
+    return buffer_ ? ggml_backend_buffer_get_size(buffer_) : 0;
+}
+const char * llama_neural_micro_stage::buffer_name() const {
+    return buffer_ ? ggml_backend_buffer_name(buffer_) : "none";
+}
