+std::unique_ptr<llama_neural_bus_capsule> llama_neural_bus_capsule::load_q4_0_swiglu(
+        const std::filesystem::path & directory,
+        ggml_backend_buffer_type_t buft,
+        int64_t n_embd,
+        int64_t n_ff) {
+    if (!buft || n_embd <= 0 || n_ff <= 0 || n_embd % 32 != 0 || n_ff % 32 != 0) {
+        return nullptr;
+    }
+
+    q4_manifest_info manifest;
+    try {
+        manifest = validate_q4_manifest(directory, n_embd, n_ff);
+    } catch (const std::exception & error) {
+        LLAMA_LOG_ERROR("ColorLM Q4 capsule rejected: %s (%s)\n",
+            directory.string().c_str(), error.what());
+        return nullptr;
+    }
+
+    const std::filesystem::path router_path = directory / "router.f32";
+
+    auto capsule = std::unique_ptr<llama_neural_bus_capsule>(new llama_neural_bus_capsule());
+    ggml_init_params params = {
+        /*.mem_size   =*/ (manifest.has_router ? 4 : 3) * ggml_tensor_overhead() + 1024,
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    capsule->ctx_ = ggml_init(params);
+    if (!capsule->ctx_) {
+        return nullptr;
+    }
+
+    capsule->gate_ = ggml_new_tensor_2d(capsule->ctx_, GGML_TYPE_Q4_0, n_embd, n_ff);
+    capsule->up_   = ggml_new_tensor_2d(capsule->ctx_, GGML_TYPE_Q4_0, n_embd, n_ff);
+    capsule->down_ = ggml_new_tensor_2d(capsule->ctx_, GGML_TYPE_Q4_0, n_ff, n_embd);
+    ggml_set_name(capsule->gate_, "neural_bus.gate");
+    ggml_set_name(capsule->up_,   "neural_bus.up");
+    ggml_set_name(capsule->down_, "neural_bus.down");
+    if (manifest.has_router) {
+        capsule->router_ = ggml_new_tensor_2d(capsule->ctx_, GGML_TYPE_F32, n_embd, 1);
+        ggml_set_name(capsule->router_, "neural_bus.router");
+    }
+
+    capsule->buffer_ = ggml_backend_alloc_ctx_tensors_from_buft(capsule->ctx_, buft);
+    if (!capsule->buffer_) {
+        return nullptr;
+    }
+    ggml_backend_buffer_set_usage(capsule->buffer_, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    if (!load_tensor_file(directory / "gate.q4_0", capsule->gate_) ||
+        !load_tensor_file(directory / "up.q4_0", capsule->up_) ||
+        !load_tensor_file(directory / "down.q4_0", capsule->down_) ||
+        (capsule->router_ && !load_tensor_file(router_path, capsule->router_))) {
+        return nullptr;
+    }
+    return capsule;
+}
+
+llama_neural_bus_capsule::~llama_neural_bus_capsule() {
+    if (buffer_) {
+        ggml_backend_buffer_free(buffer_);
+    }
+    if (ctx_) {
+        ggml_free(ctx_);
+    }
+}
+
+ggml_tensor * llama_neural_bus_capsule::build_delta(ggml_context * ctx, ggml_tensor * input) const {
+    ggml_tensor * gate = ggml_mul_mat(ctx, gate_, input);
+    ggml_tensor * up = ggml_mul_mat(ctx, up_, input);
+    ggml_tensor * hidden = ggml_swiglu_split(ctx, gate, up);
+    return ggml_mul_mat(ctx, down_, hidden);
+}
+
+ggml_tensor * llama_neural_bus_capsule::build_router_score(
+        ggml_context * ctx, ggml_tensor * input) const {
+    return router_ ? ggml_mul_mat(ctx, router_, input) : nullptr;
+}
+
+bool llama_neural_bus_capsule::has_router() const {
+    return router_ != nullptr;
+}
+
+size_t llama_neural_bus_capsule::weight_bytes() const {
+    return ggml_nbytes(gate_) + ggml_nbytes(up_) + ggml_nbytes(down_) +
+        (router_ ? ggml_nbytes(router_) : 0);
+}
+
+const char * llama_neural_bus_capsule::buffer_name() const {
+    return buffer_ ? ggml_backend_buffer_name(buffer_) : "none";
+}
