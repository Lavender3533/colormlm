+static q35_neural_bus_config q35_read_neural_bus_config(const llama_model & model) {
+    q35_neural_bus_config config;
+    if (model.arch != LLM_ARCH_COLORLMV4) {
+        return config;
+    }
+
+    const char * raw_alpha = std::getenv("COLORLM_NEURAL_BUS_ALPHA");
+    config.alpha = std::clamp(raw_alpha ? (float) std::atof(raw_alpha) : 0.0f, 0.0f, 1.0f);
+    if (config.alpha <= 0.0f) {
+        return config;
+    }
+
+    const char * raw_target = std::getenv("COLORLM_NEURAL_BUS_TARGET_RATIO");
+    const char * raw_sharpness = std::getenv("COLORLM_NEURAL_BUS_SHARPNESS");
+    const char * raw_router_bias = std::getenv("COLORLM_NEURAL_BUS_ROUTER_BIAS");
+    const char * raw_router_floor = std::getenv("COLORLM_NEURAL_BUS_ROUTER_FLOOR");
+    config.target_ratio = std::clamp(raw_target ? (float) std::atof(raw_target) : 0.08f, 0.001f, 1.0f);
+    config.sharpness = std::clamp(raw_sharpness ? (float) std::atof(raw_sharpness) : 4.0f, 0.25f, 16.0f);
+    config.router_bias = std::clamp(
+        raw_router_bias ? (float) std::atof(raw_router_bias) : 0.0f, -10.0f, 10.0f);
+    config.router_floor = std::clamp(
+        raw_router_floor ? (float) std::atof(raw_router_floor) : -10.0f, -10.0f, 10.0f);
+
+    const char * raw_sites = std::getenv("COLORLM_NEURAL_BUS_SITES");
+    std::stringstream stream(raw_sites ? raw_sites : "12,28");
+    std::string item;
+    while (std::getline(stream, item, ',')) {
+        if (item.empty()) {
+            continue;
+        }
+        const int site = std::stoi(item);
+        if (site < 0 || site >= (int) model.hparams.n_layer) {
+            throw std::runtime_error("ColorLM Neural Bus site is outside the model");
+        }
+        config.sites.push_back(site);
+    }
+    std::sort(config.sites.begin(), config.sites.end());
+    config.sites.erase(std::unique(config.sites.begin(), config.sites.end()), config.sites.end());
+    if (config.sites.empty()) {
+        throw std::runtime_error("ColorLM Neural Bus requires at least one site");
+    }
+    return config;
+}
+
+static q35_neural_bus_runtime q35_try_init_neural_bus(
+        const llama_model & model,
+        const q35_neural_bus_config & config) {
+    if (config.alpha <= 0.0f) {
+        return {};
+    }
+    const char * raw_directory = std::getenv("COLORLM_NEURAL_BUS_CAPSULE");
+    if (!raw_directory || raw_directory[0] == '\0') {
+        throw std::runtime_error("COLORLM_NEURAL_BUS_CAPSULE is required when Neural Bus is enabled");
+    }
+
+    std::lock_guard<std::mutex> lock(g_q35_neural_bus_mutex);
+    if (g_q35_neural_bus_model != &model) {
+        g_q35_neural_bus.reset();
+        g_q35_neural_bus_secondary.reset();
+        g_q35_neural_bus_model = &model;
+        g_q35_neural_bus_trace_count.store(0);
+        g_q35_neural_bus_route_trace_count.store(0);
+    }
+
+    ggml_backend_buffer_type_t buft = q35_pick_gpu_buft(model);
+    if (!buft) {
+        buft = model.select_buft(config.sites.front());
+    }
+    bool initialized = false;
+    if (!g_q35_neural_bus) {
+        g_q35_neural_bus = llama_neural_bus_capsule::load_q4_0_swiglu(
+            std::filesystem::path(raw_directory), buft, model.hparams.n_embd, model.hparams.n_ff_exp);
+        if (!g_q35_neural_bus) {
+            throw std::runtime_error("ColorLM Neural Bus capsule failed validation or allocation");
+        }
+        initialized = true;
+    }
+
+    const char * raw_secondary = std::getenv("COLORLM_NEURAL_BUS_CAPSULE_2");
+    if (raw_secondary && raw_secondary[0] != '\0' && !g_q35_neural_bus_secondary) {
+        g_q35_neural_bus_secondary = llama_neural_bus_capsule::load_q4_0_swiglu(
+            std::filesystem::path(raw_secondary), buft, model.hparams.n_embd, model.hparams.n_ff_exp);
+        if (!g_q35_neural_bus_secondary) {
+            throw std::runtime_error("ColorLM Neural Bus secondary capsule failed validation or allocation");
+        }
+        initialized = true;
+    }
+    if (g_q35_neural_bus_secondary &&
+        (!g_q35_neural_bus->has_router() || !g_q35_neural_bus_secondary->has_router())) {
+        throw std::runtime_error("ColorLM Neural Bus v2 requires router.f32 in both capsules");
+    }
+
+    if (initialized) {
+        const double total_mib =
+            (g_q35_neural_bus->weight_bytes() +
+             (g_q35_neural_bus_secondary ? g_q35_neural_bus_secondary->weight_bytes() : 0)) /
+            (1024.0 * 1024.0);
+        LLAMA_LOG_INFO(
+            "ColorLM Neural Bus %s: %.2f MiB on %s, alpha=%.4f, sites=%zu, router_bias=%.6f, router_floor=%.6f\n",
+            g_q35_neural_bus_secondary ? "v2" : "v1", total_mib,
+            g_q35_neural_bus->buffer_name(), config.alpha, config.sites.size(),
+            config.router_bias, config.router_floor);
+    }
+    return {g_q35_neural_bus.get(), g_q35_neural_bus_secondary.get()};
+}
+
+static q35_k3_macro_config q35_read_k3_macro_config(const llama_model & model) {
+    q35_k3_macro_config config;
+    if (model.arch != LLM_ARCH_COLORLMV4) {
+        return config;
+    }
+
+    const char * raw_override_alpha = std::getenv("COLORLM_NEURAL_BUS_K3_ALPHA");
+    const bool has_alpha_override = raw_override_alpha && raw_override_alpha[0] != '\0';
+    const float alpha_override = has_alpha_override
+        ? std::clamp((float) std::atof(raw_override_alpha), 0.0f, 1.0f)
+        : -1.0f;
+    if (has_alpha_override && alpha_override <= 0.0f) {
+        return config;
+    }
+
+    const char * raw_plan = std::getenv("COLORLM_NEURAL_BUS_K3_PLAN");
+    if (raw_plan && raw_plan[0] != '\0') {
+        std::filesystem::path plan_path(raw_plan);
+        if (plan_path.is_relative()) {
+            plan_path = std::filesystem::absolute(plan_path);
+        }
+        std::ifstream plan_stream(plan_path);
+        if (!plan_stream) {
+            throw std::runtime_error("ColorLM K3 site plan cannot be opened");
+        }
+        const nlohmann::json plan = nlohmann::json::parse(plan_stream);
+        const std::string plan_format = plan.at("format").get<std::string>();
+        const bool multi_capsule = plan_format == "colorlm-k3-site-plan-v2";
+        if (!multi_capsule && plan_format != "colorlm-k3-site-plan-v1") {
+            throw std::runtime_error("unsupported ColorLM K3 site plan");
+        }
+        const auto & sites = plan.at("sites");
+        if (!sites.is_array() || sites.empty()) {
+            throw std::runtime_error("ColorLM K3 site plan has no sites");
+        }
+        for (const auto & record : sites) {
+            q35_k3_macro_config::site_config site;
+            site.site = record.at("site").get<int>();
+            site.alpha = has_alpha_override
+                ? alpha_override
+                : record.at("alpha").get<float>();
+            site.target_ratio = record.value("target_ratio", 0.04f);
+            site.sharpness = record.value("sharpness", 4.0f);
+            site.min_gate = record.value("min_gate", 0.02f);
+            site.temperature = record.value("temperature", plan.value("temperature", 0.20f));
+            site.no_op_bias = record.value("no_op_bias", plan.value("no_op_bias", -0.05f));
+            const auto add_candidate = [&](const nlohmann::json & source) {
+                q35_k3_macro_config::candidate_config candidate;
+                candidate.transport_gain = source.value("transport_gain", 1.0f);
+                candidate.manifest_sha256 = source.at("manifest_sha256").get<std::string>();
+                candidate.capsule = source.at("capsule").get<std::string>();
+                if (candidate.capsule.is_relative()) {
+                    candidate.capsule = plan_path.parent_path() / candidate.capsule;
+                }
+                candidate.capsule = std::filesystem::weakly_canonical(candidate.capsule);
+                if (candidate.transport_gain < 0.001f || candidate.transport_gain > 16.0f) {
+                    throw std::runtime_error("invalid ColorLM K3 candidate transport gain");
+                }
+                site.candidates.push_back(std::move(candidate));
+            };
+            if (multi_capsule) {
+                const auto & candidates = record.at("candidates");
+                if (!candidates.is_array() || candidates.size() < 2 || candidates.size() > 8) {
+                    throw std::runtime_error("ColorLM K3 v2 site requires 2..8 candidates");
+                }
+                for (const auto & candidate : candidates) {
+                    add_candidate(candidate);
+                }
+            } else {
+                add_candidate(record);
+            }
+            if (site.site < 0 || site.site >= (int) model.hparams.n_layer ||
+                site.alpha <= 0.0f || site.alpha > 1.0f ||
+                site.target_ratio < 0.001f || site.target_ratio > 1.0f ||
+                site.sharpness < 0.25f || site.sharpness > 16.0f ||
+                site.min_gate < 0.0f || site.min_gate >= 1.0f ||
+                site.temperature < 0.01f || site.temperature > 4.0f ||
+                site.no_op_bias < -4.0f || site.no_op_bias > 4.0f ||
+                site.candidates.empty()) {
+                throw std::runtime_error("invalid ColorLM K3 site configuration");
+            }
+            if (std::find_if(config.sites.begin(), config.sites.end(), [&](const auto & existing) {
+                    return existing.site == site.site;
+                }) != config.sites.end()) {
+                throw std::runtime_error("duplicate ColorLM K3 site");
+            }
+            config.sites.push_back(std::move(site));
+        }
+        std::sort(config.sites.begin(), config.sites.end(), [](const auto & a, const auto & b) {
+            return a.site < b.site;
+        });
+        return config;
+    }
+
+    const float legacy_alpha = has_alpha_override ? alpha_override : 0.0f;
+    if (legacy_alpha <= 0.0f) {
+        return config;
+    }
+
+    const char * raw_sites = std::getenv("COLORLM_NEURAL_BUS_K3_SITES");
+    std::stringstream stream(raw_sites ? raw_sites : "12,28,39");
+    std::string item;
+    std::vector<int> legacy_sites;
+    while (std::getline(stream, item, ',')) {
+        if (item.empty()) {
+            continue;
+        }
+        const int site = std::stoi(item);
+        if (site < 0 || site >= (int) model.hparams.n_layer) {
+            throw std::runtime_error("ColorLM K3 macro site is outside the model");
+        }
+        legacy_sites.push_back(site);
+    }
+    std::sort(legacy_sites.begin(), legacy_sites.end());
+    legacy_sites.erase(std::unique(legacy_sites.begin(), legacy_sites.end()), legacy_sites.end());
+    if (legacy_sites.empty()) {
+        throw std::runtime_error("ColorLM K3 macro requires at least one site");
+    }
+    const char * raw_directory = std::getenv("COLORLM_NEURAL_BUS_K3_CAPSULE");
+    if (!raw_directory || raw_directory[0] == '\0') {
+        throw std::runtime_error(
+            "COLORLM_NEURAL_BUS_K3_CAPSULE is required when legacy K3 mode is enabled");
+    }
+    for (int site : legacy_sites) {
+        q35_k3_macro_config::site_config entry;
+        entry.site = site;
+        entry.alpha = legacy_alpha;
+        q35_k3_macro_config::candidate_config candidate;
+        candidate.capsule = std::filesystem::absolute(raw_directory);
+        entry.candidates.push_back(std::move(candidate));
+        config.sites.push_back(std::move(entry));
+    }
+    return config;
+}
+
+static q35_neural_block_config q35_read_neural_block_config(const llama_model & model) {
+    q35_neural_block_config config;
+    if (model.arch != LLM_ARCH_COLORLMV4) {
+        return config;
+    }
+    const char * raw_alpha = std::getenv("COLORLM_NEURAL_BLOCK_ALPHA");
+    config.alpha = std::clamp(raw_alpha ? (float) std::atof(raw_alpha) : 0.0f, 0.0f, 1.0f);
+    if (config.alpha <= 0.0f) {
+        return config;
+    }
+    const char * raw_site = std::getenv("COLORLM_NEURAL_BLOCK_SITE");
+    config.site = raw_site ? std::atoi(raw_site) : (int) model.hparams.n_layer - 5;
+    if (config.site < 0 || config.site >= (int) model.hparams.n_layer) {
+        throw std::runtime_error("COLORLM_NEURAL_BLOCK_SITE is outside the model");
+    }
+    const char * raw_package = std::getenv("COLORLM_NEURAL_BLOCK_PACKAGE");
+    if (!raw_package || raw_package[0] == '\0') {
+        throw std::runtime_error("COLORLM_NEURAL_BLOCK_PACKAGE is required when Neural Block is enabled");
+    }
+    config.package = std::filesystem::path(raw_package);
+    const char * raw_ratio = std::getenv("COLORLM_NEURAL_BLOCK_TARGET_RATIO");
+    config.target_ratio = std::clamp(
+        raw_ratio ? (float) std::atof(raw_ratio) : 0.04f, 1e-4f, 1.0f);
+    const char * raw_sharpness = std::getenv("COLORLM_NEURAL_BLOCK_SHARPNESS");
+    config.sharpness = std::clamp(
+        raw_sharpness ? (float) std::atof(raw_sharpness) : 4.0f, 0.25f, 16.0f);
+    const char * raw_manifest = std::getenv("COLORLM_NEURAL_BLOCK_MANIFEST_SHA256");
+    if (raw_manifest) {
+        config.manifest_sha256 = raw_manifest;
+    }
+    const char * raw_verify = std::getenv("COLORLM_NEURAL_BLOCK_VERIFY_WEIGHTS");
+    config.verify_weights_sha256 = raw_verify && std::strcmp(raw_verify, "1") == 0;
+    return config;
+}
