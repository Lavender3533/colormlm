+// Runtime owner for the optional ColorLM v29 sparse sequence policy head.
+class llama_neural_policy_head {
+public:
+    static std::unique_ptr<llama_neural_policy_head> load_linear_f32(
+        const std::filesystem::path & directory,
+        ggml_backend_buffer_type_t buft,
+        const std::string & expected_manifest_sha256 = {},
+        bool verify_weights_sha256 = false);
+
+    ~llama_neural_policy_head();
+
+    llama_neural_policy_head(const llama_neural_policy_head &) = delete;
+    llama_neural_policy_head & operator=(const llama_neural_policy_head &) = delete;
+
+    ggml_tensor * weight() const;
+    ggml_tensor * bias() const;
+    ggml_tensor * base_ids() const;
+    ggml_tensor * base_ids_i32() const;
+    ggml_tensor * left() const;
+    ggml_tensor * right() const;
+    ggml_tensor * hidden_mean() const;
+    ggml_tensor * pca_components() const;
+    ggml_tensor * classifier() const;
+    ggml_tensor * classifier_bias() const;
+    ggml_tensor * correction_strength() const;
+
+    bool dynamic() const;
+    bool pca_multiclass() const;
+    int hidden_size() const;
+    int base_vocab_size() const;
+    int candidate_tokens() const;
+    int rank() const;
+    int class_count() const;
+    int candidate_capacity() const;
