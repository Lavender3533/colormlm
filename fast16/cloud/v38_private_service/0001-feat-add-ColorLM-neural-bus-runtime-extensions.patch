diff --git a/examples/per-layer-test/per-layer-test.cpp b/examples/per-layer-test/per-layer-test.cpp
new file mode 100644
index 0000000..0c871f8
--- /dev/null
+++ b/examples/per-layer-test/per-layer-test.cpp
@@ -0,0 +1,265 @@
+// Per-layer graph build/compute PoC for new SSD-MoE engine
+//
+// Goals (from northstar_engine_design.md hypothesis 2):
+//  1. How fast can we build_graph + compute a SINGLE matmul layer? (per-layer overhead)
+//  2. Does async tensor_set actually overlap with compute on Vulkan? (PCIe overlap)
+//
+// Test methodology:
+//  - Allocate hidden state (1, 4096) and weight (4096, 4096) on Vulkan backend
+//  - Three benchmarks:
+//     A) baseline_serial:  build → upload → compute → sync   (no overlap)
+//     B) build_reuse:      build once, reuse cgraph N times  (lower overhead)
+//     C) async_overlap:    fire async upload of NEXT weight while CURRENT computes
+//
+// Output: per-iteration ms, throughput, GPU stall fraction.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include <random>
+
+using clk = std::chrono::high_resolution_clock;
+using ms = std::chrono::duration<double, std::milli>;
+
+static double now_ms(clk::time_point t0) {
+    return ms(clk::now() - t0).count();
+}
+
+// pick the first non-CPU backend (we want Vulkan)
+static ggml_backend_t pick_gpu_backend() {
+    for (size_t i = 0; i < ggml_backend_dev_count(); i++) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        auto type = ggml_backend_dev_type(dev);
+        if (type == GGML_BACKEND_DEVICE_TYPE_GPU) {
+            printf("Using GPU backend: %s\n", ggml_backend_dev_name(dev));
+            return ggml_backend_dev_init(dev, NULL);
+        }
+    }
+    printf("No GPU backend found, falling back to CPU\n");
+    return ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, NULL);
+}
+
+struct Layer {
+    ggml_tensor * w = nullptr; // [in, out] weight, allocated on backend
+    std::vector<float> w_host; // host-side data for upload
+};
+
+// Build a single matmul cgraph: out = x @ w
+// Inputs are pre-allocated tensors on backend.
+static ggml_cgraph * build_matmul_graph(ggml_context * ctx, ggml_tensor * x, ggml_tensor * w) {
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_tensor * out = ggml_mul_mat(ctx, w, x);
+    ggml_set_name(out, "out");
+    ggml_build_forward_expand(gf, out);
+    return gf;
+}
+
+int main(int argc, char ** argv) {
+    int dim = 4096;       // typical hidden size
+    int n_iters = 200;    // benchmark iterations
+    int n_layers = 4;     // number of distinct weight tensors to rotate through
+
+    if (argc > 1) dim = std::atoi(argv[1]);
+    if (argc > 2) n_iters = std::atoi(argv[2]);
+    if (argc > 3) n_layers = std::atoi(argv[3]);
+
+    printf("=== Per-Layer Graph PoC ===\n");
+    printf("dim=%d  n_iters=%d  n_layers=%d\n", dim, n_iters, n_layers);
+    printf("Weight tensor: %.1f MB each (fp32), total %.1f MB\n",
+           dim * dim * 4.0 / (1024 * 1024),
+           dim * dim * 4.0 * n_layers / (1024 * 1024));
+
+    ggml_backend_t backend = pick_gpu_backend();
+    if (!backend) { printf("Failed to init backend\n"); return 1; }
+
+    // ── Allocate input + weights on backend ──────────────
+    size_t mem_size = ggml_tensor_overhead() * (n_layers + 4) + ggml_graph_overhead();
+    ggml_init_params params = { mem_size, NULL, /*no_alloc=*/ true };
+    ggml_context_ptr ctx_ptr(ggml_init(params));
+    ggml_context * ctx = ctx_ptr.get();
+
+    ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, dim, 1);
+    ggml_set_name(x, "x");
+
+    std::vector<Layer> layers(n_layers);
+    for (int l = 0; l < n_layers; l++) {
+        layers[l].w = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, dim, dim);
+        char nm[32]; snprintf(nm, sizeof(nm), "w%d", l);
+        ggml_set_name(layers[l].w, nm);
+    }
+
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    if (!buf) { printf("Failed to alloc backend buffer\n"); return 1; }
+    printf("Backend buffer: %.1f MB\n", ggml_backend_buffer_get_size(buf) / 1024.0 / 1024.0);
+
+    // Init host data: random for weights, 1.0 for x
+    std::mt19937 rng(42);
+    std::uniform_real_distribution<float> dist(-0.1f, 0.1f);
+    std::vector<float> x_host(dim, 1.0f);
+    for (auto & L : layers) {
+        L.w_host.resize((size_t)dim * dim);
+        for (auto & v : L.w_host) v = dist(rng);
+    }
+
+    // Upload x once
+    ggml_backend_tensor_set(x, x_host.data(), 0, x_host.size() * sizeof(float));
+    // Upload all weights once (will be reused / overwritten in tests)
+    for (int l = 0; l < n_layers; l++) {
+        ggml_backend_tensor_set(layers[l].w, layers[l].w_host.data(), 0,
+                                layers[l].w_host.size() * sizeof(float));
+    }
+    ggml_backend_synchronize(backend);
+
+    size_t bytes_per_w = (size_t)dim * dim * sizeof(float);
+
+    // ── Test A: baseline_serial ─────────────────────────
+    // For each iter: build graph (rotating layer), compute, sync. No overlap, no reuse.
+    {
+        printf("\n[Test A] serial: build+compute+sync per iter, rotating layers\n");
+        auto t0 = clk::now();
+        for (int i = 0; i < n_iters; i++) {
+            int l = i % n_layers;
+            // each iter gets its own ctx for graph (mimics "build fresh per layer")
+            size_t graph_mem = ggml_tensor_overhead() * 8 + ggml_graph_overhead();
+            ggml_init_params gp = { graph_mem, NULL, true };
+            ggml_context_ptr gctx(ggml_init(gp));
+            ggml_cgraph * gf = build_matmul_graph(gctx.get(), x, layers[l].w);
+            ggml_backend_graph_compute(backend, gf);
+        }
+        double total = now_ms(t0);
+        printf("  total %.2f ms  | per-iter %.3f ms  | %.0f ops/sec\n",
+               total, total / n_iters, n_iters * 1000.0 / total);
+    }
+
+    // ── Test B: build_reuse ─────────────────────────────
+    // Build cgraph ONCE then call compute N times. Pure GPU compute cost.
+    {
+        printf("\n[Test B] reuse: build once, compute N times (no rotation)\n");
+        size_t graph_mem = ggml_tensor_overhead() * 8 + ggml_graph_overhead();
+        ggml_init_params gp = { graph_mem, NULL, true };
+        ggml_context_ptr gctx(ggml_init(gp));
+        ggml_cgraph * gf = build_matmul_graph(gctx.get(), x, layers[0].w);
+
+        auto t0 = clk::now();
+        for (int i = 0; i < n_iters; i++) {
+            ggml_backend_graph_compute(backend, gf);
+        }
+        ggml_backend_synchronize(backend);
+        double total = now_ms(t0);
+        printf("  total %.2f ms  | per-iter %.3f ms  | %.0f ops/sec\n",
+               total, total / n_iters, n_iters * 1000.0 / total);
+    }
+
+    // ── Test C: async_overlap ───────────────────────────
+    // For each iter: start async upload of NEXT layer, compute current, sync.
+    // If transfer overlaps compute, total time should approach max(compute, transfer)
+    // rather than compute + transfer.
+    {
+        printf("\n[Test C] async_overlap: upload next-W async while computing current\n");
+
+        // Pre-build graphs for all layers (so we focus on overlap, not build cost)
+        std::vector<ggml_context_ptr> gctxs;
+        std::vector<ggml_cgraph *> graphs;
+        for (int l = 0; l < n_layers; l++) {
+            size_t graph_mem = ggml_tensor_overhead() * 8 + ggml_graph_overhead();
+            ggml_init_params gp = { graph_mem, NULL, true };
+            gctxs.emplace_back(ggml_init(gp));
+            graphs.push_back(build_matmul_graph(gctxs.back().get(), x, layers[l].w));
+        }
+
+        auto t0 = clk::now();
+        for (int i = 0; i < n_iters; i++) {
+            int cur = i % n_layers;
+            int nxt = (i + 1) % n_layers;
+            // Fire async upload of next layer's weight (overwriting itself)
+            ggml_backend_tensor_set_async(backend, layers[nxt].w,
+                                          layers[nxt].w_host.data(), 0, bytes_per_w);
+            // Compute current (also async dispatch)
+            ggml_backend_graph_compute(backend, graphs[cur]);
+        }
+        ggml_backend_synchronize(backend);
