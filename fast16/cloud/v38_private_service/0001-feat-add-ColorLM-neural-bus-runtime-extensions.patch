+    q35_force_path path = q35_force_path::automatic;
+};
+
+static q35_force_path q35_parse_force_path(
+        const std::string & value,
+        bool allow_automatic,
+        const char * source) {
+    if (allow_automatic && value == "auto") {
+        return q35_force_path::automatic;
+    }
+    if (value == "no_op") {
+        return q35_force_path::no_op;
+    }
+    if (value == "coder") {
+        return q35_force_path::coder;
+    }
+    if (value == "k3") {
+        return q35_force_path::k3;
+    }
+    throw std::runtime_error(std::string("invalid ") + source + " path: " + value);
+}
+
+static q35_force_path q35_read_force_path() {
+    const char * raw = std::getenv("COLORLM_NEURAL_BUS_FORCE_PATH");
+    if (!raw || raw[0] == '\0') {
+        return q35_force_path::automatic;
+    }
+    return q35_parse_force_path(raw, true, "COLORLM_NEURAL_BUS_FORCE_PATH");
+}
+
+static std::vector<q35_site_force_path> q35_read_site_force_paths(
+        const llama_model & model) {
+    std::vector<q35_site_force_path> result;
+    const char * raw = std::getenv("COLORLM_NEURAL_BUS_FORCE_PATH_BY_SITE");
+    if (!raw || raw[0] == '\0') {
+        return result;
+    }
+
+    const std::string encoded(raw);
+    if (encoded.front() == ',' || encoded.back() == ',') {
+        throw std::runtime_error(
+            "invalid COLORLM_NEURAL_BUS_FORCE_PATH_BY_SITE list boundary");
+    }
+    std::stringstream stream(encoded);
+    std::string item;
+    while (std::getline(stream, item, ',')) {
+        const size_t separator = item.find('=');
+        if (item.empty() || separator == std::string::npos || separator == 0 ||
+            separator + 1 >= item.size() || item.find('=', separator + 1) != std::string::npos) {
+            throw std::runtime_error(
+                "invalid COLORLM_NEURAL_BUS_FORCE_PATH_BY_SITE item: " + item);
+        }
+        const std::string layer_text = item.substr(0, separator);
+        if (!std::all_of(layer_text.begin(), layer_text.end(), [](char value) {
+                return value >= '0' && value <= '9';
+            })) {
+            throw std::runtime_error(
+                "invalid COLORLM_NEURAL_BUS_FORCE_PATH_BY_SITE layer: " + layer_text);
+        }
+
+        int site = -1;
+        try {
+            size_t consumed = 0;
+            site = std::stoi(layer_text, &consumed);
+            if (consumed != layer_text.size()) {
+                throw std::runtime_error("trailing layer text");
+            }
+        } catch (const std::exception &) {
+            throw std::runtime_error(
+                "invalid COLORLM_NEURAL_BUS_FORCE_PATH_BY_SITE layer: " + layer_text);
+        }
+        if (site < 0 || site >= (int) model.hparams.n_layer) {
+            throw std::runtime_error(
+                "COLORLM_NEURAL_BUS_FORCE_PATH_BY_SITE layer is outside the model");
+        }
+        if (std::find_if(result.begin(), result.end(), [&](const auto & existing) {
+                return existing.site == site;
+            }) != result.end()) {
+            throw std::runtime_error(
+                "duplicate COLORLM_NEURAL_BUS_FORCE_PATH_BY_SITE layer");
+        }
+        result.push_back({
+            site,
+            q35_parse_force_path(
+                item.substr(separator + 1), false,
+                "COLORLM_NEURAL_BUS_FORCE_PATH_BY_SITE"),
+        });
+    }
+    return result;
+}
+
+static q35_force_path q35_force_path_at(
+        q35_force_path fallback,
+        const std::vector<q35_site_force_path> & site_paths,
+        int il) {
+    const auto found = std::find_if(
+        site_paths.begin(), site_paths.end(),
+        [&](const auto & entry) { return entry.site == il; });
+    return found != site_paths.end() ? found->path : fallback;
+}
+
+static ggml_backend_buffer_type_t q35_pick_gpu_buft(const llama_model & model) {
+    if (model.output && model.output->buffer && !ggml_backend_buffer_is_host(model.output->buffer)) {
+        return ggml_backend_buffer_get_type(model.output->buffer);
+    }
+    for (int i = 0; i < (int) ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            return ggml_backend_dev_buffer_type(dev);
+        }
+    }
+    return nullptr;
+}
+
+static ggml_backend_buffer_type_t q35_pick_gpu_host_buft() {
+    for (int i = 0; i < (int) ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        if (ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            continue;
+        }
+        ggml_backend_buffer_type_t buft = ggml_backend_dev_host_buffer_type(dev);
+        if (buft) {
+            return buft;
+        }
+    }
+    return ggml_backend_cpu_buffer_type();
+}
