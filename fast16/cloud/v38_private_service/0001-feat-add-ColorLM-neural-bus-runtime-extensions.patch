+
+private:
+    llama_neural_policy_head() = default;
+
+    ggml_context * ctx_ = nullptr;
+    ggml_backend_buffer_t buffer_ = nullptr;
+    std::unordered_map<std::string, ggml_tensor *> tensors_;
+    std::vector<int64_t> static_token_ids_;
+    bool dynamic_ = false;
+    bool pca_multiclass_ = false;
+    int hidden_size_ = 0;
+    int base_vocab_size_ = 0;
+    int candidate_tokens_ = 0;
+    int rank_ = 0;
+    int class_count_ = 0;
+    int candidate_capacity_ = 0;
+    float correction_min_ = 0.0f;
+    float correction_max_ = 0.0f;
+};
diff --git a/src/llama-slot-pool.cpp b/src/llama-slot-pool.cpp
new file mode 100644
index 0000000..3d2bf8d
--- /dev/null
+++ b/src/llama-slot-pool.cpp
@@ -0,0 +1,406 @@
+#include "llama-slot-pool.h"
+
+#include "ggml-alloc.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+#include <vector>
+
+std::unique_ptr<slot_pool> slot_pool::create(const config & cfg) {
+    if (cfg.n_layers == 0 || cfg.k_prime == 0 || cfg.n_embd <= 0 || cfg.n_ff_exp <= 0 || !cfg.buft) {
+        fprintf(stderr, "slot_pool: invalid config\n");
+        return nullptr;
+    }
+
+    auto pool = std::unique_ptr<slot_pool>(new slot_pool());
+    pool->cfg_ = cfg;
+
+    // ggml_context with no_alloc — tensors are bound to a backend buffer below.
+    const size_t n_tensors = 3ull * cfg.n_layers;
+    ggml_init_params ip = {
+        /*.mem_size  =*/ ggml_tensor_overhead() * n_tensors + 1024,
+        /*.mem_buffer=*/ nullptr,
+        /*.no_alloc  =*/ true,
+    };
+    pool->ctx_ = ggml_init(ip);
+    if (!pool->ctx_) {
+        fprintf(stderr, "slot_pool: ggml_init failed\n");
+        return nullptr;
+    }
+
+    pool->gate_ = (ggml_tensor **) std::calloc(cfg.n_layers, sizeof(ggml_tensor *));
+    pool->up_   = (ggml_tensor **) std::calloc(cfg.n_layers, sizeof(ggml_tensor *));
+    pool->down_ = (ggml_tensor **) std::calloc(cfg.n_layers, sizeof(ggml_tensor *));
+
+    for (uint32_t il = 0; il < cfg.n_layers; ++il) {
+        char name[64];
+
+        // gate / up: [n_embd, n_ff_exp, k_prime]
+        snprintf(name, sizeof(name), "slotpool.gate.%u", il);
+        pool->gate_[il] = ggml_new_tensor_3d(pool->ctx_, cfg.gate_type, cfg.n_embd, cfg.n_ff_exp, cfg.k_prime);
+        ggml_set_name(pool->gate_[il], name);
+
+        snprintf(name, sizeof(name), "slotpool.up.%u", il);
+        pool->up_[il] = ggml_new_tensor_3d(pool->ctx_, cfg.up_type, cfg.n_embd, cfg.n_ff_exp, cfg.k_prime);
+        ggml_set_name(pool->up_[il], name);
+
+        // down: [n_ff_exp, n_embd, k_prime] — Q4_K_M models use Q6_K here, not Q4_K!
+        snprintf(name, sizeof(name), "slotpool.down.%u", il);
+        pool->down_[il] = ggml_new_tensor_3d(pool->ctx_, cfg.down_type, cfg.n_ff_exp, cfg.n_embd, cfg.k_prime);
+        ggml_set_name(pool->down_[il], name);
+    }
+
+    // Allocate one big VRAM buffer for all tensors in this context.
+    pool->buf_ = ggml_backend_alloc_ctx_tensors_from_buft(pool->ctx_, cfg.buft);
+    if (!pool->buf_) {
+        fprintf(stderr, "slot_pool: ggml_backend_alloc_ctx_tensors_from_buft failed (buft=%s)\n",
+                ggml_backend_buft_name(cfg.buft));
+        return nullptr;
+    }
+
+    // Mark as weights so ggml_backend_sched anchors mul_mat_id on this backend
+    // (mirrors llama-model.cpp:1498 for model weight buffers). Without this,
+    // sched skips the pool tensor in its "src is weight → pin op to weight's
+    // backend" pass and ends up dispatching mul_mat_id incorrectly when the
+    // pool buffer is foreign to the model buffer set. Symptom = '?' garbage
+    // tokens despite byte-perfect data.
+    ggml_backend_buffer_set_usage(pool->buf_, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    return pool;
+}
+
+slot_pool::~slot_pool() {
+    if (lut_buf_) ggml_backend_buffer_free(lut_buf_);
+    if (lut_ctx_) ggml_free(lut_ctx_);
+    if (buf_) ggml_backend_buffer_free(buf_);
+    if (ctx_) ggml_free(ctx_);
+    std::free(gate_);
+    std::free(up_);
+    std::free(down_);
+    std::free(lut_t_);
+    std::free(lut_host_);
+}
+
+ggml_tensor * slot_pool::gate(uint32_t layer) const { return layer < cfg_.n_layers ? gate_[layer] : nullptr; }
+ggml_tensor * slot_pool::up  (uint32_t layer) const { return layer < cfg_.n_layers ? up_  [layer] : nullptr; }
+ggml_tensor * slot_pool::down(uint32_t layer) const { return layer < cfg_.n_layers ? down_[layer] : nullptr; }
+
+static size_t per_expert_bytes(int64_t a, int64_t b, ggml_type type) {
+    // Same row-major math ggml uses internally.
+    const size_t row_size = ggml_row_size(type, a);
+    return row_size * (size_t) b;
+}
+
+size_t slot_pool::gate_bytes_per_expert() const { return per_expert_bytes(cfg_.n_embd,   cfg_.n_ff_exp, cfg_.gate_type); }
+size_t slot_pool::up_bytes_per_expert  () const { return per_expert_bytes(cfg_.n_embd,   cfg_.n_ff_exp, cfg_.up_type); }
+size_t slot_pool::down_bytes_per_expert() const { return per_expert_bytes(cfg_.n_ff_exp, cfg_.n_embd,   cfg_.down_type); }
+
+size_t slot_pool::total_vram_bytes() const {
+    return buf_ ? ggml_backend_buffer_get_size(buf_) : 0;
+}
+
+const slot_pool::config & slot_pool::get_config() const { return cfg_; }
+
+void slot_pool::stage(uint32_t layer, uint32_t slot_idx,
+                      const void * gate_src, size_t gate_bytes,
+                      const void * up_src,   size_t up_bytes,
+                      const void * down_src, size_t down_bytes) {
+    if (layer >= cfg_.n_layers || slot_idx >= cfg_.k_prime) {
+        fprintf(stderr, "slot_pool::stage: out of range (layer=%u/%u slot=%u/%u)\n",
+                layer, cfg_.n_layers, slot_idx, cfg_.k_prime);
+        return;
+    }
+
+    const size_t gate_off = (size_t) slot_idx * gate_bytes_per_expert();
+    const size_t up_off   = (size_t) slot_idx * up_bytes_per_expert();
+    const size_t down_off = (size_t) slot_idx * down_bytes_per_expert();
+
+    if (gate_src && gate_bytes > 0) ggml_backend_tensor_set(gate_[layer], gate_src, gate_off, gate_bytes);
+    if (up_src   && up_bytes   > 0) ggml_backend_tensor_set(up_  [layer], up_src,   up_off,   up_bytes);
+    if (down_src && down_bytes > 0) ggml_backend_tensor_set(down_[layer], down_src, down_off, down_bytes);
+
+    static bool dumped = false;
+    if (!dumped && getenv("COLORLM_SLOT_POOL_VERIFY") && layer == 0 && slot_idx == 0) {
+        dumped = true;
+        uint8_t rb[16];
+        // gate
+        const uint8_t * gs = (const uint8_t *) gate_src;
+        fprintf(stderr, "[stage-dump] L0S0 gate: ne={%lld,%lld,%lld} nb={%zu,%zu,%zu} type=%s per_expert=%zu\n",
+                (long long) gate_[layer]->ne[0], (long long) gate_[layer]->ne[1], (long long) gate_[layer]->ne[2],
+                gate_[layer]->nb[0], gate_[layer]->nb[1], gate_[layer]->nb[2],
+                ggml_type_name(gate_[layer]->type), gate_bytes_per_expert());
+        fprintf(stderr, "[stage-dump] L0S0 gate src @0  : ");
+        for (int i = 0; i < 16; ++i) fprintf(stderr, "%02x ", gs[i]);
+        fprintf(stderr, "\n[stage-dump] L0S0 gate vram@0: ");
+        ggml_backend_tensor_get(gate_[layer], rb, gate_off, 16);
+        for (int i = 0; i < 16; ++i) fprintf(stderr, "%02x ", rb[i]);
+        // down
+        const uint8_t * ds = (const uint8_t *) down_src;
+        fprintf(stderr, "\n[stage-dump] L0S0 down: ne={%lld,%lld,%lld} nb={%zu,%zu,%zu} type=%s per_expert=%zu\n",
+                (long long) down_[layer]->ne[0], (long long) down_[layer]->ne[1], (long long) down_[layer]->ne[2],
+                down_[layer]->nb[0], down_[layer]->nb[1], down_[layer]->nb[2],
+                ggml_type_name(down_[layer]->type), down_bytes_per_expert());
+        fprintf(stderr, "[stage-dump] L0S0 down src @0  : ");
+        for (int i = 0; i < 16; ++i) fprintf(stderr, "%02x ", ds[i]);
+        fprintf(stderr, "\n[stage-dump] L0S0 down vram@0: ");
+        ggml_backend_tensor_get(down_[layer], rb, down_off, 16);
+        for (int i = 0; i < 16; ++i) fprintf(stderr, "%02x ", rb[i]);
+        // down end of expert (per_expert_bytes - 16)
+        const size_t end = down_bytes_per_expert() - 16;
+        fprintf(stderr, "\n[stage-dump] L0S0 down src @end: ");
+        for (int i = 0; i < 16; ++i) fprintf(stderr, "%02x ", ds[end + i]);
+        fprintf(stderr, "\n[stage-dump] L0S0 down vram@end: ");
+        ggml_backend_tensor_get(down_[layer], rb, down_off + end, 16);
+        for (int i = 0; i < 16; ++i) fprintf(stderr, "%02x ", rb[i]);
+        fprintf(stderr, "\n");
+    }
+
+    // DIAG-13: full-byte verify of staged data vs source.
+    // Default OFF. COLORLM_SLOT_POOL_VERIFY enables a 16-byte spot-check on
+    // the first stage; MOE_FULL_BYTE_VERIFY performs the expensive full scan.
+    // MOE_FULL_BYTE_VERIFY=1 enables full memcmp on every stage call —
+    // slow but thorough. Will print first mismatch location per tensor.
+    if (getenv("MOE_FULL_BYTE_VERIFY")) {
+        std::vector<uint8_t> back(std::max({gate_bytes, up_bytes, down_bytes}));
+        auto check = [&](const char * tag, ggml_tensor * t, size_t off, const void * src, size_t n) {
+            if (!src || n == 0) return;
+            ggml_backend_tensor_get(t, back.data(), off, n);
+            if (std::memcmp(back.data(), src, n) == 0) return;
+            const uint8_t * a = back.data();
+            const uint8_t * b = (const uint8_t *) src;
+            size_t first = 0; while (first < n && a[first] == b[first]) ++first;
+            size_t mismatch_count = 0;
+            for (size_t i = 0; i < n; ++i) if (a[i] != b[i]) ++mismatch_count;
+            fprintf(stderr,
+                "[DIAG-13] L%u S%u %s MISMATCH bytes=%zu/%zu first@%zu vram=%02x src=%02x\n",
+                layer, slot_idx, tag, mismatch_count, n, first, a[first], b[first]);
+        };
+        check("gate", gate_[layer], gate_off, gate_src, gate_bytes);
+        check("up",   up_  [layer], up_off,   up_src,   up_bytes);
+        check("down", down_[layer], down_off, down_src, down_bytes);
+    }
+}
+
+static thread_local slot_pool * tls_active = nullptr;
+
+void slot_pool::set_active(slot_pool * pool) { tls_active = pool; }
+slot_pool * slot_pool::get_active() { return tls_active; }
+
+uint32_t slot_pool::n_logical_experts() const { return n_logical_; }
+
+void slot_pool::set_n_logical_experts(uint32_t n) {
+    if (n_logical_ == n) return;
+    if (lut_buf_) { ggml_backend_buffer_free(lut_buf_); lut_buf_ = nullptr; }
+    if (lut_ctx_) { ggml_free(lut_ctx_); lut_ctx_ = nullptr; }
+    if (lut_t_)   { std::free(lut_t_);    lut_t_ = nullptr; }
+    if (lut_host_){ std::free(lut_host_); lut_host_ = nullptr; }
+
+    n_logical_ = n;
+    if (n == 0) return;
+
+    lut_host_ = (int32_t *) std::malloc(sizeof(int32_t) * (size_t) cfg_.n_layers * n);
+    for (size_t i = 0; i < (size_t) cfg_.n_layers * n; ++i) lut_host_[i] = SENTINEL_SLOT;
+
+    // Allocate GPU LUT tensors in a dedicated ctx + buffer (so it can be sized after slot ctx is sealed)
+    ggml_init_params ip = {
+        /*.mem_size  =*/ ggml_tensor_overhead() * cfg_.n_layers + 1024,
+        /*.mem_buffer=*/ nullptr,
+        /*.no_alloc  =*/ true,
+    };
+    lut_ctx_ = ggml_init(ip);
+    lut_t_   = (ggml_tensor **) std::calloc(cfg_.n_layers, sizeof(ggml_tensor *));
+    for (uint32_t il = 0; il < cfg_.n_layers; ++il) {
+        // Shape [1, n_logical] so ggml_get_rows produces [1, K*T] (elementwise lookup)
+        lut_t_[il] = ggml_new_tensor_2d(lut_ctx_, GGML_TYPE_I32, 1, n);
+        char name[64];
+        snprintf(name, sizeof(name), "slotpool.lut.%u", il);
+        ggml_set_name(lut_t_[il], name);
+    }
+    lut_buf_ = ggml_backend_alloc_ctx_tensors_from_buft(lut_ctx_, cfg_.buft);
+    if (!lut_buf_) {
+        fprintf(stderr, "slot_pool::set_n_logical_experts: lut buffer alloc failed\n");
+    } else {
+        ggml_backend_buffer_set_usage(lut_buf_, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    }
+}
+
+int32_t * slot_pool::lut_host(uint32_t layer) {
+    if (!lut_host_ || layer >= cfg_.n_layers) return nullptr;
+    return lut_host_ + (size_t) layer * n_logical_;
+}
+
+ggml_tensor * slot_pool::lut_gpu(uint32_t layer) const {
+    if (!lut_t_ || layer >= cfg_.n_layers) return nullptr;
+    return lut_t_[layer];
+}
+
+void slot_pool::lut_upload(uint32_t layer) {
+    if (!lut_t_ || !lut_host_ || layer >= cfg_.n_layers) return;
+    const int32_t * src = lut_host_ + (size_t) layer * n_logical_;
+    // Sanitize before GPU upload: replace SENTINEL_SLOT (-1) with 0.
+    // mul_mat_id workgroups only process expert indices present in src0->ne[2].
+    // A -1 (0xFFFFFFFF as uint32) matches NO workgroup, leaving that output
+    // position unwritten = uninitialized garbage. Fallback to slot 0 produces
+    // wrong-expert output but avoids garbage.
+    bool needs_sanitize = false;
+    for (uint32_t i = 0; i < n_logical_; ++i) {
+        if (src[i] < 0) { needs_sanitize = true; break; }
+    }
+    if (!needs_sanitize) {
+        ggml_backend_tensor_set(lut_t_[layer], src, 0,
+                                (size_t) n_logical_ * sizeof(int32_t));
+    } else {
+        std::vector<int32_t> sanitized(src, src + n_logical_);
+        for (auto & v : sanitized) { if (v < 0) v = 0; }
+        ggml_backend_tensor_set(lut_t_[layer], sanitized.data(), 0,
+                                (size_t) n_logical_ * sizeof(int32_t));
+    }
+}
+
+void slot_pool::lut_upload_all() {
+    for (uint32_t il = 0; il < cfg_.n_layers; ++il) lut_upload(il);
+}
+
+bool slot_pool::prestage_first_k(uint32_t layer,
+                                 const void * gate_packed_data,
+                                 const void * up_packed_data,
+                                 const void * down_packed_data) {
+    if (layer >= cfg_.n_layers) return false;
+    if (n_logical_ == 0) {
+        fprintf(stderr, "slot_pool::prestage_first_k: set_n_logical_experts not called\n");
+        return false;
+    }
+    const size_t g_b = gate_bytes_per_expert();
+    const size_t u_b = up_bytes_per_expert();
+    const size_t d_b = down_bytes_per_expert();
+
+    int32_t * lut = lut_host(layer);
+    // reset to sentinel for this layer
+    for (uint32_t i = 0; i < n_logical_; ++i) lut[i] = SENTINEL_SLOT;
+
+    const uint32_t kmax = cfg_.k_prime < n_logical_ ? cfg_.k_prime : n_logical_;
+    for (uint32_t s = 0; s < kmax; ++s) {
+        const uint8_t * gp = (const uint8_t *) gate_packed_data + (size_t) s * g_b;
+        const uint8_t * up = (const uint8_t *) up_packed_data   + (size_t) s * u_b;
+        const uint8_t * dp = (const uint8_t *) down_packed_data + (size_t) s * d_b;
+        stage(layer, s, gp, g_b, up, u_b, dp, d_b);
+        lut[s] = (int32_t) s;
+    }
+    return true;
+}
+
+// ─── Dynamic observation + restage (project-local; task #11) ────────────────
+
+void slot_pool::add_observation(uint32_t layer, const int32_t * expert_ids, int n) {
+    if (layer >= cfg_.n_layers || n_logical_ == 0) return;
+    if (obs_counts_.empty()) {
+        obs_counts_.assign((size_t) cfg_.n_layers * n_logical_, 0);
+    }
+    const size_t row_off = (size_t) layer * n_logical_;
+    for (int i = 0; i < n; ++i) {
+        const int32_t e = expert_ids[i];
+        if (e >= 0 && (uint32_t) e < n_logical_) {
+            obs_counts_[row_off + (size_t) e]++;
+        }
+    }
+    obs_total_++;
+    // Initialize threshold lazily — default = n_layers * 16 token-layer obs.
+    // Override via env MOE_DYNAMIC_THRESHOLD if set (for testing).
+    if (observation_threshold == 0) {
+        const char * env = getenv("MOE_DYNAMIC_THRESHOLD");
+        observation_threshold = env ? (uint64_t) atoll(env) : (uint64_t) cfg_.n_layers * 16;
+    }
+}
+
+bool slot_pool::has_pending_restage() const {
+    if (obs_total_ < observation_threshold) return false;
+    return obs_total_ > obs_total_at_last_restage_;
+}
+
+uint64_t slot_pool::total_observations() const {
+    return obs_total_;
+}
+
+void slot_pool::clear_observations() {
+    obs_counts_.assign((size_t) cfg_.n_layers * n_logical_, 0);
+    obs_total_ = 0;
+    obs_total_at_last_restage_ = 0;
+}
+
+bool slot_pool::restage_from_observations(const std::vector<layer_data> & layers,
+                                          uint32_t n_logical_experts) {
+    if (n_logical_ == 0 || obs_counts_.empty()) return false;
+    if (n_logical_experts != n_logical_) {
+        fprintf(stderr, "[slot_pool::restage] n_logical mismatch %u vs %u\n",
+                n_logical_experts, n_logical_);
+        return false;
+    }
+    if (layers.size() != cfg_.n_layers) {
+        fprintf(stderr, "[slot_pool::restage] layer count mismatch %zu vs %u\n",
+                layers.size(), cfg_.n_layers);
+        return false;
+    }
+
+    const size_t g_b = gate_bytes_per_expert();
+    const size_t u_b = up_bytes_per_expert();
+    const size_t d_b = down_bytes_per_expert();
+
+    uint32_t total_changed = 0;
+    for (uint32_t il = 0; il < cfg_.n_layers; ++il) {
+        const uint32_t * counts = obs_counts_.data() + (size_t) il * n_logical_;
+        // Pick top K' by count (descending), break ties by expert id (ascending)
+        std::vector<std::pair<uint32_t, uint32_t>> ranked;  // (count, expert_id)
+        ranked.reserve(n_logical_);
+        for (uint32_t e = 0; e < n_logical_; ++e) {
+            ranked.emplace_back(counts[e], e);
+        }
+        std::sort(ranked.begin(), ranked.end(),
+                  [](const std::pair<uint32_t,uint32_t> & a, const std::pair<uint32_t,uint32_t> & b){
+                      if (a.first != b.first) return a.first > b.first;
+                      return a.second < b.second;
+                  });
+
+        // Build new desired slot assignment: top K' experts → slots 0..K'-1
+        std::vector<uint32_t> new_in_pool(cfg_.k_prime);
+        for (uint32_t s = 0; s < cfg_.k_prime; ++s) {
+            new_in_pool[s] = ranked[s].second;
+        }
+
+        // Diff: which slots need replacing? The current LUT tells us what's in slot s.
+        // Build inverse: slot_to_expert[s] = expert currently in slot s
+        int32_t * lut = lut_host(il);
+        std::vector<int32_t> slot_to_expert(cfg_.k_prime, -1);
+        for (uint32_t e = 0; e < n_logical_; ++e) {
+            int32_t s = lut[e];
+            if (s >= 0 && (uint32_t) s < cfg_.k_prime) {
+                slot_to_expert[s] = (int32_t) e;
+            }
+        }
+
+        // Re-stage: for each slot, if desired expert != current expert, copy in
+        // Reset LUT first: all logicals → fall back to slot 0
+        for (uint32_t e = 0; e < n_logical_; ++e) lut[e] = 0;
+
+        for (uint32_t s = 0; s < cfg_.k_prime; ++s) {
+            const uint32_t want = new_in_pool[s];
+            const int32_t  has  = slot_to_expert[s];
+            if ((int32_t) want != has) {
+                const uint8_t * gp = (const uint8_t *) layers[il].gate + (size_t) want * g_b;
+                const uint8_t * up = (const uint8_t *) layers[il].up   + (size_t) want * u_b;
+                const uint8_t * dp = (const uint8_t *) layers[il].down + (size_t) want * d_b;
+                stage(il, s, gp, g_b, up, u_b, dp, d_b);
+                total_changed++;
+            }
+            lut[want] = (int32_t) s;  // logical → slot
+        }
+    }
+    lut_upload_all();
+
+    obs_total_at_last_restage_ = obs_total_;
+    fprintf(stderr, "[slot_pool::restage] %u expert slots replaced (%llu obs)\n",
+            total_changed, (unsigned long long) obs_total_);
+    return true;
+}
