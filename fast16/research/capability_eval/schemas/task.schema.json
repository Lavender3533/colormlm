{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.colormlm/capability-eval/task.schema.json",
  "title": "ColorLM capability short-gate task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "dimension",
    "split",
    "family",
    "input",
    "reference_answer",
    "validator",
    "critical_decision_tokens",
    "failure_conditions"
  ],
  "properties": {
    "schema_version": {"const": "capability-task-v1"},
    "id": {"type": "string", "pattern": "^(dev|task_holdout|final_holdout)_[a-z_]+_[0-9]{2}$"},
    "dimension": {
      "enum": [
        "reasoning",
        "knowledge",
        "long_context",
        "coding",
        "tools",
        "planning",
        "computer_use",
        "communication"
      ]
    },
    "split": {"enum": ["dev", "task_holdout", "final_holdout"]},
    "family": {"type": "string", "minLength": 3},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["messages", "max_output_tokens", "temperature"],
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "content"],
            "properties": {
              "role": {"enum": ["system", "user"]},
              "content": {"type": "string", "minLength": 1}
            }
          }
        },
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 256},
        "temperature": {"const": 0},
        "tools": {
          "type": "array",
          "items": {"type": "object"}
        }
      }
    },
    "reference_answer": {},
    "validator": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["exact_json", "exact_text", "tool_call"]},
        "expected": {},
        "expected_name": {"type": "string"},
        "expected_arguments": {"type": "object"},
        "expected_finish_reason": {"type": "string"}
      }
    },
    "critical_decision_tokens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "token_text", "rationale"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "token_text": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "failure_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
