root ::= "{\"v\":\"dg1\",\"q\":[" slot "," slot "],\"y\":[" mode "," palette "," density "," shape "],\"l\":[" layout "," mobile "," bp "],\"c\":[" primary "," controls "," content "," detail "," support "],\"x\":[" data-action "," view-action "," commit-action "," state-action "],\"r\":[" main-transform "," overlay-transform "],\"a\":255,\"z\":\"inline\"}"
slot ::= [0-9] | [1-5] [0-9] | "6" [0-3]
mode ::= "\"light\"" | "\"dark\"" | "\"paper\""
palette ::= "\"cyan\"" | "\"indigo\"" | "\"coral\"" | "\"green\"" | "\"amber\"" | "\"violet\"" | "\"blue\""
density ::= "\"compact\"" | "\"normal\"" | "\"airy\""
shape ::= "\"square\"" | "\"soft\"" | "\"round\""
layout ::= "\"dashboard\"" | "\"editorial\"" | "\"timeline\"" | "\"split\"" | "\"docs\"" | "\"settings\"" | "\"schedule\"" | "\"story\""
mobile ::= "\"stack\"" | "\"cards\"" | "\"drawer\"" | "\"accordion\""
bp ::= [0-2]
primary ::= "[\"hero\",\"plain\"]" | "[\"hero\",\"editorial\"]" | "[\"hero\",\"story\"]" | "[\"sidebar\",\"docs\"]" | "[\"sidebar\",\"settings\"]" | "[\"metrics\",\"ops\"]" | "[\"metrics\",\"generic\"]"
controls ::= "[\"filters\",\"status\"]" | "[\"filters\",\"catalog\"]" | "[\"filters\",\"project\"]" | "[\"filters\",\"date-stage\"]" | "[\"filters\",\"year\"]" | "[\"filters\",\"generic\"]" | "[\"toggles\",\"privacy\"]" | "[\"toggles\",\"generic\"]" | "[\"tabs\",\"language\"]" | "[\"form\",\"search\"]"
content ::= "[\"table\",\"ops\"]" | "[\"table\",\"devices\"]" | "[\"table\",\"data\"]" | "[\"table\",\"generic\"]" | "[\"products\",\"magazine\"]" | "[\"products\",\"catalog\"]" | "[\"timeline\",\"case-study\"]" | "[\"timeline\",\"process\"]" | "[\"form\",\"booking\"]" | "[\"form\",\"generic\"]" | "[\"code\",\"request\"]" | "[\"code\",\"response\"]" | "[\"code\",\"generic\"]" | "[\"schedule\",\"stages\"]" | "[\"schedule\",\"generic\"]" | "[\"chart\",\"year-series\"]" | "[\"chart\",\"spark\"]" | "[\"chart\",\"generic\"]"
detail ::= "[\"drawer\",\"detail\"]" | "[\"drawer\",\"navigation\"]" | "[\"dialog\",\"confirm\"]" | "[\"dialog\",\"preview\"]" | "[\"dialog\",\"danger\"]" | "[\"dialog\",\"success\"]" | "[\"compare\",\"before-after\"]" | "[\"compare\",\"range\"]" | "[\"tabs\",\"response\"]" | "[\"tabs\",\"generic\"]" | "[\"table\",\"data\"]" | "[\"table\",\"generic\"]"
support ::= "[\"metrics\",\"ops\"]" | "[\"metrics\",\"story\"]" | "[\"metrics\",\"generic\"]" | "[\"note\",\"source\"]" | "[\"note\",\"method\"]" | "[\"note\",\"generic\"]" | "[\"bag\",\"counter\"]" | "[\"dialog\",\"confirm\"]" | "[\"dialog\",\"success\"]" | "[\"dialog\",\"danger\"]" | "[\"drawer\",\"navigation\"]" | "[\"drawer\",\"detail\"]" | "[\"code\",\"response\"]" | "[\"code\",\"generic\"]"
data-action ::= "\"filter\"" | "\"sort\"" | "\"year\"" | "\"navigate\"" | "\"none\""
view-action ::= "\"open\"" | "\"compare\"" | "\"tab\"" | "\"accordion\"" | "\"inspect\"" | "\"none\""
commit-action ::= "\"confirm\"" | "\"count\"" | "\"validate\"" | "\"copy\"" | "\"favorite\"" | "\"none\""
state-action ::= "\"reset\"" | "\"toggle\"" | "\"sort\"" | "\"announce\"" | "\"save\"" | "\"none\""
main-transform ::= "\"table>cards\"" | "\"grid>stack\"" | "\"schedule>accordion\"" | "\"chart>scroll\"" | "\"code>scroll\""
overlay-transform ::= "\"drawer>full\"" | "\"aside>drawer\"" | "\"none\""
